rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function portalUserAtivo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.podeAcessarPortal == true
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.podeLerDadosPrivados == true
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.stale == false;
    }

    function portalUserEhGestao() {
      return portalUserAtivo()
        && (
          get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.get("perfilOperacional", "") in ["SECRETARIO", "DIRETORIA", "ADMIN_TECNICO"]
          || get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.get("roles", []).hasAny(["SECRETARIO", "DIRETORIA", "ADMIN"])
        );
    }

    function apresentacaoPertenceAoUsuario() {
      return portalUserAtivo()
        && resource.data.get("idPessoaApresentador", "") == get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.get("idPessoa", "");
    }

    match /portalUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /portalActivities/{idAtividade} {
      allow read: if portalUserAtivo();
      allow write: if false;
    }

    match /portalActivityCalendarSnapshots/{snapshotId} {
      allow read: if snapshotId == "current";
      allow write: if false;
    }

    match /activities/{idAtividade} {
      allow read: if portalUserAtivo() && resource.data.ativo == true;
      allow write: if false;
    }

    match /activityPrivate/{idAtividade} {
      allow read: if false;
      allow write: if false;
    }

    match /presentations/{idApresentacao} {
      allow read: if portalUserAtivo()
        && resource.data.ativo == true
        && (
          resource.data.publicarNoPortal == true
          || apresentacaoPertenceAoUsuario()
          || portalUserEhGestao()
        );
      allow write: if false;
    }

    match /presentationPrivate/{idApresentacao} {
      allow read: if false;
      allow write: if false;
    }
  }
}
