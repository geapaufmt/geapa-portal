{
  "name": "geapa-portal-deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "config:dev": "node scripts/generate-portal-config.mjs dev",
    "config:homolog": "node scripts/generate-portal-config.mjs homolog",
    "config:prod": "node scripts/generate-portal-config.mjs prod",
    "apps-script:dev": "node scripts/generate-apps-script-package.mjs dev",
    "check:apps-script-dev": "node scripts/generate-apps-script-package.mjs dev --check",
    "check:configs": "node scripts/check-portal-configs.mjs",
    "check:apps-script-dev-endpoint": "node scripts/check-apps-script-dev-endpoint.mjs",
    "check:auth-fast-path": "node scripts/check-auth-fast-path.mjs",
    "test:minha-situacao-route": "node scripts/check-minha-situacao-route.mjs",
    "test:profile-modal": "node scripts/check-profile-correction-modal.mjs",
    "test:profile-correction-submit": "node scripts/check-profile-correction-submit.mjs",
    "test:profile-correction-ack": "node scripts/check-profile-correction-ack.mjs",
    "test:profile-homolog": "node scripts/check-profile-homolog.mjs",
    "test:profile-prod": "node scripts/check-profile-prod.mjs",
    "test:v2-environment": "node scripts/check-v2-domain-environment.mjs",
    "test:vinculo-v2": "node scripts/check-vinculo-v2.mjs && node scripts/check-admin-vinculo-manual-validation.mjs",
    "test:vinculo-validacoes-manuais": "node scripts/check-admin-vinculo-manual-validation.mjs",
    "test:egress-feedback": "node scripts/check-egress-feedback.mjs",
    "test:member-registration": "node scripts/check-member-registration.mjs && node scripts/check-member-ingress-v2.mjs && node scripts/check-admin-members-v2.mjs",
    "test:presentation-decision-latency": "node scripts/check-presentation-decision-latency.mjs && node scripts/check-presentation-decision-fast-path.mjs && node scripts/check-presentation-decision-reconciliation.mjs",
    "test:presentation-modal-id": "node scripts/check-presentation-modal-id.mjs",
    "test:presentation-management-read-latency": "node scripts/check-presentation-management-read-latency.mjs",
    "test:session-token-core-cache": "node scripts/check-session-token-core-cache.mjs",
    "test:firestore-emulator": "node scripts/run-firestore-emulator-tests.mjs",
    "test:firestore-architecture": "node scripts/check-firestore-environment-architecture.mjs",
    "test:firestore-login-provisioning": "node scripts/check-firestore-login-provisioning.mjs",
    "test:firestore-canonical-authority": "node scripts/check-firestore-canonical-authority.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.28.1"
  }
