name: Publicar GitHub Pages

on:
  workflow_dispatch:
    inputs:
      confirmacao:
        description: 'Digite PUBLICAR_PAGES para atualizar o fallback legado'
        required: true
        type: string

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    if: ${{ inputs.confirmacao == 'PUBLICAR_PAGES' }}
    runs-on: ubuntu-latest
    environment:
      name: production
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Baixar repositorio
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Gerar configuracao PROD
        run: node scripts/generate-portal-config.mjs prod --channel github-pages --version "${GITHUB_SHA}"

      - name: Configurar GitHub Pages
        uses: actions/configure-pages@v5

      - name: Preparar artefato publico
        uses: actions/upload-pages-artifact@v3
        with:
          path: web

      - name: Publicar
        id: deployment
        uses: actions/deploy-pages@v4
