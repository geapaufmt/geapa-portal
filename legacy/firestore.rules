rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function portalUserAtivo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.podeAcessarPortal == true
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.podeLerDadosPrivados == true
        && get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.stale == false;
    }

    function ambienteNaoProd(env) {
      return env == "dev" || env == "homolog";
    }

    function portalUserAtivoNoAmbiente(env) {
      return request.auth != null
        && ambienteNaoProd(env)
        && exists(/databases/$(database)/documents/environments/$(env)/portalUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/environments/$(env)/portalUsers/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/environments/$(env)/portalUsers/$(request.auth.uid)).data.podeAcessarPortal == true
        && get(/databases/$(database)/documents/environments/$(env)/portalUsers/$(request.auth.uid)).data.podeLerDadosPrivados == true
        && get(/databases/$(database)/documents/environments/$(env)/portalUsers/$(request.auth.uid)).data.stale == false;
    }

    match /portalUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /portalActivities/{idAtividade} {
      allow read: if portalUserAtivo();
      allow write: if false;
    }

    match /portalActivityCalendarSnapshots/{snapshotId} {
      allow read: if snapshotId == "current";
      allow write: if false;
    }

    match /environments/{env}/portalUsers/{uid} {
      allow read: if ambienteNaoProd(env) && request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /environments/{env}/portalActivities/{idAtividade} {
      allow read: if portalUserAtivoNoAmbiente(env);
      allow write: if false;
    }

    match /environments/{env}/portalActivityCalendarSnapshots/{snapshotId} {
      allow read: if ambienteNaoProd(env) && snapshotId == "current";
      allow write: if false;
    }
  }
}
