import {mountGovernance,type Governance} from './institutional-governance.mjs';
import {parameterCards,parameterDetail,parameterForm,parameterEvidenceDetail,type Parameter} from './institutional-parameters.mjs';
import {renderNormView,normDetail,visibilityForm,type NormRecord,type NormView} from './institutional-norms.mjs';
import {esc,header,badge,detailFacts,detailSection,openDetailDialog,closeDetailDialog} from './design-system.mjs';
export type InstitutionalRecord={parameter?:Parameter;parameterEvidence?:unknown;id:string;title:string;kind:string;status:string;classification:string;fields:{label:string;value:string}[];sources:{document:string;sheet:string;row:number;hash:string}[];issues:string[];canonical:null|{path:string;status:string;evidence:string}};
export type InstitutionalDirectory={schemaVersion:'institutional-consultation-v1'|'institutional-instruments-view-v1';governance?:Governance;section:string;revision:number;nature:string;sourceHash:string;items:InstitutionalRecord[];total:number;page:number;pages:number;kinds:string[];editingEnabled:boolean;editableFields?:string[];validUntil:number};
export const institutionalSections=[['identity','Identidade e contatos'],['parameters','Parâmetros operacionais'],['norms','Normas e documentos'],['governance','Governança e deliberações']] as const;
const classifications:Record<string,string>={EDITORIAL:'Editorial',CONFIGURABLE:'Operacional configurável',NORMATIVE_CONDITIONAL:'Normativamente condicionado',TECHNICAL_RESTRICTED:'Técnico / restrito'};
export function renderInstitutionalDirectory(v:InstitutionalDirectory,query='',kind=''):string{
 if(v.section==='parameters'&&v.items.some(r=>!r.parameter))return header('Parâmetros operacionais','Atualize a consulta após a atualização compatível do Core.')+'<p>Os parâmetros documentais continuam vinculados a Normas e documentos.</p>';
 if(v.section==='parameters')return parameterCards(v.items as (InstitutionalRecord&{parameter:Parameter})[],query,kind,parameterFilters);
 const title=institutionalSections.find(([id])=>id===v.section)?.[1]||'Gestão Institucional';
 return header(title,'Gestão Institucional · consulta documental e referências canônicas.','<button type="button" data-institutional-refresh>Atualizar consulta</button>'+ (v.section==='identity'?'<button type="button" data-institutional-recover>Consultar último envio</button>':''))+
 '<p class="geapa-board-notice">Um registro documental não altera regras nem comprova aprovação por si só. Edição e publicação dependem de competência e autorização específicas.</p>'+
 `<form data-institutional-search class="institutional-search"><label>Buscar nesta seção<input type="search" name="query" maxlength="80" value="${esc(query)}"></label><label>Tipo<select name="kind"><option value="">Todos</option>${v.kinds.map(k=>`<option ${k===kind?'selected':''}>${esc(k)}</option>`).join('')}</select></label><button type="submit">Buscar</button></form>`+
 `<p class="geapa-results" role="status">${v.total} registros · revisão ${v.revision} · página ${v.page} de ${v.pages}</p><div class="geapa-record-grid">${v.items.map((r,i)=>`<article class="geapa-record" data-institutional-card="${i}"><header class="geapa-record-head"><h3>${esc(r.title)}</h3>${badge(r.status,!!r.issues.length)}</header><p class="geapa-eyebrow">${esc(r.id)}</p><p>${esc(classifications[r.classification]||r.classification)}</p>${r.issues.length?`<p>${r.issues.length} observação(ões) para conferência</p>`:''}<footer class="geapa-record-foot"><span>${esc(r.kind)}</span><button type="button" data-institutional-detail="${i}" aria-haspopup="dialog" aria-label="Ver detalhes: ${esc(r.title)}">Ver detalhes</button></footer></article>`).join('')||'<p>Nenhum registro corresponde à consulta.</p>'}</div>`+
 `<div class="institutional-pagination"><button type="button" data-institutional-page="${v.page-1}" ${v.page<=1?'disabled':''}>Anterior</button><button type="button" data-institutional-page="${v.page+1}" ${v.page>=v.pages?'disabled':''}>Próxima</button></div>`;
}
export function renderInstitutionalDetail(r:InstitutionalRecord,editable=false):string{
 return `<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="institutional-detail-title"><header class="modal-topbar"><h2 id="institutional-detail-title">${esc(r.title)}</h2><button type="button" data-admin-modal-close aria-label="Fechar detalhes">×</button></header>`+
 detailFacts([['Identificador',r.id],['Estado documental',r.status],['Classificação',classifications[r.classification]||r.classification]])+
 detailSection('Registro documental',detailFacts(r.fields.map(f=>[f.label,f.value])))+
 detailSection('Autoridade operacional',r.canonical?`<p>${esc(r.canonical.status)}</p><p>${esc(r.canonical.evidence)}</p><small>${esc(r.canonical.path)}</small>`:'<p>Não há uso operacional comprovado nesta referência. A consulta não ativa regras.</p>')+
 (r.issues.length?detailSection('Pendências documentais','<ul>'+r.issues.map(i=>`<li>${esc(i)}</li>`).join('')+'</ul>'):'')+
 (r.parameter?parameterDetail(r.parameter):'')+(r.parameterEvidence?parameterEvidenceDetail(r.parameterEvidence):'')+
 (editable?'<button type="button" data-institutional-edit>Editar contato institucional</button>':'')+
 detailSection('Proveniência',r.sources.map(s=>`<p>${esc(s.document)} · ${esc(s.sheet)} · linha ${s.row}</p><small class="institutional-hash">SHA-256 ${esc(s.hash)}</small>`).join(''))+'</section>';
}
type Host=Window&{PortalGeapaApi?:{apiPost:(route:string,params:{payload:string})=>Promise<{ok:boolean;data:any;message?:string}>;apiGet:(route:string,params:Record<string,string|number>)=>Promise<{ok:boolean;data:InstitutionalDirectory;code?:string;message?:string}>};PortalGeapaNavigation?:{getRotaAtual:()=>string}};
let instrument='',visibility='VISIBLE',parameterFilters={type:'',status:'',competence:''};
let governanceCleanup:(()=>void)|undefined;
let generation=0,current:InstitutionalDirectory|undefined,timer:ReturnType<typeof setTimeout>|undefined,dialog:HTMLElement|undefined,query='',kind='',page=1,editing:InstitutionalRecord|undefined,prepared:any,busy=false;
const section=()=>{const id=(window as Host).PortalGeapaNavigation?.getRotaAtual();return institutionalSections.find(([s])=>id==='institutional-'+s)?.[0];};
function close(){const opened=dialog;if(opened){dialog=undefined;closeDetailDialog(opened,true);opened.remove();}}
function clear(){governanceCleanup?.();governanceCleanup=undefined;generation++;current=undefined;editing=undefined;prepared=undefined;clearTimeout(timer);close();}
function expired(el:HTMLElement){clear();el.innerHTML='<p>Atualize para revalidar a consulta institucional.</p><button data-institutional-refresh>Atualizar</button>';}
// A long minute form may outlive a read proof. Renew through the same authenticated
// reader, retaining the form only while its complete authorized model is unchanged.
function scheduleExpiry(el:HTMLElement,epoch:number){
 const deadline=current?.validUntil||0;clearTimeout(timer);
 timer=setTimeout(async()=>{
  if(epoch!==generation)return;
  if(!document.querySelector('[data-minutes-dialog]')){timer=setTimeout(()=>{if(epoch===generation)expired(el);},Math.max(0,deadline-Date.now()));return;}
  timer=setTimeout(()=>{if(epoch===generation)expired(el);},Math.max(0,deadline-Date.now()));
  try{const r=await (window as Host).PortalGeapaApi?.apiGet('/admin/gestao-institucional',{section:'governance',view:'instruments',instrument,query,visibility,page});
   if(epoch!==generation)return;
   if(!r?.ok||r.data.validUntil<=Date.now()||JSON.stringify(r.data.governance)!==JSON.stringify(current?.governance)){expired(el);return;}
   current=r.data;scheduleExpiry(el,epoch);
  }catch{if(epoch===generation)expired(el);}
 },Math.max(0,deadline-Date.now()-10000));
}
async function load(){const s=section(),el=document.getElementById('placeholder-content');if(!s||!el)return;clear();const epoch=generation;el.classList.add('geapa-admin');el.textContent='Consultando informações institucionais…';
 try{const r=await (window as Host).PortalGeapaApi?.apiGet('/admin/gestao-institucional',(['norms','governance'].includes(s)?{section:s,view:'instruments',instrument,query,visibility,page}:{section:s,query,kind,page}));if(epoch!==generation||section()!==s)return;if(!r?.ok)throw Error(['FEATURE_DISABLED','PILOT_DISABLED','PROJECTION_NOT_READY'].includes(r?.code||'')?'A consulta aguarda a aprovação de sua base documental e do escopo de acesso.':r?.message||'Consulta institucional indisponível.');if(!['institutional-consultation-v1','institutional-instruments-view-v1'].includes(r.data.schemaVersion)||r.data.validUntil<=Date.now())throw Error('A autorização da consulta expirou.');current=r.data;el.innerHTML=current.schemaVersion==='institutional-instruments-view-v1'?renderNormView(current as unknown as NormView,query,visibility):renderInstitutionalDirectory(current,query,kind);if(current.governance)governanceCleanup=mountGovernance(el,current.governance,load,query);scheduleExpiry(el,epoch);}
 catch(e){if(epoch===generation){el.replaceChildren();const message=document.createElement('p');message.setAttribute('role','alert');message.textContent=e instanceof Error?e.message:'Consulta indisponível.';const button=document.createElement('button');button.type='button';button.dataset.institutionalRefresh='';button.textContent='Atualizar';el.append(message,button);}}
}
export function renderInstitutionalEdit(r:InstitutionalRecord,revision:number):string{
 return '<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="institutional-edit-title"><header class="modal-topbar"><h2 id="institutional-edit-title">Editar '+esc(r.title)+'</h2><button type="button" data-admin-modal-close aria-label="Fechar edição">×</button></header><p>Alteração interna, sem publicação pública. Revisão '+revision+'.</p><form data-institutional-edit-form><label>Novo valor<input name="value" maxlength="300" required value="'+esc(r.fields.find(f=>f.label==='Valor')?.value||'')+'"></label><label>Motivo administrativo<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label><div data-institutional-edit-feedback role="status" aria-live="polite"></div><button type="submit">Revisar alteração</button></form></section>';
}
async function editCall(phase:string,payload:unknown){const api=(window as Host).PortalGeapaApi;if(!api)throw Error('Sessão indisponível.');const r=await api.apiPost((section()==='parameters'?'/admin/gestao-institucional/parametros/editar':['norms','governance'].includes(section()||'')?'/admin/gestao-institucional/visibilidade':'/admin/gestao-institucional/editar'),{payload:JSON.stringify({phase,payload})});if(!r.ok)throw Error(r.message||'A operação foi recusada. Consulte o último envio antes de tentar novamente.');return r.data;}
async function editAction(phase:'preview'|'execute'|'status',payload:unknown){
 if(busy)return;busy=true;const epoch=generation,feedback=dialog?.querySelector<HTMLElement>('[data-institutional-edit-feedback]');const opened=dialog;opened?.setAttribute('aria-busy','true');const buttons=[...(dialog?.querySelectorAll<HTMLButtonElement|HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('button,input,textarea,select')||[])];buttons.forEach(b=>b.disabled=true);
 try{const answer=await editCall(phase,payload);if(epoch!==generation)return;
  if(phase==='preview'){prepared=answer.request;if(feedback)feedback.innerHTML='<p>De: '+esc(answer.preview.beforeValue===false?'NAO':answer.preview.beforeValue===true?'SIM':answer.preview.beforeValue??(answer.preview.beforeHidden?'Oculto':'Visível'))+'</p><p>Para: '+esc(answer.preview.value===false?'NAO':answer.preview.value===true?'SIM':answer.preview.value??(answer.preview.hidden?'Oculto':'Visível'))+'</p><p>Motivo: '+esc(answer.preview.reason)+'</p><button type="button" data-institutional-confirm>Confirmar alteração interna</button>';}
  else{prepared=undefined;await load();const el=document.getElementById('placeholder-content');if(el&&section()){const p=document.createElement('p');p.setAttribute('role','status');p.textContent=answer.state==='COMPLETED'?(answer.proposalState?'Etapa registrada: '+answer.proposalState+'. Recibo '+answer.operationId+'.':'Alteração confirmada. Nenhum conteúdo público foi modificado.'):'Nenhuma alteração admitida para o último envio.';el.prepend(p);}}
 }catch(e){if(epoch!==generation)return;prepared=undefined;const message='Não foi possível confirmar a operação. Consulte o último envio antes de repetir. '+(e instanceof Error?e.message:'');if(feedback)feedback.textContent=message;else{const p=document.createElement('p');p.setAttribute('role','alert');p.textContent=message;document.getElementById('placeholder-content')?.prepend(p);}}
 finally{busy=false;opened?.removeAttribute('aria-busy');buttons.forEach(b=>b.disabled=false);}
}
if(typeof document!=='undefined'){
 document.addEventListener('click',e=>{if(!(e.target instanceof Element))return;const button=e.target.closest<HTMLElement>('[data-parameter-action]');if(!button||!editing?.parameter||!current||current.validUntil<=Date.now())return;prepared=undefined;close();dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;dialog.setAttribute('data-geapa-protect-draft','');dialog.innerHTML=parameterForm(editing.parameter,button.dataset.parameterAction||'',button.dataset.parameterProposal||'');document.body.append(dialog);const opened=dialog;openDetailDialog(opened,()=>{opened.remove();if(dialog===opened)dialog=undefined;});});
 document.addEventListener('submit',e=>{if(!(e.target instanceof HTMLFormElement)||!e.target.matches('[data-parameter-form]'))return;e.preventDefault();const p=editing?.parameter;if(!p||!current||current.validUntil<=Date.now())return;void editAction('preview',{parameterId:p.id,action:e.target.dataset.action,proposalId:e.target.dataset.proposal||'',expectedRevision:p.revision,expectedProposalRevision:Number(e.target.dataset.proposalRevision),value:e.target.querySelector<HTMLSelectElement>('[name=value]')?.value==='true',reason:String(new FormData(e.target).get('reason')||'').trim()});});

 document.addEventListener('change',e=>{if(e.target instanceof HTMLSelectElement&&e.target.name==='instrument'&&e.target.closest('[data-institutional-search]')){instrument=e.target.value;query='';page=1;void load();}});
 document.addEventListener('submit',e=>{if(!(e.target instanceof HTMLFormElement)||!e.target.matches('[data-institutional-visibility-form]'))return;e.preventDefault();const r=editing as NormRecord;if(!r?.canChangePresentation||!current||current.validUntil<=Date.now())return;void editAction('preview',{section:r.section,recordId:r.id,hidden:!r.presentation?.hidden,expectedRevision:r.presentationRevision,expectedSourceRevision:r.sourceRevision,reason:String(new FormData(e.target).get('reason')||'').trim()});});
 document.addEventListener('click',e=>{if(!(e.target instanceof Element)||!e.target.closest('[data-institutional-visibility]'))return;const r=editing as NormRecord;if(!r?.canChangePresentation||!current||current.validUntil<=Date.now())return;prepared=undefined;close();dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;dialog.setAttribute('data-geapa-protect-draft','');dialog.innerHTML=visibilityForm(r);document.body.append(dialog);const opened=dialog;openDetailDialog(opened,()=>{opened.remove();if(dialog===opened)dialog=undefined;});});

 document.addEventListener('submit',e=>{if(!(e.target instanceof HTMLFormElement)||!e.target.matches('[data-institutional-edit-form]'))return;e.preventDefault();if(!current||!editing||current.validUntil<=Date.now())return;const f=new FormData(e.target);void editAction('preview',{fieldId:editing.id,value:String(f.get('value')||'').trim(),reason:String(f.get('reason')||'').trim(),expectedRevision:current.revision});});
 document.addEventListener('input',e=>{if(e.target instanceof Element&&e.target.closest('[data-institutional-edit-form],[data-institutional-visibility-form],[data-parameter-form]')){prepared=undefined;dialog?.querySelector('[data-institutional-edit-feedback]')?.replaceChildren();}});
 document.addEventListener('click',e=>{if(!(e.target instanceof Element)||!section())return;if(e.target.closest('[data-institutional-recover]')){void editAction('status',{});return;}if(e.target.closest('[data-institutional-confirm]')){if(prepared)void editAction('execute',prepared);return;}if(e.target.closest('[data-institutional-edit]')&&editing&&current&&current.validUntil>Date.now()&&current.editableFields?.includes(editing.id)&&dialog){prepared=undefined;const html=renderInstitutionalEdit(editing,current.revision);close();dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;dialog.setAttribute('data-geapa-protect-draft','');dialog.innerHTML=html;document.body.append(dialog);const opened=dialog;openDetailDialog(opened,()=>{opened.remove();if(dialog===opened)dialog=undefined;});dialog.querySelector<HTMLElement>('input')?.focus();}});
 document.addEventListener('portal:navigationchange',()=>{clear();query='';kind='';instrument='';visibility='VISIBLE';page=1;if(section())void load();});
 document.addEventListener('portal:act-session-cleared',()=>{const el=section()?document.getElementById('placeholder-content'):null;if(el)expired(el);else clear();});
 document.addEventListener('submit',e=>{if(!(e.target instanceof HTMLFormElement)||!e.target.matches('[data-institutional-search]'))return;e.preventDefault();const data=new FormData(e.target);query=String(data.get('query')||'');kind=String(data.get('kind')||'');parameterFilters={type:String(data.get('parameterType')||''),status:String(data.get('parameterStatus')||''),competence:String(data.get('parameterCompetence')||'')};instrument=String(data.get('instrument')||'');visibility=String(data.get('visibility')||'VISIBLE');page=1;void load();});
 document.addEventListener('click',e=>{if(!section()||!(e.target instanceof Element)||e.defaultPrevented||e.button!==0||e.ctrlKey||e.metaKey||e.shiftKey)return;if(e.target.closest('[data-institutional-refresh]')){void load();return;}const pg=e.target.closest<HTMLElement>('[data-institutional-page]');if(pg){page=Number(pg.dataset.institutionalPage);void load();return;}const button=e.target.closest<HTMLElement>('[data-institutional-detail]'),card=e.target.closest<HTMLElement>('[data-institutional-card]');if(!card||(!button&&(e.target.closest('button,a,input,select')||window.getSelection()?.toString())))return;
  if(!current||current.validUntil<=Date.now()){void load();return;}const r=current.items[Number(button?.dataset.institutionalDetail??card.dataset.institutionalCard)];if(!r)return;close();if(!button)card.querySelector<HTMLElement>('button')?.focus();dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;editing=r;dialog.innerHTML=renderInstitutionalDetail(r,current.editingEnabled===true&&current.editableFields?.includes(r.id)===true);if(current.schemaVersion==='institutional-instruments-view-v1')dialog.querySelector('.modal-panel')?.insertAdjacentHTML('beforeend',normDetail(r as NormRecord));document.body.append(dialog);const opened=dialog;openDetailDialog(opened,()=>{opened.remove();if(dialog===opened)dialog=undefined;});
 });
}
