// Presentation only: commands, decisions, limits and authorization are Core-owned.
type Data=Record<string,unknown>;
type Send=(route:string,payload:Data)=>Promise<unknown>;
interface Policy {id:string;label?:string;rules?:{maxAbsenceBasisPoints:number;minimumAttendanceBasisPoints:number;absenceNorm:string;attendanceNorm:string}}
interface Model {id:string;revision:number;name?:string;definition?:Data;status?:string;governance?:{state:string;definitionHash:string}}
interface Rights {canDraft:boolean;canApprove:boolean;canSetAvailability:boolean}
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const input=(name:string,label:string,value:unknown='',type='text',required=true)=>`<label>${label}<input name="${name}" type="${type}" value="${esc(value)}" ${required?'required':''} ${type==='number'?'min="0" max="10000" step="1"':'maxlength="800"'}></label>`;
const check=(name:string,label:string,value:unknown=false)=>`<label><input name="${name}" type="checkbox" ${value===true?'checked':''}> ${label}</label>`;
const select=(name:string,label:string,choices:[string,string][],value:unknown='',multiple=false)=>`<label>${label}<select name="${name}" ${multiple?'multiple':''} required>${multiple?'':'<option value="">Selecione</option>'}${choices.map(([v,l])=>`<option value="${esc(v)}" ${(Array.isArray(value)?value.includes(v):value===v)?'selected':''}>${esc(l)}</option>`).join('')}</select></label>`;
const decision=()=>input('reason','Motivo e identificação da decisão')+check('confirm','Conferi os valores e confirmo este registro')+'<p role="status" data-feedback></p>';
function bind(form:HTMLFormElement,send:Send,route:string,payload:(d:FormData)=>Data,done:()=>void):void{
 let busy=false;form.addEventListener('submit',async e=>{e.preventDefault();if(busy||!form.reportValidity())return;const d=new FormData(form),feedback=form.querySelector<HTMLElement>('[data-feedback]')!;if(!d.has('confirm')){feedback.textContent='Confirme a conferência dos dados antes de enviar.';return;}busy=true;form.setAttribute('aria-busy','true');const dialog=form.closest('[role="dialog"]')?.parentElement;dialog?.setAttribute('aria-busy','true');const buttons=form.querySelectorAll<HTMLButtonElement>('button');buttons.forEach(b=>b.disabled=true);
 try{await send(route,payload(d));feedback.textContent='Registro confirmado pelo Core.';form.removeAttribute('aria-busy');dialog?.removeAttribute('aria-busy');done();}catch(e){feedback.textContent=e instanceof Error?e.message:'Não foi possível confirmar. Preserve o envio para recuperação.';}finally{busy=false;form.removeAttribute('aria-busy');dialog?.removeAttribute('aria-busy');buttons.forEach(b=>b.disabled=false);}});
}
const principalTypes=['MEMBRO','PROFESSOR','CONVIDADO','EXTERNO','EGRESSO'];
const modelBooleans:Record<string,string>={generatesCertificate:'Pode emitir certificado',requiresTitle:'Exige título',requiresAxis:'Exige eixo temático',allowsSecondaryAxis:'Permite eixo secundário',requiresPrincipal:'Exige pessoa principal',requiresPrincipalEmail:'Exige e-mail da pessoa principal',requiresPrincipalInstitution:'Exige instituição da pessoa principal',requiresMaterial:'Exige material',showCalendar:'Exibir no calendário',showUpcoming:'Exibir nas próximas atividades',reviewBeforePublish:'Exige conferência antes de publicar',memberPresentation:'Apresentação de membro'};
export function mountOriginalModel(container:HTMLElement,row:Model|undefined,policies:Policy[],rights:Rights,send:Send,done:()=>void):void{
 const def=row?.definition||{},m=(def.portalModel||{}) as Data,editable=rights.canDraft&&(!row||row.governance?.state==='DRAFT');
 if(row&&!editable){container.innerHTML=`<h3>${esc(row.name)}</h3><p>${esc(row.governance?.state==='APPROVED'?'Aprovado':'Rascunho')} · ${esc(row.status)}</p><dl>${Object.entries(def).filter(([k])=>k!=='portalModel').map(([k,v])=>`<dt>${esc(k)}</dt><dd>${esc(typeof v==='object'?JSON.stringify(v):v)}</dd>`).join('')}</dl><details><summary>Requisitos do modelo</summary><dl>${Object.entries(m).map(([k,v])=>`<dt>${esc(modelBooleans[k]||k)}</dt><dd>${esc(Array.isArray(v)?v.join(', '):v===true?'Sim':v===false?'Não':v)}</dd>`).join('')}</dl></details>`;
 }else if(editable){
 container.innerHTML=`<form class="readonly-form" data-original-model><p>Modelo original, sem herança obrigatória de outro formato. Salvar o rascunho não o disponibiliza para atividades.</p><fieldset><legend>Identificação e finalidade</legend>${input('name','Nome',def.name)}${input('type','Tipo',m.type)}${input('subtype','Subtipo',m.subtype)}${input('group','Grupo',m.group)}${input('description','Descrição',m.description)}${input('purpose','Finalidade',def.purpose)}${input('organizer','Responsável / organizador',def.organizer)}${input('academicRequirements','Requisitos acadêmicos documentados',def.academicRequirements,'text',false)}</fieldset><fieldset><legend>Participação e duração</legend>${select('participantTypes','Tipos de participantes',['MEMBRO','INGRESSANTE',...principalTypes.slice(1)].map(v=>[v,v]),def.participantTypes,true)}${select('allowedFormats','Modalidades',['PRESENCIAL','REMOTO','HIBRIDO'].map(v=>[v,v]),def.allowedFormats,true)}${select('visibility','Visibilidade permitida',[['BOARD','Diretoria'],['MEMBERS','Membros'],['PUBLIC','Público']],def.visibility)}${input('durationMinutes','Carga horária padrão (minutos)',def.durationMinutes,'number')}${input('principalRole','Papel da pessoa principal',m.principalRole,'text',false)}${input('allowedPrincipalTypes','Tipos de pessoa principal (separados por vírgula)',(m.allowedPrincipalTypes as string[]||[]).join(', '),'text',false)}</fieldset><fieldset><legend>Frequência e justificativas</legend>${check('countsAttendance','Contabiliza presença',def.countsAttendance)}${check('countsAbsence','Contabiliza falta',def.countsAbsence)}${check('allowsJustification','Permite justificativas',def.allowsJustification)}<label>Política canônica de chamada<select name="attendancePolicyId"><option value="">Não aplicável (sem frequência)</option>${policies.map(p=>`<option value="${esc(p.id)}" ${(def.attendancePolicyRef as {id?:string})?.id===p.id?'selected':''}>${esc(p.label||p.id)}</option>`).join('')}</select></label></fieldset><fieldset><legend>Requisitos e apresentação</legend>${Object.entries(modelBooleans).map(([k,l])=>check(k,l,m[k])).join('')}${input('materialExtensions','Extensões permitidas (separadas por vírgula)',(m.materialExtensions as string[]||[]).join(', '),'text',false)}${input('maxMaterialMb','Limite de material em MiB',m.maxMaterialMb||0,'number')}${input('materialInstructions','Orientações dos materiais',m.materialInstructions,'text',false)}</fieldset>${decision()}<button>Salvar rascunho</button></form>`;
 const form=container.querySelector<HTMLFormElement>('form')!;bind(form,send,'/admin/atividades/modelos/original',d=>{const text=(k:string)=>String(d.get(k)||''),list=(k:string)=>text(k).split(',').map(v=>v.trim()).filter(Boolean),principal=list('allowedPrincipalTypes');const portalModel:Data={type:text('type'),subtype:text('subtype'),group:text('group'),description:text('description'),principalRole:text('principalRole'),materialInstructions:text('materialInstructions'),allowedPrincipalTypes:principal,materialExtensions:list('materialExtensions'),maxMaterialMb:Number(d.get('maxMaterialMb')),displayOrder:0,allowsExternalPrincipal:principal.some(v=>['EXTERNO','CONVIDADO','EGRESSO'].includes(v)),allowsMemberPrincipal:principal.includes('MEMBRO'),allowsProfessorPrincipal:principal.includes('PROFESSOR')};for(const k of Object.keys(modelBooleans))portalModel[k]=d.has(k);
 return {id:row?.id||'',revision:row?.revision||0,reason:text('reason'),definition:{name:text('name'),purpose:text('purpose'),organizer:text('organizer'),academicRequirements:text('academicRequirements'),durationMinutes:Number(d.get('durationMinutes')),visibility:text('visibility'),participantTypes:d.getAll('participantTypes'),allowedFormats:d.getAll('allowedFormats'),countsAttendance:d.has('countsAttendance'),countsAbsence:d.has('countsAbsence'),allowsJustification:d.has('allowsJustification'),portalModel,...(text('attendancePolicyId')?{attendancePolicyRef:{kind:'attendancePolicy',id:text('attendancePolicyId')}}:{})}};},done);
 }
 if(row?.governance?.state==='DRAFT'&&rights.canApprove){const form=document.createElement('form');form.className='readonly-form';form.innerHTML='<h3>Aprovação do modelo salvo</h3><p>A aprovação usa a revisão já salva. Alterações no formulário precisam ser salvas e conferidas antes.</p>'+input('evidence','Referência documental da aprovação')+decision()+'<button>Aprovar e disponibilizar modelo salvo</button>';container.append(form);container.querySelector('[data-original-model]')?.addEventListener('input',()=>{form.querySelector<HTMLButtonElement>('button')!.disabled=true;form.querySelector<HTMLButtonElement>('button')!.dataset.stale='true';form.querySelector<HTMLElement>('[data-feedback]')!.textContent='Salve e confira a nova revisão antes de aprovar.';});bind(form,send,'/admin/atividades/modelos/aprovar',d=>{if(form.querySelector<HTMLButtonElement>('button')!.dataset.stale==='true')throw Error('Salve a nova revisão.');return {id:row.id,revision:row.revision,definitionHash:row.governance!.definitionHash,evidence:String(d.get('evidence')),reason:String(d.get('reason'))};},done);}
 if(row?.governance?.state==='APPROVED'&&rights.canSetAvailability){const form=document.createElement('form');form.className='readonly-form';form.innerHTML=decision()+`<button>${row.status==='ACTIVE'?'Inativar':'Ativar'} para novas atividades</button>`;container.append(form);bind(form,send,'/admin/atividades/modelos/disponibilidade',d=>({id:row.id,revision:row.revision,status:row.status==='ACTIVE'?'INACTIVE':'ACTIVE',reason:String(d.get('reason'))}),done);}
}
interface Period {periodId:string;state:string;nature:string;civilStart:string;civilEnd:string;attendanceActivitiesCount:number;normativeMeetingsCount:number;absenceLimit:number|null;definitionHash:string;rules:{minimumAttendanceBasisPoints:number;maxAbsenceBasisPoints:number;absenceNorm:string;attendanceNorm:string};approvalDate:string;approvingBody:string;approvalEvidence:string;policyRef:{id:string};classification:string;equivalenceEvidence:string;decisionId:string}
interface Cycle {id:string;revision:number;label:string;status:string;civilStart:string;civilEnd:string;canPlanFrequency:boolean;canApproveFrequency:boolean;frequencyPlanning?:{periods:Period[]}}
export function frequencySummary(c:Cycle):string{return `<section><h3>Planejamento e frequência</h3>${(c.frequencyPlanning?.periods||[]).map(p=>`<article><h4>${esc(p.periodId)} · ${p.state==='APPROVED'?'Aprovado':'Rascunho'}</h4><p>${esc(p.civilStart)} a ${esc(p.civilEnd)}</p><dl><dt>Total original — atividades</dt><dd>${p.attendanceActivitiesCount}</dd><dt>Total normativo do planejamento</dt><dd>${p.normativeMeetingsCount}</dd><dt>Limite de faltas</dt><dd>${p.absenceLimit===null?'Pendente de classificação normativa':p.absenceLimit}</dd><dt>Frequência mínima (indicador distinto)</dt><dd>${p.rules.minimumAttendanceBasisPoints/100}%</dd><dt>Base normativa</dt><dd>${esc(p.rules.absenceNorm)} · ${esc(p.rules.attendanceNorm)}</dd><dt>Aprovação documental</dt><dd>${esc(p.approvalDate||'Data não informada')} · ${esc(p.approvingBody)}</dd></dl></article>`).join('')||'<p>Planejamento original ainda não registrado. O limite não será estimado pelo calendário.</p>'}<p>Cancelamentos e atividades extraordinárias não recalculam este limite. Indicadores não substituem decisões institucionais.</p>${c.canPlanFrequency||c.canApproveFrequency?`<button type="button" data-cycle-frequency="${esc(c.id)}">Configurar planejamento e frequência</button>`:''}</section>`;}
export function mountFrequencyPlan(container:HTMLElement,c:Cycle,policies:Policy[],send:Send,done:()=>void):void{
 container.innerHTML=frequencySummary({...c,canPlanFrequency:false,canApproveFrequency:false});
 for(const plan of c.frequencyPlanning?.periods||[])if(plan.state==='DRAFT'&&c.canApproveFrequency){const form=document.createElement('form');form.className='readonly-form';form.innerHTML=`<h4>Aprovar ${esc(plan.periodId)}</h4>${decision()}<button>Aprovar planejamento original</button>`;container.append(form);bind(form,send,'/admin/ciclos-semestres/frequencia/aprovar',d=>({id:c.id,revision:c.revision,periodId:plan.periodId,definitionHash:plan.definitionHash,reason:String(d.get('reason'))}),done);}
 if(!c.canPlanFrequency)return;const form=document.createElement('form');form.className='readonly-form';const draft=c.frequencyPlanning?.periods.find(p=>p.state==='DRAFT');
 form.innerHTML=`<h4>${draft?'Revisar rascunho':'Registrar período original'}</h4>${input('periodId','Identificador do período',draft?.periodId)}${select('nature','Natureza',[['ANNUAL','Anual'],['SEMESTER','Semestral']],draft?.nature)}${input('civilStart','Início',''+(draft?.civilStart||c.civilStart),'date')}${input('civilEnd','Término',''+(draft?.civilEnd||c.civilEnd),'date')}${input('attendanceActivitiesCount','Atividades originalmente planejadas que contabilizam presença',draft?.attendanceActivitiesCount,'number')}${input('normativeMeetingsCount','Total do planejamento normativo (reuniões / atividades reconhecidas)',draft?.normativeMeetingsCount,'number')}${select('classification','Classificação documental',[['UNCONFIRMED','Correspondência normativa pendente'],['PLANNED_MEETINGS','Correspondência normativa documentada']],draft?.classification||'UNCONFIRMED')}${input('equivalenceEvidence','Fonte da correspondência normativa',draft?.equivalenceEvidence,'text',false)}${select('policyId','Norma e parâmetros aprovados',policies.map(p=>[p.id,p.label||p.id]),draft?.policyRef.id)}<p data-policy-summary></p>${input('approvalDate','Data documental de aprovação (não é a data de cadastro)',draft?.approvalDate,'date',false)}${input('approvingBody','Responsável / órgão que aprovou',draft?.approvingBody,'text',false)}${input('approvalEvidence','Evidência da aprovação original',draft?.approvalEvidence,'text',false)}${input('decisionId','Identificação da decisão',draft?.decisionId,'text',false)}${decision()}<button>Salvar rascunho do planejamento</button>`;container.append(form);
 form.addEventListener('change',()=>{const id=new FormData(form).get('policyId'),p=policies.find(p=>p.id===id);form.querySelector('[data-policy-summary]')!.textContent=p?.rules?`Limite: ${p.rules.maxAbsenceBasisPoints/100}% do planejamento, arredondado para baixo. Frequência mínima: ${p.rules.minimumAttendanceBasisPoints/100}%, calculada separadamente. O Core confirma o valor ao salvar.`:'';});
 bind(form,send,'/admin/ciclos-semestres/frequencia/salvar',d=>{const s=(k:string)=>String(d.get(k)||'');return {id:c.id,revision:c.revision,reason:s('reason'),plan:{periodId:s('periodId'),nature:s('nature'),civilStart:s('civilStart'),civilEnd:s('civilEnd'),attendanceActivitiesCount:Number(d.get('attendanceActivitiesCount')),normativeMeetingsCount:Number(d.get('normativeMeetingsCount')),classification:s('classification'),equivalenceEvidence:s('equivalenceEvidence'),policyRef:{kind:'policy',id:s('policyId')},approvalDate:s('approvalDate'),approvingBody:s('approvingBody'),approvalEvidence:s('approvalEvidence'),decisionId:s('decisionId')}};},done);
}
