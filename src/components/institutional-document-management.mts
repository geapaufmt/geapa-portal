import {esc,detailSection,detailFacts,closeDetailDialog} from './design-system.mjs';
import {fileFields,mountFileFields,filesDetail,mountFileDownloads,type DocumentFile} from './institutional-document-files.mjs';
import type {NormVersionOption,DocumentaryEvidence} from './institutional-documentary-links.mjs';
export type NormFiles={id:string;revision:number;attachments:DocumentFile[];normativeFiles:{norm:NormVersionOption;officialSha256:string};versions?:{contentRevision:number;record:NormFiles}[]};
type Review={id:string;actorPersonId:string;updatedAt:number;review:{decision:string;evidence:string;relation:string;norm:{id:string}}};
export type Proof={reviewHistory?:Review[];id:string;revision:number;hash:string;title:string;documentaryEvidence:DocumentaryEvidence;attachments:DocumentFile[];relations:{normVersionId:string;relation:string}[];reviews?:{id:string;actorPersonId:string;updatedAt:number;review:{decision:string;evidence:string;relation:string;norm:{id:string}}}[]};
export type DocumentManagement={revision:number;norm:NormVersionOption|null;canManageNormFiles:boolean;canVerifyLinks:boolean;documentFilesEnabled:boolean};
export type DocumentContext={normFileRecord?:NormFiles|null;documentManagement?:DocumentManagement;documentaryProofs?:Proof[]};
const labels:Record<string,string>={VERIFIED:'Vínculo conferido',REJECTED:'Vínculo não comprovado',REVOKED:'Conferência revogada'};
export function reviewSummary(p:Proof):string{return ((p.reviews||[]).map(r=>detailFacts([['Relação',({APPROVAL:'Aprovação',AMENDMENT:'Alteração',REVOCATION:'Revogação'} as Record<string,string>)[r.review.relation]||r.review.relation],['Conferência documental',labels[r.review.decision]||r.review.decision],['Evidência',r.review.evidence],['Responsável',r.actorPersonId],['Data',new Date(r.updatedAt).toLocaleString('pt-BR')]])).join('')||'<p>Pendente de verificação documental.</p>')+(p.reviewHistory?.length?'<details><summary>Histórico da conferência documental</summary>'+p.reviewHistory.map(r=>'<p>'+esc(labels[r.review.decision]||r.review.decision)+' · '+esc(r.actorPersonId)+' · '+esc(new Date(r.updatedAt).toLocaleString('pt-BR'))+'</p><small>Recibo '+esc(r.id.replace('GOV_',''))+'</small>').join('')+'</details>':'');}
export function managementDetail(r:DocumentContext):string{const f=r.normFileRecord,m=r.documentManagement;return detailSection('PDF oficial da versão normativa','<p>A custódia do arquivo não altera aprovação, vigência ou publicação. As versões anteriores permanecem preservadas.</p>'+(f?`<div data-norm-files-current>${filesDetail(f.attachments)}<p>SHA-256 do PDF oficial: <small class="institutional-hash">${esc(f.normativeFiles.officialSha256)}</small></p></div>`:'<p>Nenhum PDF oficial associado por este fluxo.</p>')+(f?.versions||[]).map(v=>`<details><summary>Arquivo anterior · revisão ${v.contentRevision}</summary><div data-norm-files-history="${v.contentRevision}">${filesDetail(v.record.attachments)}</div></details>`).join('')+(m?.canManageNormFiles&&m.norm?'<button type="button" data-norm-files-edit>Gerenciar PDF oficial e complementos</button>':'')+(m?.canVerifyLinks&&m.norm&&(r.documentaryProofs||[]).length?'<button type="button" data-document-review>Conferir vínculo documental</button>':'')+'<button type="button" data-document-status>Consultar último envio documental</button><div data-document-management-form></div><p data-document-management-result role="status" aria-live="polite"></p>');}
export function mountDocumentManagement(root:HTMLElement,r:DocumentContext,reload:()=>Promise<void>){
 let active=true,busy=false,prepared:unknown,action='',editor:ReturnType<typeof mountFileFields>|undefined;const cleanups:(()=>void)[]=[];
 const api=async(phase:string,payload:unknown)=>{const host=window as Window&{PortalGeapaApi?:{apiPost:(route:string,params:{payload:string})=>Promise<{ok:boolean;data:any;message?:string}>}};const v=await host.PortalGeapaApi?.apiPost('/admin/gestao-institucional/governanca/editar',{payload:JSON.stringify({phase,payload})});if(!v?.ok)throw Error(v?.message||'Não foi possível confirmar a operação.');return v.data;};
 const f=r.normFileRecord;if(f){const area=root.querySelector<HTMLElement>('[data-norm-files-current]');if(area)cleanups.push(mountFileDownloads(area,f,api));for(const v of f.versions||[]){const a=root.querySelector<HTMLElement>('[data-norm-files-history="'+v.contentRevision+'"]');if(a)cleanups.push(mountFileDownloads(a,{...v.record,id:f.id,revision:f.revision,contentRevision:v.contentRevision},api));}}
 const feedback=()=>root.querySelector<HTMLElement>('[data-document-management-result]');
 const run=async(phase:string,payload:unknown)=>{if(busy)return;busy=true;const controls=[...root.querySelectorAll<HTMLInputElement>('input,textarea,select,button')].map(e=>({e,disabled:e.disabled}));controls.forEach(({e})=>e.disabled=true);root.setAttribute('aria-busy','true');try{const v=await api(phase,payload);if(!active)return;if(phase==='preview'){prepared=v.request;const a=feedback();if(a)a.innerHTML='<p>Antes: '+esc(v.preview.beforeValue)+'</p><p>Depois: '+esc(v.preview.value)+'</p><p>Sem aprovação normativa ou publicação.</p><button type="button" data-document-confirm>Confirmar registro documental</button>';}else if(v.state==='COMPLETED'){prepared=undefined;closeDetailDialog(root,true);const message=v.state==='COMPLETED'?'Registro documental confirmado. Recibo '+v.operationId+'.':'Nenhuma alteração admitida para o último envio.';await reload();const a=document.getElementById('placeholder-content');if(a){const p=document.createElement('p');p.setAttribute('role','status');p.textContent=message;a.prepend(p);}}else{const a=feedback();if(a)a.textContent='Resultado ainda não confirmado. Seus arquivos e campos permanecem nesta aba; consulte o último envio antes de repetir.';}}catch(e){prepared=undefined;const a=feedback();if(active&&a)a.textContent=(e as Error).message+' Consulte o último envio antes de repetir.';}finally{busy=false;root.removeAttribute('aria-busy');controls.forEach(({e,disabled})=>e.disabled=disabled);}};
 const click=(e:Event)=>{if(!(e.target instanceof Element)||busy||!active)return;const t=e.target,m=r.documentManagement;if(t.closest('[data-document-status]')){void run('status',{});return;}if(t.closest('[data-document-confirm]')){if(prepared)void run('execute',prepared);return;}if(!m?.norm)return;const slot=root.querySelector<HTMLElement>('[data-document-management-form]');if(!slot)return;
  if(t.closest('[data-norm-files-edit]')&&m.canManageNormFiles){editor?.dispose();prepared=undefined;action='NORM_FILES_SAVE';slot.innerHTML='<form data-document-form>'+fileFields()+'<label>SHA-256 do PDF oficial selecionado<input name="officialSha256" required pattern="[a-f0-9]{64}" value="'+esc(f?.normativeFiles.officialSha256||'')+'"></label><p>Copie o hash exibido junto ao PDF escolhido. Os demais arquivos serão complementos.</p><label>Motivo administrativo<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button type="submit">Revisar arquivos normativos</button></form>';editor=mountFileFields(slot,f?.attachments||[],m.documentFilesEnabled);}
  if(t.closest('[data-document-review]')&&m.canVerifyLinks){editor?.dispose();prepared=undefined;action='DOCUMENTARY_LINK_REVIEW';const options=(r.documentaryProofs||[]).flatMap(p=>p.relations.filter(l=>l.normVersionId===m.norm!.id).map(l=>({p,l})));slot.innerHTML='<form data-document-form><p>Conferir a relação não aprova a norma nem apura votos. Examine o documento fonte antes de confirmar.</p><label>Documento e relação<select name="target" required>'+options.map((x,i)=>'<option value="'+i+'">'+esc(x.p.title+' — '+x.l.relation)+'</option>').join('')+'</select></label><label>Resultado<select name="decision"><option value="VERIFIED">Vínculo documental conferido</option><option value="REJECTED">Relação não comprovada</option><option value="REVOKED">Revogar conferência anterior</option></select></label><label>Evidência examinada<textarea name="evidence" required minlength="10" maxlength="2000"></textarea></label><label>Motivo administrativo<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button type="submit">Revisar conferência documental</button></form>';}
  if(action){root.setAttribute('data-geapa-protect-draft','');document.dispatchEvent(new CustomEvent('portal:institutional-dialog-opened'));}
 };
 const input=()=>{prepared=undefined;feedback()?.replaceChildren();};
 const submit=(e:Event)=>{if(!(e.target instanceof HTMLFormElement)||!e.target.matches('[data-document-form]'))return;e.preventDefault();const m=r.documentManagement;if(!m?.norm||busy)return;const data=new FormData(e.target),val=(k:string)=>String(data.get(k)||'').trim();try{const base={action,id:'',expectedRevision:m.revision,expectedRecordRevision:0,norm:{id:m.norm.id,revision:m.norm.revision,hash:m.norm.hash},reason:val('reason')};if(action==='NORM_FILES_SAVE'&&m.canManageNormFiles)void run('preview',{...base,id:f?.id||'',expectedRecordRevision:f?.revision||0,attachments:editor?.input()||[],officialSha256:val('officialSha256')});else if(action==='DOCUMENTARY_LINK_REVIEW'&&m.canVerifyLinks){const x=(r.documentaryProofs||[]).flatMap(p=>p.relations.filter(l=>l.normVersionId===m.norm!.id).map(l=>({p,l})))[Number(val('target'))];if(!x)throw Error('Selecione uma relação disponível.');void run('preview',{...base,targetId:x.p.id,targetRevision:x.p.revision,targetHash:x.p.hash,relation:x.l.relation,decision:val('decision'),evidence:val('evidence')});}}catch(error){const a=feedback();if(a)a.textContent=(error as Error).message;}};
 root.addEventListener('click',click);root.addEventListener('input',input);root.addEventListener('submit',submit);return ()=>{active=false;editor?.dispose();cleanups.forEach(f=>f());root.removeEventListener('click',click);root.removeEventListener('input',input);root.removeEventListener('submit',submit);};
}
