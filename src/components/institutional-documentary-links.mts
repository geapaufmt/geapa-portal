import {esc,detailFacts,detailSection} from './design-system.mjs';
export type NormVersionOption={id:string;label:string;revision:number;hash:string};
export type DocumentaryEvidence={modality:string;documentDate:string|null;documentDatePrecision:string;documentAuthors:string[];sourceDescription:string;sourceSha256:string;relations:{normVersionId:string;expectedNormRevision:number;expectedNormHash:string;relation:string;evidence:string;verification?:string}[]};
const modalities:Record<string,string>={MEETING_MINUTES:'Ata de reunião',ELECTRONIC_DELIBERATION_TERM:'Termo de deliberação eletrônica'};
const purposes:Record<string,string>={APPROVAL:'Aprovação',AMENDMENT:'Alteração',REVOCATION:'Revogação'};
export function documentaryFields(options:NormVersionOption[],d?:DocumentaryEvidence,minute=false):string{
 return `<details><summary>Comprovação documental de normas</summary><p>Este vínculo não realiza votação, não aprova a norma e não altera sua vigência. A aprovação do texto da ata é distinta da deliberação normativa.</p><label><input type="checkbox" name="documentaryEnabled" ${d?'checked':''}> Registrar evidência e relações normativas</label><label>Modalidade<select name="documentaryModality">${Object.entries(modalities).filter(([id])=>!minute||id==='MEETING_MINUTES').map(([id,label])=>`<option value="${id}" ${d?.modality===id?'selected':''}>${label}</option>`).join('')}</select></label><label>Precisão da data documental<select name="documentaryPrecision">${[['UNKNOWN','Desconhecida'],['DAY','Dia'],['MONTH','Mês'],['YEAR','Ano']].map(([id,label])=>`<option value="${id}" ${d?.documentDatePrecision===id?'selected':''}>${label}</option>`).join('')}</select></label><label>Data documentada (AAAA-MM-DD, AAAA-MM ou AAAA)<input name="documentaryDate" value="${esc(d?.documentDate||'')}" maxlength="10"></label><label>Autoria declarada no documento (um nome por linha)<textarea name="documentaryAuthors" maxlength="3220">${esc(d?.documentAuthors.join('\n')||'')}</textarea></label><label>Fonte e contexto da evidência<textarea name="documentarySource" maxlength="1500">${esc(d?.sourceDescription||'')}</textarea></label><label>SHA-256 da cópia documental conferida<input name="documentaryHash" maxlength="64" value="${esc(d?.sourceSha256||'')}"></label><p>Selecione somente as versões e relações comprovadas. Autoria declarada não comprova voto. As relações novas ficam pendentes de conferência.</p>${options.map(n=>{const links=d?.relations.filter(r=>r.normVersionId===n.id)||[];return `<fieldset data-norm-version="${esc(n.id)}"><legend>${esc(n.label)}</legend>${Object.entries(purposes).map(([id,label])=>`<label><input type="checkbox" data-norm-purpose="${id}" ${links.some(r=>r.relation===id)?'checked':''}> ${label}</label><label>Evidência da ${label.toLowerCase()}<textarea data-norm-evidence="${id}" maxlength="1500">${esc(links.find(r=>r.relation===id)?.evidence||'')}</textarea></label>`).join('')}</fieldset>`;}).join('')||'<p>Nenhuma versão normativa disponível nesta autorização.</p>'}<p>Votação eletrônica não implementada nesta V1. Sua futura implementação deverá respeitar a unanimidade dos diretores em exercício e as exigências do instrumento aplicável.</p></details>`;
}
export function documentaryInput(form:HTMLFormElement,options:NormVersionOption[],old?:DocumentaryEvidence):DocumentaryEvidence|null{
 if(!form.querySelector<HTMLInputElement>('[name=documentaryEnabled]')?.checked){if(old)throw Error('Preserve a evidência documental já registrada.');return null;}
 const value=(n:string)=>(form.querySelector<HTMLInputElement|HTMLTextAreaElement>('[name="'+n+'"]')?.value||'').trim();
 const relations=[...form.querySelectorAll<HTMLElement>('[data-norm-version]')].flatMap(el=>{const n=options.find(x=>x.id===el.dataset.normVersion);if(!n)return [];return [...el.querySelectorAll<HTMLInputElement>('[data-norm-purpose]:checked')].map(c=>({normVersionId:n.id,expectedNormRevision:n.revision,expectedNormHash:n.hash,relation:c.dataset.normPurpose!,evidence:(el.querySelector<HTMLTextAreaElement>('[data-norm-evidence="'+c.dataset.normPurpose+'"]')?.value||'').trim()}));});
 // Do not silently remove a relation whose source has become unavailable.
 if(old?.relations.some(r=>!options.some(n=>n.id===r.normVersionId)))throw Error('Uma versão relacionada está indisponível. Atualize a consulta antes de revisar a evidência.');
 return {modality:value('documentaryModality'),documentDate:value('documentaryDate')||null,documentDatePrecision:value('documentaryPrecision'),documentAuthors:value('documentaryAuthors').split('\n').map(x=>x.trim()).filter(Boolean),sourceDescription:value('documentarySource'),sourceSha256:value('documentaryHash'),relations};
}
export function documentaryDetails(d?:DocumentaryEvidence):string{
 if(!d)return detailSection('Comprovação normativa','<p>Pendente de vinculação documental.</p>');
 return detailSection('Comprovação normativa',detailFacts([['Modalidade',modalities[d.modality]||d.modality],['Data documentada',d.documentDate||'Desconhecida'],['Autoria documental',d.documentAuthors.join('; ')],['Fonte',d.sourceDescription]])+d.relations.map(r=>detailFacts([['Versão normativa',r.normVersionId],['Relação',purposes[r.relation]||r.relation],['Conferência','Pendente de verificação documental'],['Evidência',r.evidence]])).join('')+'<p>Este registro não representa apuração de votos nem ativação normativa.</p>');
}
