import {esc,filters,pagination as pages,summary} from './design-system.mjs';
export type GovernanceQuery={query:string;meetingType:string;boardId:string;state:string;from:string;to:string;normVersionId:string;page:number;section?:string;bucket?:string;procedureType?:string;proposer?:string;documentId?:string};
export const emptyGovernanceQuery=():GovernanceQuery=>({query:'',meetingType:'',boardId:'',state:'',from:'',to:'',normVersionId:'',page:1,section:'procedures',bucket:''});
export function governanceBuckets(section='procedures'):string[][]{return [['','Todos'],...(section==='procedures'?[['mine','Aguardando minha ação'],['ongoing','Em andamento'],['completed','Concluídos'],['closed','Arquivados ou cancelados']]:section==='minutes'?[['draft','Em elaboração'],['review','Aguardando conferência ou assinatura'],['archived','Arquivadas']]:section==='records'?[['draft','Rascunhos'],['evidence','Evidências e referências'],['relations','Vinculações documentais']]:[])];}
export function governanceSearch(q:GovernanceQuery,boards:{id:string;name:string}[]=[],norms:{id:string;label:string}[]=[],pagination?:{page:number;pages:number;total:number}):string{
 const select=(name:string,label:string,rows:string[][])=>`<label>${esc(label)}<select name="${name}">${rows.map(([id,text])=>`<option value="${esc(id)}" ${String(q[name as keyof GovernanceQuery]||'')===id?'selected':''}>${esc(text)}</option>`).join('')}</select></label>`;
 const states=[['','Todas'],['OPEN','Em deliberação'],['APPROVED','Aprovada'],['REJECTED','Rejeitada'],['RECORDED','Registrada'],['INSUFFICIENT_MANIFESTATIONS','Manifestações insuficientes'],['SUSPENDED_COMPOSITION','Composição alterada'],['CONSENT_PENDING','Aguardando aceite'],['DEFENSE_PENDING','Aguardando manifestação'],['CANCELLED','Cancelada'],['DRAFT','Em elaboração'],['IN_REVIEW','Em conferência'],['CORRECTIONS_REQUESTED','Correções solicitadas'],['ARCHIVED','Arquivada'],['UNDER_REVIEW','Em conferência documental'],['EVIDENCE_PENDING','Evidência pendente']];
 const text=(name:string,label:string)=>`<label>${esc(label)}<input name="${name}" maxlength="100" value="${esc(q[name as keyof GovernanceQuery]||'')}"></label>`;
 const fields=select('boardId','Gestão',[['','Todas autorizadas'],...boards.map(b=>[b.id,b.name])])+select('state','Situação',states)+`<label>De<input name="from" type="date" value="${esc(q.from)}"></label><label>Até<input name="to" type="date" value="${esc(q.to)}"></label>`+select('normVersionId','Norma relacionada',[['','Todas autorizadas'],...norms.map(n=>[n.id,n.label])])+(q.section==='minutes'||q.section==='archive'?text('meetingType','Tipo de reunião'):'')+`<details><summary>Referências específicas</summary><div class="geapa-filter-fields">${text('procedureType','Tipo de procedimento (identificador)')}${text('proposer','Proponente (ID da pessoa)')}${text('documentId','Documento relacionado (ID)')}</div></details>`;
 const count=Object.entries(q).filter(([k,v])=>!['page','section','query','bucket'].includes(k)&&v).length;
 return `<section data-governance-search-area><form data-governance-search>${filters(`<label>Pesquisar título, número e assunto<input type="search" name="query" maxlength="100" value="${esc(q.query)}"></label>`,select('bucket','Grupo',governanceBuckets(q.section)),fields,count,count>0,'<button type="button" data-governance-clear>Limpar filtros</button>')}<div class="geapa-results"><button type="submit">Pesquisar</button></div></form>${pagination?summary(pagination.total,'registros',pagination.page,pagination.pages)+pages(pagination.page,pagination.pages,'data-governance-page'):''}</section>`;
}
