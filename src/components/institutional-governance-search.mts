import {esc} from './design-system.mjs';
export type GovernanceQuery={query:string;meetingType:string;boardId:string;state:string;from:string;to:string;normVersionId:string;page:number;procedureType?:string;proposer?:string;documentId?:string};
export const emptyGovernanceQuery=():GovernanceQuery=>({query:'',meetingType:'',boardId:'',state:'',from:'',to:'',normVersionId:'',page:1});
export function governanceSearch(q:GovernanceQuery,boards:{id:string;name:string}[]=[],norms:{id:string;label:string}[]=[],pagination?:{page:number;pages:number;total:number}):string{return `<section data-governance-search-area><form data-governance-search><label>Pesquisar título, número e assunto<input type="search" name="query" maxlength="100" value="${esc(q.query)}"></label><details><summary>Filtros documentais</summary><div class="minute-grid"><label>Tipo de procedimento<input name="procedureType" maxlength="100" value="${esc(q.procedureType||'')}"></label><label>Proponente (ID da pessoa)<input name="proposer" maxlength="100" value="${esc(q.proposer||'')}"></label><label>Documento relacionado (ID)<input name="documentId" maxlength="100" value="${esc(q.documentId||'')}"></label><label>Tipo de reunião<input name="meetingType" maxlength="100" value="${esc(q.meetingType)}"></label><label>Gestão<select name="boardId"><option value="">Todas autorizadas</option>${boards.map(b=>`<option value="${esc(b.id)}" ${q.boardId===b.id?'selected':''}>${esc(b.name)}</option>`).join('')}</select></label><label>Situação<select name="state"><option value="">Todas</option>${[['OPEN','Em deliberação'],['APPROVED','Aprovada'],['REJECTED','Rejeitada'],['RECORDED','Registrada'],['INSUFFICIENT_MANIFESTATIONS','Manifestações insuficientes'],['SUSPENDED_COMPOSITION','Composição alterada'],['CONSENT_PENDING','Aguardando aceite'],['DEFENSE_PENDING','Aguardando manifestação'],['CANCELLED','Cancelada'],['DRAFT','Em redação'],['IN_REVIEW','Em conferência'],['CORRECTIONS_REQUESTED','Correções solicitadas'],['ARCHIVED','Arquivada'],['UNDER_REVIEW','Em conferência documental'],['EVIDENCE_PENDING','Evidência pendente']].map(([id,label])=>`<option value="${id}" ${q.state===id?'selected':''}>${label}</option>`).join('')}</select></label><label>De<input name="from" type="date" value="${esc(q.from)}"></label><label>Até<input name="to" type="date" value="${esc(q.to)}"></label><label>Versão normativa<select name="normVersionId"><option value="">Todas autorizadas</option>${norms.map(n=>`<option value="${esc(n.id)}" ${q.normVersionId===n.id?'selected':''}>${esc(n.label)}</option>`).join('')}</select></label></div></details><button type="submit">Consultar acervo</button><button type="button" data-governance-clear>Limpar filtros</button></form>${pagination?`<p role="status">${pagination.total} registros · página ${pagination.page} de ${pagination.pages}</p><button type="button" data-governance-page="${pagination.page-1}" ${pagination.page<=1?'disabled':''}>Anterior</button><button type="button" data-governance-page="${pagination.page+1}" ${pagination.page>=pagination.pages?'disabled':''}>Próxima</button>`:''}</section>`;}
