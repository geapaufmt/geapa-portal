import {fileFields,mountFileFields,filesDetail,mountFileDownloads,type DocumentFile} from './institutional-document-files.mjs';
import {documentaryFields,documentaryInput,documentaryDetails,type DocumentaryEvidence,type NormVersionOption} from './institutional-documentary-links.mjs';
import {esc,detailFacts,detailSection,openDetailDialog,closeDetailDialog} from './design-system.mjs';
export type MinuteReference={label:string;url:string;sha256:string;targetId:string|null;evidence:string};
type Person={personId:string;name:string;functions:{id:string;roleKey:string;scopeKey:string;revision:number}[]};
type MinuteImage={mime:string;base64:string;sha256:string;caption:string};
type Manifestation={action:string;personId:string;at:number;contentRevision:number;reason:string;excerpt:string};
export type Minute={attachments?:DocumentFile[];documentaryEvidence?:DocumentaryEvidence;id:string;revision:number;title:string;meetingDate:string;body:string;sourceRecordId:string|null;references:MinuteReference[];actions:string[];pending:string[];versions:{contentRevision:number;record:Minute}[];minutes:{fullText?:string;documentLayoutVersion?:string;images?:MinuteImage[];number:string;meetingType:string;boardId:string;startTime:string;endTime:string;location:string;modality:string;agenda:string;decisions:string;outcomes:string;access:string;rectifiesId:string|null;state:string;contentRevision:number;writerPersonId:string;composition:{boardId:string;boardName:string;people:Person[]};attendance:{personId:string;presence:string}[];manifestations:Manifestation[];archive:{at:number;contentHash:string}|null}};
export type MinutesView={pagination?:{page:number;pages:number;total:number};documentFilesEnabled?:boolean;normativeVersions?:NormVersionOption[];revision:number;canCreateMinute?:boolean;boards?:{id:string;name:string}[];records:unknown[];history:unknown[]};
type Host=Window&{PortalGeapaApi?:{apiPost:(route:string,params:{payload:string})=>Promise<{ok:boolean;data:any;message?:string}>}};
const states:Record<string,string>={DRAFT:'Em redação',IN_REVIEW:'Em conferência',CORRECTIONS_REQUESTED:'Correções solicitadas',ARCHIVED:'Arquivada'};
const actions:Record<string,string>={EDIT:'Revisar em nova versão',SUBMIT:'Encaminhar para conferência',REQUEST_CORRECTION:'Solicitar correção',APPROVE_SIGN:'Aprovar o texto e assinar',ACKNOWLEDGE:'Registrar ciência',OBSERVE:'Registrar observação',ARCHIVE:'Arquivar versão final'};
const stamp=(n:number)=>new Date(n).toLocaleString('pt-BR',{timeZone:'America/Cuiaba'});
const prose=(s:string)=>'<p class="minute-prose">'+esc(s)+'</p>';
const label=(s:string)=>actions[s]||s;
export function minuteRecords(v:MinutesView):Minute[]{return v.records.filter((x:any)=>x?.minutes) as Minute[];}
export function minutesCards(v:MinutesView,query='',state=''):string{
 const all=minuteRecords(v),rows=all.filter(r=>(!state||r.minutes.state===state)&&(!query||(r.title+' '+r.minutes.number).toLocaleLowerCase().includes(query.toLocaleLowerCase())));
 return '<section class="norm-section" data-minutes-area><h2>Atas da Diretoria</h2><p>Registrar → Conferir → Aprovar e assinar → Arquivar. A aprovação do texto não equivale a voto nas deliberações. Confirmação eletrônica interna, sem certificação ICP-Brasil.</p><div class="minute-toolbar">'+(v.canCreateMinute?'<button type="button" data-minute-new>Registrar ata</button>':'')+'<button type="button" class="secondary-button" data-minute-recover>Consultar último envio</button><label '+(v.pagination?'hidden':'')+'>Situação<select data-minute-state><option value="">Todas</option>'+Object.entries(states).map(([k,n])=>`<option value="${k}" ${state===k?'selected':''}>${n}</option>`).join('')+'</select></label></div><p role="status">'+rows.length+' ata(s) nesta página</p><div class="geapa-record-grid">'+rows.map(r=>`<article class="geapa-record" data-minute-card="${esc(r.id)}"><header class="geapa-record-head"><h3>${esc(r.title)}</h3><span class="geapa-badge">${esc(states[r.minutes.state])}</span></header><p>Ata ${esc(r.minutes.number)} · ${esc(r.meetingDate)} · versão ${r.minutes.contentRevision}</p><p>${esc(r.minutes.composition.boardName)}</p><p>${r.minutes.state==='ARCHIVED'?'Documento definitivo':esc(r.pending?.length?'Manifestações pendentes: '+r.pending.join(', '):'Sem manifestações obrigatórias pendentes')}</p><button type="button" data-minute-detail="${esc(r.id)}" aria-haspopup="dialog">Consultar ata</button></article>`).join('')+'</div><p data-minute-result role="status" aria-live="polite"></p></section>';
}
export function minuteDocument(r:Minute):string{
 const m=r.minutes,name=(id:string)=>m.composition.people.find(p=>p.personId===id)?.name||id;
 return '<h2>'+esc(r.title)+'</h2>'+detailFacts([['Identificação',m.number],['Situação',states[m.state]],['Reunião',m.meetingType+' · '+r.meetingDate],['Horário',m.startTime+' – '+m.endTime+' (Cuiabá)'],['Local / modalidade',m.location+' · '+({REMOTE:'Remota',PRESENTIAL:'Presencial',HYBRID:'Híbrida'}[m.modality]||m.modality)],['Gestão',m.composition.boardName],['Redação',name(m.writerPersonId)],['Versão do texto',String(m.contentRevision)],['Acesso',m.access==='COMPOSITION'?'Composição da reunião':'Diretoria da gestão']])+(m.fullText?detailSection('Texto integral da ata',prose(m.fullText)):'')+detailSection('Pauta',prose(m.agenda))+detailSection('Assuntos discutidos',prose(r.body))+detailSection('Decisões e resultados documentados',prose(m.decisions))+detailSection('Encaminhamentos',prose(m.outcomes))+detailSection('Composição na data da reunião',m.composition.people.map(p=>prose(p.name+' · '+p.functions.map(f=>f.roleKey).join(', ')+' · '+(m.attendance.find(a=>a.personId===p.personId)?.presence==='PRESENT'?'Presente':'Ausente'))).join(''))+detailSection('Assinaturas dos presentes',m.manifestations.filter(x=>x.action==='APPROVE_SIGN').map(x=>prose(name(x.personId)+' · '+stamp(x.at)+' · versão '+x.contentRevision)).join('')||'<p>Nenhuma registrada nesta versão.</p>')+detailSection('Ciências dos ausentes',m.manifestations.filter(x=>x.action==='ACKNOWLEDGE').map(x=>prose(name(x.personId)+' · '+stamp(x.at)+' · versão '+x.contentRevision)).join('')||'<p>Nenhuma registrada nesta versão.</p>')+detailSection('Observações e correções',m.manifestations.filter(x=>!['APPROVE_SIGN','ACKNOWLEDGE'].includes(x.action)).map(x=>prose(label(x.action)+' · '+name(x.personId)+' · '+stamp(x.at)+'\n'+x.excerpt+'\n'+x.reason)).join('')||'<p>Sem observações.</p>')+detailSection('Documentos relacionados',r.references.map(x=>detailFacts([['Documento',x.label],['Referência',x.url],['SHA-256',x.sha256],['Evidência',x.evidence]])).join('')||'<p>Sem documentos vinculados.</p>')+filesDetail(r.attachments)+documentaryDetails(r.documentaryEvidence)+(m.archive?detailSection('Arquivamento',detailFacts([['Data',stamp(m.archive.at)],['Hash da versão final',m.archive.contentHash],['Identificador',r.id]])):'')+'<p>Assinatura eletrônica interna, não qualificada ICP-Brasil. Aprovação do texto não equivale a voto favorável às deliberações. Publicação pública fechada.</p>';
}
const field=(name:string,title:string,value='',type='text',max=240)=>`<label>${title}<input name="${name}" type="${type}" required maxlength="${max}" value="${esc(value)}"></label>`;
const textfield=(name:string,title:string,value='',max=8000)=>`<label>${title}<textarea name="${name}" required maxlength="${max}" ${name==='reason'?'minlength="10"':''}>${esc(value)}</textarea></label>`;
function reference(r:MinuteReference={label:'',url:'',sha256:'',targetId:null,evidence:''}):string{return `<fieldset data-minute-reference><legend>Documento relacionado</legend>${field('refLabel','Descrição',r.label,'text',160)}${field('refUrl','Link do documento no Drive',r.url,'url',1000)}${field('refHash','SHA-256 da cópia conferida',r.sha256,'text',64)}${textfield('refEvidence','Evidência documental',r.evidence,1500)}<input name="refTarget" type="hidden" value="${esc(r.targetId||'')}"><button type="button" data-minute-remove-ref>Remover referência</button></fieldset>`;}
export function minuteForm(v:MinutesView,r?:Minute,rectifies?:Minute):string{
 const m=r?.minutes;
 return `<form data-minute-form><p>O conteúdo é documental. Não cria atividade, chamada ou execução de decisão. Revisões preservam o texto anterior e exigem novas manifestações.</p><div class="minute-grid">${field('number','Número da ata',m?.number||'','text',64)}${field('title','Título',r?.title||'')}${field('meetingType','Tipo de reunião',m?.meetingType||'Ordinária','text',100)}${field('meetingDate','Data da reunião',r?.meetingDate||'','date')}<label>Gestão<select name="boardId" required ${r?'disabled':''}>${(v.boards||[]).map(b=>`<option value="${esc(b.id)}" ${m?.boardId===b.id?'selected':''}>${esc(b.name)}</option>`).join('')}</select></label>${field('startTime','Início',m?.startTime||'','time')}${field('endTime','Término',m?.endTime||'','time')}${field('location','Local / ambiente da reunião',m?.location||'','text',300)}<label>Modalidade<select name="modality">${[['PRESENTIAL','Presencial'],['REMOTE','Remota'],['HYBRID','Híbrida']].map(([id,n])=>`<option value="${id}" ${m?.modality===id?'selected':''}>${n}</option>`).join('')}</select></label><label>Acesso documental<select name="access"><option value="BOARD">Diretoria da gestão</option><option value="COMPOSITION" ${m?.access==='COMPOSITION'?'selected':''}>Somente composição da reunião</option></select></label></div><p>A redação será identificada pela conta autenticada.</p><button type="button" data-minute-composition>Consultar Diretoria na data da reunião</button><div data-minute-roster></div>${textfield('agenda','Pauta',m?.agenda)}${textfield('body','Assuntos discutidos',r?.body)}${textfield('decisions','Decisões e resultados',m?.decisions)}${textfield('outcomes','Encaminhamentos',m?.outcomes)}<section><h3>Redação documental</h3><p>Revise o texto integral antes de encaminhar. A sugestão usa somente os campos informados e não acrescenta deliberações.</p><button type="button" data-minute-suggest>Sugerir redação a partir dos campos</button>${textfield('fullText','Texto integral da ata',m?.fullText||'',40000)}</section><details><summary>Fotografias opcionais</summary><p>Até duas imagens PNG/JPEG, 65 KiB cada e 2 megapixels, com legenda. Integram a versão aprovada.</p><label>Adicionar fotografia<input type="file" data-minute-image accept="image/jpeg,image/png"></label><div data-minute-images></div></details><details><summary>Anexos e documentos relacionados</summary><p>Referências a arquivos já existentes; não altera a visibilidade dos arquivos.</p><div data-minute-references>${(r?.references||[]).map(reference).join('')}</div><button type="button" data-minute-add-ref>Adicionar documento</button></details>${fileFields()}${documentaryFields(v.normativeVersions||[],r?.documentaryEvidence,true)}${rectifies?'<p>Retificação vinculada à ata '+esc(rectifies.minutes.number)+'. O original permanece imutável.</p>':''}${textfield('reason','Motivo administrativo','',1000)}<p data-minute-feedback role="status" aria-live="polite"></p><button type="submit">Revisar salvamento</button></form>`;
}
export function mountMinutes(host:HTMLElement,v:MinutesView,reload:()=>Promise<void>,query=''):()=>void{
 const area=document.createElement('div');area.dataset.minutesMount='';const anchor=host.querySelector('[data-institutional-search]');if(anchor)anchor.after(area);else host.append(area);let alive=true,busy=false,dialog:HTMLElement|undefined,selected:Minute|undefined,rectifies:Minute|undefined,prepared:any,roster:Person[]=[],rosterKey='',filter='',images:MinuteImage[]=[];
 const render=()=>{area.innerHTML=minutesCards(v,query,filter);};render();
 const pdfUrls:string[]=[];
 let fileEditor:ReturnType<typeof mountFileFields>|undefined,disposeDownloads:(()=>void)|undefined;
 const close=()=>{pdfUrls.splice(0).forEach(url=>URL.revokeObjectURL(url));fileEditor?.dispose();fileEditor=undefined;disposeDownloads?.();disposeDownloads=undefined;const opened=dialog;dialog=undefined;if(opened){closeDetailDialog(opened,true);opened.remove();}prepared=undefined;};
 const open=(title:string,content:string,draft=false)=>{close();dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;dialog.dataset.minutesDialog='';if(draft)dialog.setAttribute('data-geapa-protect-draft','');dialog.innerHTML=`<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="minute-title"><header class="modal-topbar"><h2 id="minute-title">${esc(title)}</h2><button type="button" data-admin-modal-close aria-label="Fechar">×</button></header>${content}</section>`;document.body.append(dialog);const opened=dialog;openDetailDialog(opened,()=>{opened.remove();if(dialog===opened)dialog=undefined;});document.dispatchEvent(new CustomEvent('portal:institutional-dialog-opened'));};
 const call=async(phase:string,payload:unknown)=>{const r=await (window as Host).PortalGeapaApi?.apiPost('/admin/gestao-institucional/governanca/editar',{payload:JSON.stringify({phase,payload})});if(!r?.ok)throw Error(r?.message||'Não foi possível confirmar a operação.');return r.data;};
 const perform=async(phase:string,payload:unknown,composition=false)=>{if(busy)return;busy=true;const opened=dialog,feedback=opened?.querySelector<HTMLElement>('[data-minute-feedback]')||area.querySelector<HTMLElement>('[data-minute-result]'),controls=[...(opened?.querySelectorAll<HTMLInputElement>('button,input,select,textarea')||[])].map(e=>({e,disabled:e.disabled}));opened?.setAttribute('aria-busy','true');controls.forEach(({e})=>e.disabled=true);try{const data=await call(phase,payload);if(!alive)return;
 if(composition){roster=data.preview.composition.people;const f=opened?.querySelector<HTMLFormElement>('form');rosterKey=(f?.querySelector<HTMLInputElement>('[name=meetingDate]')?.value||'')+'|'+(f?.querySelector<HTMLSelectElement>('[name=boardId]')?.value||'');const node=opened?.querySelector('[data-minute-roster]');if(node)node.innerHTML='<fieldset><legend>Diretoria canônica na data da reunião</legend>'+roster.map(p=>`<label>${esc(p.name)}<select data-minute-person="${esc(p.personId)}"><option value="">Informe a participação</option><option value="PRESENT" ${selected?.minutes.attendance.some(x=>x.personId===p.personId&&x.presence==='PRESENT')?'selected':''}>Presente</option><option value="ABSENT" ${selected?.minutes.attendance.some(x=>x.personId===p.personId&&x.presence==='ABSENT')?'selected':''}>Ausente</option></select></label>`).join('')+'</fieldset>';if(feedback)feedback.textContent='Composição conferida pelo Core. Informe quem esteve presente ou ausente.';}
 else if(phase==='preview'){prepared=data.request;if(feedback)feedback.innerHTML='<strong>Confira antes de confirmar</strong>'+prose(data.preview.value)+'<p>Esta operação não publica a ata nem executa deliberações.</p><button type="button" data-minute-confirm>Confirmar operação</button>';}
 else{close();await reload();const p=document.createElement('p');p.setAttribute('role','status');p.textContent=data.state==='COMPLETED'?'Operação confirmada. Recibo: '+data.operationId+'.':'Nenhum efeito confirmado para o envio consultado.';host.prepend(p);}}
 catch(e){prepared=undefined;if(alive&&feedback)feedback.textContent=(e instanceof Error?e.message:'Falha na operação.')+' Se a confirmação foi enviada, consulte o último envio antes de repetir.';}finally{busy=false;opened?.removeAttribute('aria-busy');controls.forEach(({e,disabled})=>e.disabled=disabled);}};
 const show=(r:Minute)=>{selected=r;open('Ata '+r.minutes.number,minuteDocument(r)+(r.minutes.state!=='ARCHIVED'?detailSection('Manifestações obrigatórias pendentes',prose(r.pending?.join(', ')||'Nenhuma')):'')+'<div class="minute-toolbar">'+r.actions.map(a=>`<button type="button" data-minute-action="${a}">${esc(label(a))}</button>`).join('')+(r.minutes.state==='ARCHIVED'?'<button type="button" data-minute-print>Baixar PDF institucional</button>'+(v.canCreateMinute?'<button type="button" data-minute-rectify>Registrar retificação</button>':''):'')+'</div><details><summary>Histórico das versões anteriores</summary>'+(r.versions||[]).map((x,i)=>`<button type="button" data-minute-version="${i}">Consultar versão ${x.contentRevision}</button>`).join('')+'</details>');if(dialog)disposeDownloads=mountFileDownloads(dialog,r,call);};
 const renderImages=()=>{const node=dialog?.querySelector('[data-minute-images]');if(node)node.innerHTML=images.map((im,i)=>`<label>Legenda da fotografia ${i+1}<input data-minute-caption="${i}" required maxlength="500" value="${esc(im.caption)}"></label><button type="button" data-minute-remove-image="${i}">Remover fotografia ${i+1}</button>`).join('');};
 const form=(r?:Minute,origin?:Minute)=>{selected=r;rectifies=origin;roster=[];rosterKey='';images=(r?.minutes.images||[]).map(x=>({...x}));open(r?'Revisar ata em nova versão':origin?'Registrar retificação':'Registrar ata',minuteForm(v,r,origin),true);renderImages();if(dialog)fileEditor=mountFileFields(dialog,r?.attachments,v.documentFilesEnabled);};
 const click=(e:MouseEvent)=>{if(!alive||busy||!(e.target instanceof Element))return;const t=e.target;if(t.closest('[data-minute-new]')&&v.canCreateMinute){form();return;}if(t.closest('[data-minute-recover]')){void perform('status',{});return;}
 const b=t.closest<HTMLElement>('[data-minute-detail]'),card=t.closest<HTMLElement>('[data-minute-card]');if(card&&(b||!t.closest('button,a,input,select'))){const r=minuteRecords(v).find(x=>x.id===card.dataset.minuteCard);if(r)show(r);return;}
 if(!dialog)return;if(t.closest('[data-minute-composition]')){const date=dialog.querySelector<HTMLInputElement>('[name=meetingDate]')?.value,board=dialog.querySelector<HTMLSelectElement>('[name=boardId]')?.value;if(date&&board)void perform('preview',{action:'COMPOSITION',boardId:board,meetingDate:date},true);else dialog.querySelector('[data-minute-feedback]')!.textContent='Informe a data e a gestão antes de consultar a composição.';return;}
 if(t.closest('[data-minute-add-ref]')){const refs=dialog.querySelector('[data-minute-references]');if(refs&&refs.children.length<10)refs.insertAdjacentHTML('beforeend',reference());return;}if(t.closest('[data-minute-remove-ref]')){t.closest('fieldset')?.remove();prepared=undefined;return;}
 if(t.closest('[data-minute-confirm]')&&prepared){void perform('execute',prepared);return;}
 if(t.closest('[data-minute-rectify]')&&selected&&v.canCreateMinute){form(undefined,selected);return;}
 const version=t.closest<HTMLElement>('[data-minute-version]');if(version&&selected){const old=selected.versions[Number(version.dataset.minuteVersion)];if(old){open('Versão histórica '+old.contentRevision,minuteDocument(old.record));if(dialog)disposeDownloads=mountFileDownloads(dialog,{id:selected.id,revision:selected.revision,contentRevision:old.contentRevision,attachments:old.record.attachments||[]},call);}return;}
 if(t.closest('[data-minute-print]')&&selected?.minutes.state==='ARCHIVED'){const r=selected;busy=true;const button=t.closest<HTMLButtonElement>('button');if(button)button.disabled=true;void (async()=>{try{const d=await call('document',{id:r.id,revision:r.revision});if(!alive||!dialog)return;const bytes=Uint8Array.from(atob(d.contentBase64),c=>c.charCodeAt(0)),hash=[...new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))].map(x=>x.toString(16).padStart(2,'0')).join('');if(bytes.length!==d.size||hash!==d.sha256||d.mime!=='application/pdf')throw Error('Não foi possível conferir a integridade do PDF.');const url=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'})),a=document.createElement('a');pdfUrls.push(url);a.href=url;a.download=d.name;a.textContent='Salvar PDF conferido';a.className='primary-button';dialog.querySelector('.modal-panel')?.append(a);const p=document.createElement('p');p.setAttribute('role','status');p.textContent=d.legacy?'PDF gerado a partir dos campos preservados; esta ata não possui texto integral aprovado.':'PDF conferido. Use “Salvar PDF conferido” para concluir o download.';dialog.querySelector('.modal-panel')?.append(p);}catch(e){if(alive&&dialog){const p=document.createElement('p');p.setAttribute('role','alert');p.textContent=e instanceof Error?e.message:'Não foi possível gerar o PDF.';dialog.querySelector('.modal-panel')?.append(p);}}finally{busy=false;if(button)button.disabled=false;}})();return;}
 if(t.closest('[data-minute-suggest]')){const f=dialog.querySelector<HTMLFormElement>('form');if(f){const value=(n:string)=>f.querySelector<HTMLInputElement|HTMLTextAreaElement>('[name="'+n+'"]')?.value||'',target=f.querySelector<HTMLTextAreaElement>('[name=fullText]');if(target){if(target.value.trim()&&!window.confirm('Substituir a redação atual por uma sugestão baseada nos campos?'))return;const attendance=[...f.querySelectorAll<HTMLSelectElement>('[data-minute-person]')].map(x=>({personId:x.dataset.minutePerson,presence:x.value}));target.value=suggestMinuteNarrative({date:value('meetingDate'),start:value('startTime'),end:value('endTime'),location:value('location'),agenda:value('agenda'),body:value('body'),decisions:value('decisions'),outcomes:value('outcomes'),present:roster.filter(p=>attendance.some(a=>a.personId===p.personId&&a.presence==='PRESENT')).map(p=>p.name),absent:roster.filter(p=>attendance.some(a=>a.personId===p.personId&&a.presence==='ABSENT')).map(p=>p.name)});prepared=undefined;}}return;}
 const removeImage=t.closest<HTMLElement>('[data-minute-remove-image]');if(removeImage){images.splice(Number(removeImage.dataset.minuteRemoveImage),1);prepared=undefined;renderImages();return;}

 const a=t.closest<HTMLElement>('[data-minute-action]')?.dataset.minuteAction;if(!a||!selected?.actions.includes(a))return;if(a==='EDIT'){form(selected);return;}open(label(a),'<p>'+esc(selected.title)+' · versão '+selected.minutes.contentRevision+'</p>'+(a==='APPROVE_SIGN'?'<p>Confirmo minha participação e a fidelidade do texto. Esta assinatura interna não é certificação ICP-Brasil nem voto favorável a todas as decisões.</p>':a==='ACKNOWLEDGE'?'<p>Registro ciência como ausente, sem assinatura de presença ou voto retroativo.</p>':'')+`<form data-minute-action-form data-action="${a}">`+(a==='REQUEST_CORRECTION'?textfield('excerpt','Trecho que exige correção','',1500):'<input type="hidden" name="excerpt" value="">')+textfield('reason','Justificativa / observação','',1500)+'<label><input type="checkbox" required> Conferi a versão e confirmo a manifestação indicada.</label><p data-minute-feedback role="status" aria-live="polite"></p><button type="submit">Revisar operação</button></form>',true);
 };
 const submit=(e:SubmitEvent)=>{if(!alive||busy||!(e.target instanceof HTMLFormElement)||!e.target.matches('[data-minute-form],[data-minute-action-form]'))return;e.preventDefault();const f=e.target,value=(n:string)=>(f.querySelector<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('[name="'+n+'"]')?.value||'').trim();if(f.matches('[data-minute-action-form]')){if(selected)void perform('preview',{action:f.dataset.action,id:selected.id,expectedRevision:v.revision,expectedRecordRevision:selected.revision,reason:value('reason'),excerpt:value('excerpt')});return;}
 const key=value('meetingDate')+'|'+value('boardId'),attendance=[...f.querySelectorAll<HTMLSelectElement>('[data-minute-person]')].map(x=>({personId:x.dataset.minutePerson,presence:x.value}));if(rosterKey!==key||!roster.length||attendance.length!==roster.length||attendance.some(p=>!p.presence)){f.querySelector('[data-minute-feedback]')!.textContent='Consulte a composição canônica e informe a participação de todos os diretores.';return;}
 const references=[...f.querySelectorAll<HTMLElement>('[data-minute-reference]')].map(el=>{const val=(n:string)=>(el.querySelector<HTMLInputElement>('[name="'+n+'"]')?.value||'').trim();return {label:val('refLabel'),url:val('refUrl'),sha256:val('refHash'),targetId:val('refTarget')||null,evidence:val('refEvidence')};});let documentaryEvidence,attachments;try{attachments=fileEditor?.input()||[];documentaryEvidence=documentaryInput(f,v.normativeVersions||[],selected?.documentaryEvidence);}catch(err){f.querySelector('[data-minute-feedback]')!.textContent=(err as Error).message;return;}void perform('preview',{attachments,documentaryEvidence,id:selected?.id||'',expectedRevision:v.revision,expectedRecordRevision:selected?.revision||0,title:value('title'),meetingDate:value('meetingDate'),body:value('body'),documentaryState:'DRAFT',sourceRecordId:selected?.sourceRecordId||null,references,reason:value('reason'),minutes:{fullText:value('fullText'),documentLayoutVersion:'GEAPA_MINUTE_PDF_1',images:images.map((im,i)=>({...im,caption:f.querySelector<HTMLInputElement>('[data-minute-caption="'+i+'"]')?.value.trim()||''})),number:value('number'),meetingType:value('meetingType'),boardId:value('boardId'),startTime:value('startTime'),endTime:value('endTime'),location:value('location'),modality:value('modality'),agenda:value('agenda'),decisions:value('decisions'),outcomes:value('outcomes'),attendance,access:value('access'),rectifiesId:selected?.minutes.rectifiesId||rectifies?.id||null}});
 };
 const imageChange=async(e:Event)=>{if(!(e.target instanceof HTMLInputElement)||!e.target.matches('[data-minute-image]'))return;const file=e.target.files?.[0];if(!file||!dialog)return;const feedback=dialog.querySelector<HTMLElement>('[data-minute-feedback]');try{if(images.length>=2||file.size>67500||!['image/jpeg','image/png'].includes(file.type))throw Error('Use até duas imagens PNG/JPEG de até 65 KiB cada.');const bytes=new Uint8Array(await file.arrayBuffer()),sha256=[...new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))].map(x=>x.toString(16).padStart(2,'0')).join('');if(!alive||!dialog)return;images.push({mime:file.type,base64:btoa(String.fromCharCode(...bytes)),sha256,caption:''});prepared=undefined;renderImages();}catch(err){if(feedback)feedback.textContent=err instanceof Error?err.message:'Falha ao carregar imagem.';}finally{e.target.value='';}};
 document.addEventListener('change',imageChange);
 const change=(e:Event)=>{if(!(e.target instanceof Element))return;if(e.target.matches('[data-minute-state]')){filter=(e.target as HTMLSelectElement).value;render();return;}if(e.target.closest('[data-minutes-dialog]')){prepared=undefined;dialog?.querySelector('[data-minute-feedback]')?.replaceChildren();}};
 document.addEventListener('click',click);document.addEventListener('submit',submit);document.addEventListener('input',change);document.addEventListener('change',change);
 return ()=>{alive=false;close();area.remove();document.removeEventListener('click',click);document.removeEventListener('submit',submit);document.removeEventListener('input',change);document.removeEventListener('change',change);document.removeEventListener('change',imageChange);};
}

export function suggestMinuteNarrative(v:{date:string;start:string;end:string;location:string;agenda:string;body:string;decisions:string;outcomes:string;present:string[];absent:string[]}):string{const parts:string[]=[];if(v.date)parts.push('Em '+v.date.split('-').reverse().join('/')+(v.start?', às '+v.start:'')+(v.location?', em '+v.location:'')+', reuniu-se a Diretoria do GEAPA.');if(v.present.length)parts.push('Participaram: '+v.present.join('; ')+'.');if(v.absent.length)parts.push('Registraram-se as ausências de: '+v.absent.join('; ')+'.');if(v.agenda)parts.push('A pauta registrada foi: '+v.agenda);if(v.body)parts.push(v.body);if(v.decisions)parts.push('Decisões e resultados registrados: '+v.decisions);if(v.outcomes)parts.push('Encaminhamentos registrados: '+v.outcomes);if(v.end)parts.push('O horário de término registrado foi '+v.end+'.');return parts.join('\n\n');}
