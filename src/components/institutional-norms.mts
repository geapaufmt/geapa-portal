import {esc,header,badge,detailFacts,detailSection,pagination} from './design-system.mjs';
import type {InstitutionalRecord} from './institutional-directory.mjs';
type Link={versionId:string;instrumentId:string;historical:boolean;current:boolean;evidence:string};
type Event={hidden:boolean;reason:string;actorPersonId:string;at:number;operationId:string};
export type NormRecord=InstitutionalRecord&{section:string;relation:{group:string;links:Link[];reviewRequired:boolean};presentation:Event|null;presentationHistory:Event[];canChangePresentation:boolean;sourceRevision:number;presentationRevision:number};
export type NormIndex={instruments:{id:string;title:string;description:string;versionIds:string[];currentVersionIds:string[]}[];versions:{id:string;instrumentId:string;version:string;documentaryStatus:string;current:boolean;effectiveFrom:string|null;files:{url:string;label:string;reference:string}[]}[]};
export type NormView={section:string;items:NormRecord[];index:NormIndex;instrument:string;hiddenCount:number;total:number;page:number;pages:number;unavailableSections:string[]};
const groups:Record<string,string>={versions:'Versões e arquivos',provisions:'Dispositivos por versão',proposals:'Propostas e emendas',faq:'Perguntas frequentes',explanations:'Conteúdos explicativos',parameters:'Parâmetros relacionados',governance:'Atas e deliberações'};
export function renderNormView(v:NormView,query='',visibility='VISIBLE'):string{
 const selected=v.index.instruments.find(i=>i.id===v.instrument),title=v.section==='norms'?'Normas e documentos':'Governança e deliberações';
 const row=(r:NormRecord,i:number)=>`<article class="geapa-record norm-record" data-institutional-card="${i}"><header class="geapa-record-head"><h3>${esc(r.fields.find(f=>f.label==='TITULO_PORTAL')?.value||r.title)}</h3>${badge(r.presentation?.hidden?'Oculto da lista padrão':r.status,!!r.issues.length)}</header><small>${esc(r.id)}</small><p>${r.relation.links.map(l=>`${esc(l.versionId)} · ${l.historical?'Referência histórica':l.current?'Versão canônica vigente':'Vigência não comprovada'}`).join('<br>')||'Relação normativa pendente de conferência'}</p>${r.relation.group==='faq'?'<p class="geapa-detail-note">Conteúdo documental para conferência; não é orientação pública vigente.</p>':''}<button type="button" data-institutional-detail="${i}">Ver detalhes</button></article>`;
 return header(title,v.section==='norms'?'Instrumentos institucionais, versões e referências documentais.':'Registros documentais e decisões, preservando seus estados efetivos.','<button data-institutional-refresh>Atualizar consulta</button><button data-institutional-recover>Consultar último envio</button>')+
 '<p class="geapa-board-notice">A consulta organiza evidências; não aprova propostas, altera normas ou publica conteúdo. Ocultar apenas organiza a lista administrativa.</p>'+
 `<form data-institutional-search class="institutional-search norms-search">${v.section==='norms'?`<label class="norm-selector">Instrumento normativo<select name="instrument"><option value="">Selecione um instrumento</option>${v.index.instruments.map(i=>`<option value="${esc(i.id)}" ${i.id===v.instrument?'selected':''}>${esc(i.title)}</option>`).join('')}<option value="UNRESOLVED" ${v.instrument==='UNRESOLVED'?'selected':''}>Relações a conferir</option></select></label>`:''}<label>Busca contextual<input type="search" name="query" maxlength="80" value="${esc(query)}"></label><label>Visualização<select name="visibility">${[['VISIBLE','Registros visíveis'],['HIDDEN','Registros ocultos'],['ALL','Todos os registros']].map(([id,label])=>`<option value="${id}" ${visibility===id?'selected':''}>${label}</option>`).join('')}</select></label><button type="submit">Consultar</button></form>`+
 (selected?`<section class="norm-instrument"><h3>${esc(selected.title)}</h3><p>${esc(selected.description)}</p><p>${selected.currentVersionIds.length?'Versão vigente comprovada: '+selected.currentVersionIds.map(esc).join(', '):'Nenhuma versão vigente comprovada neste instrumento.'}</p>${v.index.versions.filter(x=>x.instrumentId===selected.id&&x.current).map(x=>`<p>${esc(x.id)} · Vigência canônica: ${esc(x.effectiveFrom)} ${x.files.map(f=>`<a href="${esc(f.url)}" target="_blank" rel="noopener noreferrer">${esc(f.label)}</a>`).join(' ')}</p>`).join('')}</section>`:'')+
 (v.section==='norms'&&!v.instrument?'<p>Selecione uma norma para consultar suas versões e referências. Os registros sem associação comprovada permanecem em “Relações a conferir”.</p>':`<p class="geapa-results" role="status">${v.total} registros nesta consulta · ${v.hiddenCount} ocultos · página ${v.page} de ${v.pages}</p>`+Object.entries(groups).map(([id,label])=>{const matches=v.items.map((r,i)=>({r,i})).filter(x=>x.r.relation.group===id);return matches.length?`<details class="norm-section" ${id==='versions'||v.section==='governance'?'open':''}><summary>${esc(label)} <span>${matches.length}</span></summary><div class="geapa-record-grid">${matches.map(({r,i})=>row(r,i)).join('')}</div></details>`:'';}).join('')+(!v.total?'<p>Nenhum registro corresponde aos filtros.</p>':'')+pagination(v.page,v.pages,'data-institutional-page'))+
 (v.unavailableSections.length?'<p class="geapa-detail-note">Algumas referências relacionadas não estão disponíveis nesta autorização. Nenhum acesso adicional foi concedido.</p>':'');
}
export function normDetail(r:NormRecord):string{return detailSection('Relação normativa',r.relation.links.map(l=>`<p>${esc(l.versionId)} — ${l.historical?'Histórica':l.current?'Versão vigente comprovada':'Vigência não comprovada'}</p><small>${esc(l.evidence)}</small>`).join('')||'<p>Associação pendente de conferência.</p>')+detailSection('Apresentação administrativa',`<p>${r.presentation?.hidden?'Oculto da visualização padrão':'Visível na visualização padrão'}. Isso não modifica a validade normativa nem a publicação pública.</p>`+(r.canChangePresentation?'<button type="button" data-institutional-visibility>'+ (r.presentation?.hidden?'Reexibir registro':'Ocultar da lista padrão')+'</button>':'<p>Não há ação de ocultação autorizada para este registro.</p>'))+(r.presentationHistory.length?detailSection('Histórico de ocultação e reexibição',r.presentationHistory.map(e=>detailFacts([['Ação',e.hidden?'Ocultado':'Reexibido'],['Responsável',e.actorPersonId],['Data',new Date(e.at).toLocaleString('pt-BR')],['Motivo',e.reason],['Operação',e.operationId]])).join('')):'');}
export function visibilityForm(r:NormRecord):string{return `<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="visibility-title"><header class="modal-topbar"><h2 id="visibility-title">${r.presentation?.hidden?'Reexibir':'Ocultar'} ${esc(r.title)}</h2><button data-admin-modal-close aria-label="Fechar edição">×</button></header><p>Somente apresentação administrativa. O registro, sua validade e o conteúdo público serão preservados.</p><form data-institutional-visibility-form><label>Motivo administrativo<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label><div data-institutional-edit-feedback role="status" aria-live="polite"></div><button type="submit">Revisar alteração</button></form></section>`;}
