import {esc,detailSection} from './design-system.mjs';
export type DocumentFile={fileId:string;name:string;mime:string;size:number;sha256:string;caption:string;order:number;origin:string;documentId:string;documentVersion:number;actorPersonId:string;addedAt:number};
type Upload={name:string;mime:string;base64:string;sha256:string;origin:string;caption:string};
export function fileFields():string{return '<details open><summary>Arquivos privados da versão</summary><p>PDF, PNG, JPEG ou WebP. Até seis arquivos; novos arquivos somam até 3 MiB por salvamento. Fotografias são opcionais e não comprovam presença. O envio é confirmado junto ao recibo do salvamento.</p><label>Adicionar arquivo<input type="file" data-document-upload accept="application/pdf,image/png,image/jpeg,image/webp"></label><div data-document-files></div><p data-document-file-feedback role="status"></p></details>';}
export function mountFileFields(form:HTMLElement,old:DocumentFile[]=[],enabled=false){
 const rows:Array<{fileId?:string;name:string;mime:string;caption:string;upload?:Upload}>=old.map(f=>({...f}));let reading=false,alive=true;
 const render=()=>{const root=form.querySelector('[data-document-files]');if(root)root.innerHTML=rows.map((f,i)=>`<fieldset><legend>${esc(f.name)}</legend><label>Legenda / descrição<input data-document-caption="${i}" maxlength="500" ${f.mime.startsWith('image/')?'required minlength="3"':''} value="${esc(f.caption)}"></label><button type="button" data-document-up="${i}" ${i===0?'disabled':''}>Mover para cima</button><button type="button" data-document-remove="${i}">Retirar desta versão</button></fieldset>`).join('');const upload=form.querySelector<HTMLInputElement>('[data-document-upload]');if(upload)upload.disabled=!enabled||rows.length>=6||reading;};
 const captions=()=>rows.forEach((f,i)=>f.caption=form.querySelector<HTMLInputElement>('[data-document-caption="'+i+'"]')?.value.trim()||'');
 const click=(e:Event)=>{if(!(e.target instanceof Element))return;const remove=e.target.closest<HTMLElement>('[data-document-remove]'),up=e.target.closest<HTMLElement>('[data-document-up]');if(!remove&&!up)return;captions();if(remove)rows.splice(Number(remove.dataset.documentRemove),1);else{const i=Number(up!.dataset.documentUp);if(i>0)[rows[i-1],rows[i]]=[rows[i]!,rows[i-1]!];}render();form.dispatchEvent(new Event('input',{bubbles:true}));};
 const change=async(e:Event)=>{if(!(e.target instanceof HTMLInputElement)||!e.target.matches('[data-document-upload]'))return;const file=e.target.files?.[0],feedback=form.querySelector('[data-document-file-feedback]');if(!file||!enabled||reading)return;captions();reading=true;render();try{if(rows.length>=6||!['application/pdf','image/png','image/jpeg','image/webp'].includes(file.type)||file.size+rows.reduce((n,r)=>n+(r.upload?atob(r.upload.base64).length:0),0)>3145728)throw Error('Formato ou limite de arquivos excedido.');const bytes=new Uint8Array(await file.arrayBuffer());let binary='';for(let i=0;i<bytes.length;i+=32768)binary+=String.fromCharCode(...bytes.subarray(i,i+32768));const hash=[...new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))].map(x=>x.toString(16).padStart(2,'0')).join('');if(!alive)return;if(old.some(f=>rows.some(r=>r.fileId===f.fileId)&&f.sha256===hash)||rows.some(r=>r.upload?.sha256===hash))throw Error('Esse arquivo já está associado à versão.');captions();rows.push({name:file.name,mime:file.type,caption:'',upload:{name:file.name,mime:file.type,base64:btoa(binary),sha256:hash,origin:'LOCAL_UPLOAD',caption:''}});if(feedback)feedback.textContent='Arquivo preparado. Revise e confirme o salvamento para registrar o anexo.';form.dispatchEvent(new Event('input',{bubbles:true}));}catch(error){if(feedback)feedback.textContent=(error as Error).message;}finally{reading=false;e.target.value='';if(alive)render();}};
 form.addEventListener('click',click);form.addEventListener('change',change);render();
 return {input:()=>{if(reading)throw Error('Aguarde a leitura do arquivo.');captions();return rows.map(f=>f.fileId?{fileId:f.fileId,caption:f.caption}:{...f.upload!,caption:f.caption});},dispose:()=>{alive=false;form.removeEventListener('click',click);form.removeEventListener('change',change);}};
}
export function filesDetail(files:DocumentFile[]=[]):string{return detailSection('Arquivos privados',files.length?files.map(f=>`<article><strong>${esc(f.name)}</strong><p>${esc(f.caption)} · ${Math.ceil(f.size/1024)} KiB · versão de inclusão ${f.documentVersion}</p><button type="button" data-document-download="${esc(f.fileId)}">${f.mime.startsWith('image/')?'Visualizar fotografia':'Preparar download'}</button><div data-document-delivery="${esc(f.fileId)}"></div></article>`).join(''):'<p>Nenhum anexo nesta versão. Fotografias são opcionais.</p>');}
export async function checkedBlob(d:{contentBase64:string;size:number;sha256:string;mime:string}):Promise<Blob>{const bytes=Uint8Array.from(atob(d.contentBase64),c=>c.charCodeAt(0)),hash=[...new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))].map(x=>x.toString(16).padStart(2,'0')).join('');if(bytes.length!==d.size||hash!==d.sha256||!['application/pdf','image/png','image/jpeg','image/webp'].includes(d.mime))throw Error('Integridade do arquivo não confirmada.');return new Blob([bytes],{type:d.mime});}
export function mountFileDownloads(root:HTMLElement,r:{id:string;revision:number;attachments?:DocumentFile[]},call:(phase:string,payload:unknown)=>Promise<any>){let alive=true,busy=false;const urls:string[]=[];const click=async(e:Event)=>{if(!(e.target instanceof Element)||busy)return;const b=e.target.closest<HTMLButtonElement>('[data-document-download]');if(!b)return;const file=r.attachments?.find(f=>f.fileId===b.dataset.documentDownload),slot=root.querySelector('[data-document-delivery="'+b.dataset.documentDownload+'"]');if(!file||!slot)return;busy=true;b.disabled=true;slot.textContent='Conferindo acesso e integridade…';try{const d=await call('attachment',{id:r.id,revision:r.revision,fileId:file.fileId}),blob=await checkedBlob(d);if(!alive)return;const url=URL.createObjectURL(blob);urls.push(url);slot.replaceChildren();if(d.mime.startsWith('image/')){const img=document.createElement('img');img.src=url;img.alt=file.caption;img.style.cssText='max-width:100%;max-height:360px;object-fit:contain';slot.append(img);}const a=document.createElement('a');a.href=url;a.download=d.name;a.textContent='Salvar '+d.name;slot.append(a);}catch(error){if(alive)slot.textContent=(error as Error).message;}finally{busy=false;b.disabled=false;}};root.addEventListener('click',click);return ()=>{alive=false;root.removeEventListener('click',click);urls.forEach(u=>URL.revokeObjectURL(u));};}

