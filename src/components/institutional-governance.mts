import {mountProcedures,type ProcedureCatalog,type ProcedureRecord} from './board-procedures.mjs';
import {governanceSearch,emptyGovernanceQuery,type GovernanceQuery} from './institutional-governance-search.mjs';
import {fileFields,mountFileFields,filesDetail,mountFileDownloads,type DocumentFile} from './institutional-document-files.mjs';
import {documentaryFields,documentaryInput,documentaryDetails,type DocumentaryEvidence,type NormVersionOption} from './institutional-documentary-links.mjs';
import {mountMinutes,type MinutesView} from './institutional-minutes.mjs';
import {esc,detailFacts,detailSection,openDetailDialog,closeDetailDialog} from './design-system.mjs';
type Reference={label:string;url:string;sha256:string;targetId:string|null;evidence:string;association?:string};
type Draft=ProcedureRecord & {attachments?:DocumentFile[];documentaryEvidence?:DocumentaryEvidence;minutes?:unknown;id:string;revision:number;title:string;meetingDate:string|null;body:string;documentaryState:string;sourceRecordId:string|null;references:Reference[];updatedAt:number};
export type Governance=Omit<ProcedureCatalog,'records'> & {filters?:GovernanceQuery;pagination?:{page:number;pages:number;total:number}} & Omit<MinutesView,'records'|'history'> & {revision:number;canEdit:boolean;records:Draft[];history:{recordId:string;revision:number;reason:string;actorPersonId:string;at:number;operationId:string}[]};
type Host=Window&{PortalGeapaApi?:{apiPost:(route:string,params:{payload:string})=>Promise<{ok:boolean;data:any;message?:string}>}};
const states:Record<string,string>={DRAFT:'Rascunho administrativo',UNDER_REVIEW:'Em conferência documental',EVIDENCE_PENDING:'Aguardando evidências'};
export function governanceCards(v:Governance,query=''):string{
 const rows=v.records.filter(r=>!r.minutes&&r.kind!=='BOARD_PROCEDURE').filter(r=>!query||(r.id+' '+r.title+' '+r.body).toLocaleLowerCase().includes(query.toLocaleLowerCase()));
 return '<section class="norm-section"><h2>Registro administrativo</h2><p>Rascunhos não aprovam deliberações, não entram em vigor e não publicam conteúdo. As atas históricas permanecem preservadas abaixo.</p>'+(v.canEdit?'<button type="button" data-governance-new>Registrar ata ou deliberação</button>':'<p>🔒 Cadastro de rascunhos indisponível nesta autorização.</p>')+'<button type="button" data-governance-recover>Consultar último envio de rascunho</button><p role="status">'+rows.length+' rascunho(s)</p><div class="geapa-record-grid">'+rows.map(r=>`<article class="geapa-record" data-governance-card="${esc(r.id)}"><header class="geapa-record-head"><h3>${esc(r.title)}</h3><span class="geapa-badge">${esc(states[r.documentaryState])}</span></header><p>${esc(r.meetingDate||'Data da reunião não informada')} · revisão ${r.revision}</p><button type="button" data-governance-detail="${esc(r.id)}" aria-haspopup="dialog">Ver rascunho</button></article>`).join('')+'</div><div data-governance-result role="status" aria-live="polite"></div></section>';
}
export function governanceForm(d?:Draft,options:NormVersionOption[]=[]):string{
 return `<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="gov-title"><header class="modal-topbar"><h2 id="gov-title">${d?'Editar':'Registrar'} rascunho administrativo</h2><button type="button" data-admin-modal-close aria-label="Fechar">×</button></header><p>Não registra aprovação formal, vigência ou publicação. Data desconhecida pode ficar em branco.</p><form data-governance-form><label>Título<input name="title" required minlength="5" maxlength="240" value="${esc(d?.title||'')}"></label><label>Data da reunião, se conhecida<input type="date" name="meetingDate" value="${esc(d?.meetingDate||'')}"></label><label>Situação documental<select name="documentaryState">${Object.entries(states).map(([id,label])=>`<option value="${id}" ${d?.documentaryState===id?'selected':''}>${label}</option>`).join('')}</select></label><label>Registro da reunião ou deliberação<textarea name="body" required minlength="10" maxlength="8000">${esc(d?.body||'')}</textarea></label><label>ID da ata histórica relacionada, se comprovado<input name="sourceRecordId" maxlength="80" ${d?'readonly':''} value="${esc(d?.sourceRecordId||'')}"></label><details><summary>Referências documentais e evidências</summary><p>O hash identifica a cópia conferida pelo responsável. Uma associação indicada aqui permanece pendente até haver relação explícita na fonte canônica.</p><div data-governance-references>${(d?.references||[]).map(referenceFields).join('')}</div><button type="button" data-governance-add-reference>Adicionar referência</button></details>${fileFields()}${documentaryFields(options,d?.documentaryEvidence)}<label>Motivo administrativo<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><div data-governance-feedback role="status" aria-live="polite"></div><button type="submit">Revisar rascunho</button></form></section>`;
}
function referenceFields(r:Reference={label:'',url:'',sha256:'',targetId:null,evidence:''}):string{return `<fieldset data-governance-reference><legend>Documento de apoio</legend><label>Descrição<input name="refLabel" required maxlength="160" value="${esc(r.label)}"></label><label>Link do arquivo no Drive<input name="refUrl" type="url" required value="${esc(r.url)}"></label><label>SHA-256 da cópia conferida<input name="refHash" required pattern="[a-f0-9]{64}" value="${esc(r.sha256)}"></label><label>ID normativo relacionado, se documentado<input name="refTarget" maxlength="80" value="${esc(r.targetId||'')}"></label><label>Evidência da relação<textarea name="refEvidence" required minlength="10" maxlength="1500">${esc(r.evidence)}</textarea></label><button type="button" data-governance-remove-reference>Remover referência do rascunho</button></fieldset>`;}
export function mountGovernance(el:HTMLElement,v:Governance,reload:()=>Promise<void>,query='',search?:(q:GovernanceQuery)=>Promise<void>):()=>void{
 const cleanupMinutes=mountMinutes(el,v,reload,query);const cleanupProcedures=mountProcedures(el,v,reload);const area=document.createElement('div');area.innerHTML=(search?governanceSearch(v.filters||emptyGovernanceQuery(),v.boards,v.normativeVersions,v.pagination):'')+governanceCards(v,query);const anchorSearch=el.querySelector('[data-minutes-mount]')||el.querySelector('[data-institutional-search]');if(anchorSearch)anchorSearch.after(area);else el.append(area);let dialog:HTMLElement|undefined,active=true,busy=false,prepared:any,editing:Draft|undefined;
 let fileEditor:ReturnType<typeof mountFileFields>|undefined,disposeDownloads:(()=>void)|undefined;
 const close=()=>{fileEditor?.dispose();fileEditor=undefined;disposeDownloads?.();disposeDownloads=undefined;const opened=dialog;dialog=undefined;if(opened){closeDetailDialog(opened,true);opened.remove();}prepared=undefined;};
 const open=(html:string,draft=false)=>{close();dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;dialog.dataset.governanceDialog='';if(draft)dialog.setAttribute('data-geapa-protect-draft','');dialog.innerHTML=html;document.body.append(dialog);const opened=dialog;openDetailDialog(opened,()=>{if(busy)return;opened.remove();if(dialog===opened)dialog=undefined;});document.dispatchEvent(new CustomEvent('portal:institutional-dialog-opened'));};
 const call=async(phase:string,payload:unknown)=>{if(busy)return;busy=true;const opened=dialog,feedback=opened?.querySelector<HTMLElement>('[data-governance-feedback]')||area.querySelector<HTMLElement>('[data-governance-result]'),controls=[...(opened?.querySelectorAll<HTMLInputElement>('input,textarea,select,button')||[])].map(e=>({e,disabled:e.disabled}));opened?.setAttribute('aria-busy','true');controls.forEach(({e})=>e.disabled=true);try{const r=await (window as Host).PortalGeapaApi?.apiPost('/admin/gestao-institucional/governanca/editar',{payload:JSON.stringify({phase,payload})});if(!active)return;if(!r?.ok)throw Error(r?.message||'Não foi possível confirmar o registro.');if(phase==='preview'){prepared=r.data.request;if(feedback)feedback.innerHTML='<p>Prévia do registro administrativo (sem aprovação ou publicação):</p><pre style="white-space:pre-wrap;overflow-wrap:anywhere">'+esc(r.data.preview.value)+'</pre><button type="button" data-governance-confirm>Confirmar rascunho interno</button>';}else if(r.data.state==='COMPLETED'){const completed=true;close();await reload();if(active)return;const p=document.createElement('p');p.setAttribute('role','status');p.textContent=completed?'Rascunho confirmado. Recibo '+r.data.operationId+'. Nenhuma publicação ou aprovação formal.':'Nenhuma alteração admitida para o último envio.';el.prepend(p);}else if(feedback){feedback.textContent='Resultado ainda não confirmado. Seu texto está preservado; consulte o último envio antes de repetir.';}}catch(e){prepared=undefined;if(active&&feedback)feedback.textContent=(e instanceof Error?e.message:'Falha na operação.')+' Consulte o último envio antes de repetir.';}finally{busy=false;opened?.removeAttribute('aria-busy');controls.forEach(({e,disabled})=>e.disabled=disabled);}};
 const click=(e:MouseEvent)=>{if(!active||!(e.target instanceof Element)||busy)return;const t=e.target;
  if(t.closest('[data-governance-clear]')&&search){void search(emptyGovernanceQuery());return;}const pg=t.closest<HTMLElement>('[data-governance-page]');if(pg&&search){void search({...v.filters||emptyGovernanceQuery(),page:Number(pg.dataset.governancePage)});return;}
  if(t.closest('[data-governance-recover]')){void call('status',{});return;}
  if(t.closest('[data-governance-new]')&&v.canEdit){editing=undefined;open(governanceForm(undefined,v.normativeVersions),true);if(dialog)fileEditor=mountFileFields(dialog,[],v.documentFilesEnabled);return;}
  const card=t.closest<HTMLElement>('[data-governance-card]'),button=t.closest<HTMLElement>('[data-governance-detail]');if(card&&(button||!t.closest('button,a,input,select'))){const d=v.records.find(x=>x.id===card.dataset.governanceCard);if(!d)return;editing=d;open(`<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="gov-detail"><header class="modal-topbar"><h2 id="gov-detail">${esc(d.title)}</h2><button type="button" data-admin-modal-close aria-label="Fechar">×</button></header>`+detailFacts([['Situação',states[d.documentaryState]],['Data',d.meetingDate||'Não informada'],['Revisão',String(d.revision)],['Aprovação formal','Não registrada por este fluxo'],['Publicação','Fechada']])+detailSection('Registro',`<p style="white-space:pre-wrap">${esc(d.body)}</p>`)+detailSection('Documentos e relações',d.references.map(r=>detailFacts([['Documento',r.label],['Referência',r.url],['Hash',r.sha256],['Associação',r.association==='DOCUMENTED_SOURCE_LINK'?'Relação explícita na fonte':r.targetId?'Pendente de conferência':'Referência documental'],['Evidência',r.evidence]])).join('')||'<p>Sem documentos vinculados.</p>')+filesDetail(d.attachments)+documentaryDetails(d.documentaryEvidence)+detailSection('Histórico',v.history.filter(h=>h.recordId===d.id).map(h=>detailFacts([['Revisão',String(h.revision)],['Responsável',h.actorPersonId],['Motivo',h.reason],['Data',new Date(h.at).toLocaleString('pt-BR')],['Recibo',h.operationId]])).join(''))+(v.canEdit?'<button type="button" data-governance-edit>Editar rascunho</button>':'')+'</section>');if(dialog)disposeDownloads=mountFileDownloads(dialog,d,async(phase,payload)=>{const r=await (window as Host).PortalGeapaApi?.apiPost('/admin/gestao-institucional/governanca/editar',{payload:JSON.stringify({phase,payload})});if(!r?.ok)throw Error(r?.message||'Falha na consulta do arquivo.');return r.data;});return;}
  if(t.closest('[data-governance-edit]')&&editing&&v.canEdit){open(governanceForm(editing,v.normativeVersions),true);if(dialog)fileEditor=mountFileFields(dialog,editing.attachments,v.documentFilesEnabled);return;}
  if(t.closest('[data-governance-add-reference]')&&dialog){const refs=dialog.querySelector('[data-governance-references]');if(refs&&refs.children.length<10){refs.insertAdjacentHTML('beforeend',referenceFields());prepared=undefined;}return;}
  if(t.closest('[data-governance-remove-reference]')){t.closest('fieldset')?.remove();prepared=undefined;return;}
  if(t.closest('[data-governance-confirm]')&&prepared)void call('execute',prepared);
 };
 const submit=(e:SubmitEvent)=>{if(e.target instanceof HTMLFormElement&&e.target.matches('[data-governance-search]')&&search){e.preventDefault();const f=new FormData(e.target),q=emptyGovernanceQuery();for(const k of ['query','meetingType','boardId','state','from','to','normVersionId','procedureType','proposer','documentId'] as const)q[k]=String(f.get(k)||'').trim();void search(q);return;}if(!active||!(e.target instanceof HTMLFormElement)||!e.target.matches('[data-governance-form]'))return;e.preventDefault();if(!v.canEdit)return;const f=new FormData(e.target),value=(k:string)=>String(f.get(k)||'').trim();const references=[...e.target.querySelectorAll<HTMLElement>('[data-governance-reference]')].map(r=>{const val=(n:string)=>(r.querySelector<HTMLInputElement>('[name="'+n+'"]')?.value||'').trim();return {label:val('refLabel'),url:val('refUrl'),sha256:val('refHash'),targetId:val('refTarget')||null,evidence:val('refEvidence')};});let documentaryEvidence,attachments;try{attachments=fileEditor?.input()||[];documentaryEvidence=documentaryInput(e.target,v.normativeVersions||[],editing?.documentaryEvidence);}catch(err){const f=dialog?.querySelector('[data-governance-feedback]');if(f)f.textContent=(err as Error).message;return;}void call('preview',{attachments,documentaryEvidence,id:editing?.id||'',expectedRevision:v.revision,expectedRecordRevision:editing?.revision||0,title:value('title'),meetingDate:value('meetingDate')||null,body:value('body'),documentaryState:value('documentaryState'),sourceRecordId:value('sourceRecordId')||null,references,reason:value('reason')});};
 const input=(e:Event)=>{if(e.target instanceof Element&&e.target.closest('[data-governance-form]')){prepared=undefined;dialog?.querySelector('[data-governance-feedback]')?.replaceChildren();}};
 document.addEventListener('click',click);document.addEventListener('submit',submit);document.addEventListener('input',input);
 return ()=>{cleanupProcedures();cleanupMinutes();active=false;close();area.remove();document.removeEventListener('click',click);document.removeEventListener('submit',submit);document.removeEventListener('input',input);};
}
