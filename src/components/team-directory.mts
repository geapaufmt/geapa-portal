import {esc,header,openDetailDialog,closeDetailDialog} from './design-system.mjs';
export type TeamPerson={publicKey?:string;displayName:string;photoUrl:string|null;category:string;categories?:string[];functions:string[];period?:{startDate:string|null;endDate:string|null};biography?:string;links?:{label:string;url:string}[]};
export const teamCategories=[['BOARD','Diretoria vigente'],['MEMBER','Membros e assessores'],['ACADEMIC','Orientadores e colaboradores acadêmicos'],['EGRESS','Egressos']] as const;
const order=['PRESIDENTE','VICE PRESIDENTE','DIRETOR ADMINISTRATIVO','DIRETOR RECURSOS HUMANOS','TESOUREIRO','DIRETOR FINANCEIRO','DIRETOR COMUNICACAO','DIRETOR EXTENSAO'];
const categories=(p:TeamPerson)=>p.categories||(p.category==='DIRETOR'?['BOARD','MEMBER']:p.category==='MEMBRO'?['MEMBER']:[]);
export function teamSection(items:TeamPerson[],category:string,query='',page=1):{html:string;total:number;pages:number}{
 const norm=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase(),q=norm(query);
 const filtered=items.filter(p=>categories(p).includes(category)&&norm(p.displayName+' '+p.functions.join(' ')).includes(q));
 const rank=(p:TeamPerson)=>Math.min(...p.functions.map(f=>{const n=order.indexOf(f.replaceAll('_',' '));return n<0?99:n;}),99);
 filtered.sort((a,b)=>(category==='BOARD'?rank(a)-rank(b):0)||a.displayName.localeCompare(b.displayName,'pt-BR'));
 return {total:filtered.length,pages:Math.max(1,Math.ceil(filtered.length/12)),html:filtered.slice((page-1)*12,page*12).map(p=>`<article class="geapa-record geapa-team-person" data-team-person="${items.indexOf(p)}" tabindex="0" role="button" aria-label="Ver perfil de ${esc(p.displayName)}">${p.photoUrl?`<img src="${esc(p.photoUrl)}" alt="${esc(p.displayName)}" loading="lazy" referrerpolicy="no-referrer">`:'<span class="geapa-team-avatar" aria-hidden="true">●</span>'}<h3>${esc(p.displayName)}</h3><p>${p.functions.map(f=>esc(f==='TESOUREIRO'?'Diretor Financeiro':f.replaceAll('_',' '))).join(' · ')||esc(teamCategories.find(c=>c[0]===category)?.[1])}</p>${p.period?`<p>${esc(p.period.startDate||'Início não publicado')}${p.period.endDate?' — '+esc(p.period.endDate):''}</p>`:''}${p.biography?`<p>${esc(p.biography)}</p>`:''}${p.links?.map(l=>`<a href="${esc(l.url)}" rel="noopener noreferrer" target="_blank">${esc(l.label)}</a>`).join('')||''}</article>`).join('')};
}
type Host=Window&{PortalGeapaNavigation?:{getRotaAtual:()=>string}};
let generation=0,items:TeamPerson[]=[],category='BOARD',query='',page=1;
const route=()=>typeof window==='undefined'?'':(window as Host).PortalGeapaNavigation?.getRotaAtual()||'';
const active=()=>['equipe','diretoria-publica','membros-publicos','orientadores'].includes(route());
function showPerson(index:number){const person=items[index];if(!person)return;const modal=document.createElement('div');modal.className='modal-backdrop';modal.hidden=true;modal.innerHTML='<section role="dialog" aria-modal="true" aria-label="Perfil público" class="modal-card"><header class="modal-topbar"><h2>'+esc(person.displayName)+'</h2><button type="button" data-admin-modal-close aria-label="Fechar">×</button></header><div class="modal-body">'+(person.photoUrl?'<img class="geapa-team-avatar" src="'+esc(person.photoUrl)+'" alt="'+esc(person.displayName)+'" referrerpolicy="no-referrer">':'')+'<p>'+person.functions.map(f=>esc(f==='TESOUREIRO'?'Diretor Financeiro':f.replaceAll('_',' '))).join(' · ')+'</p>'+(person.period?'<p>'+esc(person.period.startDate||'Início não publicado')+' — '+esc(person.period.endDate||'Término não publicado')+'</p>':'')+(person.biography?'<p>'+esc(person.biography)+'</p>':'')+(person.links||[]).map(l=>'<p><a target="_blank" rel="noopener noreferrer" href="'+esc(l.url)+'">'+esc(l.label)+'</a></p>').join('')+'</div></section>';document.body.append(modal);openDetailDialog(modal,()=>modal.remove());}
function render(){const el=document.getElementById('placeholder-content');if(!el||!active())return;const result=teamSection(items,category,query,page);el.innerHTML=header('Equipe GEAPA','Pessoas e relações institucionais com publicação autorizada.','','','Área Pública')+`<p class="geapa-board-notice">A composição pública é publicada separadamente do cadastro administrativo. A ausência de um nome aqui não indica ausência de vínculo institucional.</p><nav class="geapa-team-tabs" aria-label="Categorias da equipe">${teamCategories.map(([id,label])=>`<button type="button" data-team-category="${id}" aria-pressed="${id===category}">${esc(label)}</button>`).join('')}</nav><label>Buscar na equipe<input type="search" data-team-search value="${esc(query)}" placeholder="Nome ou função"></label><p role="status">${result.total} perfis publicados nesta categoria</p><div class="geapa-record-grid">${result.html||'<p>Nenhum perfil publicado nesta categoria. A publicação depende de seleção e autorização específicas.</p>'}</div>${result.pages>1?`<div><button data-team-page="${page-1}" ${page===1?'disabled':''}>Anterior</button><span>Página ${page} de ${result.pages}</span><button data-team-page="${page+1}" ${page===result.pages?'disabled':''}>Próxima</button></div>`:''}`;}
async function load(){const epoch=++generation,el=document.getElementById('placeholder-content');items=[];query='';page=1;if(!el||!active())return;category=route()==='orientadores'?'ACADEMIC':route()==='membros-publicos'?'MEMBER':'BOARD';el.textContent='Consultando composição pública…';try{const url='/assets/act-command/team-public.mjs',service=await import(url),result=await service.readPublicTeam();if(epoch!==generation||!active())return;items=result;render();}catch{if(epoch===generation&&active())el.innerHTML='<p role="alert">Não foi possível consultar a composição pública. Nenhum dado antigo foi exibido.</p><button data-team-refresh>Atualizar</button>';}}
if(typeof document!=='undefined'){
 document.addEventListener('portal:navigationchange',()=>{generation++;document.querySelectorAll<HTMLElement>('.geapa-detail-modal').forEach(m=>closeDetailDialog(m,true));items=[];if(active())void load();});
 document.addEventListener('click',e=>{if(!active()||!(e.target instanceof Element))return;const person=e.target.closest<HTMLElement>('[data-team-person]');if(person&&!e.target.closest('a,button')){showPerson(Number(person.dataset.teamPerson));return;}const c=e.target.closest<HTMLElement>('[data-team-category]'),p=e.target.closest<HTMLElement>('[data-team-page]');if(c&&teamCategories.some(v=>v[0]===c.dataset.teamCategory)){category=c.dataset.teamCategory!;page=1;render();document.querySelector<HTMLElement>(`[data-team-category="${category}"]`)?.focus();}else if(p){page=Math.max(1,Number(p.dataset.teamPage));render();}else if(e.target.closest('[data-team-refresh]'))void load();});
 document.addEventListener('keydown',e=>{if(active()&&(e.key==='Enter'||e.key===' ')&&e.target instanceof HTMLElement&&e.target.matches('[data-team-person]')){e.preventDefault();showPerson(Number(e.target.dataset.teamPerson));}});
 document.addEventListener('input',e=>{if(active()&&e.target instanceof HTMLInputElement&&e.target.matches('[data-team-search]')){query=e.target.value;page=1;render();const input=document.querySelector<HTMLInputElement>('[data-team-search]');input?.focus();input?.setSelectionRange(query.length,query.length);}});
}
