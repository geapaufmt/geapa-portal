import {esc,header,badge,detailFacts,detailSection} from './design-system.mjs';
type Permission={label:string;module:string;action:string;status:'CONDITIONAL'|'NOT_ENABLED';reason:string;limits:{cycleIds:string[];nominalResources:boolean;nominalPersons:boolean;policyValidUntil:string|null}};
type Office={personId:string;name:string;roleKey:string;boardId:string;startDate:string;endDate:string|null;duties:{source:string;summary:string;verified:boolean};permissions:Permission[]};
export type BoardCompetencies={schemaVersion:'board-competencies-v1';asOf:string;validUntil:number;items:Office[];notice:string};
const date=(v:string|null)=>v?new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Cuiaba'}).format(new Date(v.length===10?v+'T12:00:00-04:00':v)):'Não definida';
const names:Record<string,string>={PRESIDENTE:'Presidência',VICE_PRESIDENTE:'Vice-Presidência',DIRETOR_RECURSOS_HUMANOS:'Diretoria de Recursos Humanos',DIRETOR_ADMINISTRATIVO:'Diretoria Administrativa',DIRETOR_EXTENSAO:'Diretoria de Extensão',DIRETOR_COMUNICACAO:'Diretoria de Comunicação',SECRETARIO_GERAL:'Secretaria Geral',SECRETARIO_EXECUTIVO:'Secretaria Executiva'};
export function renderBoardCompetencies(data:BoardCompetencies):string{
 return header('Diretoria e competências','Atribuições institucionais e acessos configurados no Portal.','<button type="button" data-board-refresh>Atualizar consulta</button>')+
 `<p class="intro">${esc(data.notice)}</p><p class="geapa-results">Consulta atualizada em ${esc(new Date(data.asOf).toLocaleString('pt-BR'))}</p><div class="geapa-record-grid">`+
 data.items.map(item=>`<article class="geapa-record-card"><header><h3>${esc(names[item.roleKey]||item.roleKey.replaceAll('_',' '))}</h3>${badge('Em exercício')}</header><p><strong>${esc(item.name)}</strong></p>${detailFacts([['Gestão',item.boardId],['Início',date(item.startDate)],['Término previsto documentado',date(item.endDate)]])}${detailSection('Atribuições institucionais',`<p>${esc(item.duties.summary)}</p><p class="muted">${esc(item.duties.source)}</p>${item.duties.verified?'':'<p>Documento específico pendente de vinculação; as permissões abaixo não substituem o ato institucional.</p>'}`)}<details><summary>Permissões no Portal · ${item.permissions.length}</summary>${item.permissions.length?item.permissions.map(p=>`<section class="situation-section"><h4>${esc(p.label)}</h4><p>${esc(p.module)} · ${esc(p.action)}</p>${badge(p.status==='CONDITIONAL'?'Habilitada sob condições':'Não habilitada',p.status!=='CONDITIONAL')}<p>${esc(p.reason)}</p>${p.limits.cycleIds.length?`<p>Ciclos: ${p.limits.cycleIds.map(esc).join(', ')}</p>`:''}${p.limits.nominalResources||p.limits.nominalPersons?'<p>Escopo nominal de pessoas e/ou recursos; sem acesso irrestrito.</p>':''}${p.limits.policyValidUntil?`<p>Autorização até ${esc(date(p.limits.policyValidUntil))}; função e vínculo são revalidados separadamente.</p>`:''}</section>`).join(''):'<p>Nenhuma permissão operacional aplicável nesta consulta.</p>'}</details></article>`).join('')+'</div>';
}
type PortalWindow=Window&{PortalGeapaApi?:{apiGet:(route:string,params:Record<string,never>)=>Promise<{ok:boolean;data:BoardCompetencies;message?:string}>};PortalGeapaNavigation?:{getRotaAtual:()=>string}};
let generation=0,timer:ReturnType<typeof setTimeout>|undefined;
async function load(){const w=window as PortalWindow,el=document.getElementById('placeholder-content');if(!el||w.PortalGeapaNavigation?.getRotaAtual()!=='diretoria-competencias')return;const epoch=++generation;clearTimeout(timer);el.classList.add('geapa-admin');el.textContent='Consultando a Diretoria e suas autorizações…';
 try{const r=await w.PortalGeapaApi?.apiGet('/admin/diretoria-competencias',{});if(epoch!==generation||!el.isConnected)return;if(!r?.ok)throw Error(r?.message||'Não foi possível consultar a Diretoria.');if(r.data.schemaVersion!=='board-competencies-v1'||r.data.validUntil<=Date.now())throw Error('A autorização da consulta expirou. Atualize para consultar novamente.');el.innerHTML=renderBoardCompetencies(r.data);timer=setTimeout(()=>{if(epoch===generation){el.innerHTML=header('Diretoria e competências','Atualize para revalidar os vínculos e as permissões.','<button type="button" data-board-refresh>Atualizar consulta</button>');}},r.data.validUntil-Date.now());}
 catch(e){if(epoch===generation){el.replaceChildren();const p=document.createElement('p');p.setAttribute('role','alert');p.textContent=e instanceof Error?e.message:'Consulta indisponível.';const b=document.createElement('button');b.type='button';b.dataset.boardRefresh='';b.textContent='Atualizar consulta';el.append(p,b);}}
}
if(typeof document!=='undefined'){
 document.addEventListener('portal:navigationchange',e=>{generation++;clearTimeout(timer);if((e as CustomEvent).detail?.rota?.id==='diretoria-competencias')void load();});
 document.addEventListener('click',e=>{if(e.target instanceof Element&&e.target.closest('[data-board-refresh]'))void load();});
 document.addEventListener('portal:act-session-cleared',()=>{generation++;clearTimeout(timer);if((window as PortalWindow).PortalGeapaNavigation?.getRotaAtual()==='diretoria-competencias')document.getElementById('placeholder-content')?.replaceChildren();});
}
