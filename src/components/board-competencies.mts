import {boardHistoryCards,boardHistoryDetail,type BoardHistory} from './board-history.mjs';
import {esc,header,badge,detailFacts,detailSection,openDetailDialog,closeDetailDialog} from './design-system.mjs';
import {type Tenure,tenureSegments} from './institutional-tenure.mjs';
type Permission={label:string;module:string;action:string;status:'CONDITIONAL'|'NOT_ENABLED';reason:string;limits:{cycleIds:string[];nominalResources:boolean;nominalPersons:boolean;policyValidUntil:string|null}};
type Office={personId:string;name:string;roleKey:string;boardId:string;startDate:string;endDate:string|null;tenure?:Tenure;status?:string;duties:{source:string;summary:string;verified:boolean};permissions:Permission[]};
export type BoardCompetencies={schemaVersion:'board-competencies-v1';asOf:string;validUntil:number;items:Office[];history?:BoardHistory|null;notice:string};
type OfficeSlot={key:string;label:string;offices:Office[]};
// Display order and aliases only. These values never authorize an operation.
const offices:readonly (readonly [string,string,readonly string[]])[]=[
 ['PRESIDENTE','Presidente',['PRESIDENTE']],['VICE_PRESIDENTE','Vice-Presidente',['VICE_PRESIDENTE']],
 ['DIRETOR_ADMINISTRATIVO','Diretoria Administrativa',['DIRETOR_ADMINISTRATIVO']],
 ['DIRETOR_RECURSOS_HUMANOS','Diretoria de Recursos Humanos',['DIRETOR_RECURSOS_HUMANOS']],
 ['DIRETOR_FINANCEIRO','Diretoria Financeira',['DIRETOR_FINANCEIRO','TESOUREIRO']],
 ['DIRETOR_COMUNICACAO','Diretoria de Comunicação',['DIRETOR_COMUNICACAO']],['DIRETOR_EXTENSAO','Diretoria de Extensão',['DIRETOR_EXTENSAO']]
];
export function boardRoleOrder(roleKey:string):number{const index=offices.findIndex(([, ,aliases])=>aliases.includes(roleKey));return index<0?99:index;}
const extraNames:Record<string,string>={SECRETARIO_GERAL:'Secretaria Geral',SECRETARIO_EXECUTIVO:'Secretaria Executiva'};
export function boardSlots(data:BoardCompetencies):OfficeSlot[]{
 const known=new Set(offices.flatMap(([, ,aliases])=>[...aliases]));
 const slots=offices.map(([key,label,aliases])=>({key,label,offices:data.items.filter(v=>aliases.includes(v.roleKey))}));
 for(const item of data.items.filter(v=>!known.has(v.roleKey))){const found=slots.find(v=>v.key===item.roleKey);if(found)found.offices.push(item);else slots.push({key:item.roleKey,label:extraNames[item.roleKey]||item.roleKey.replaceAll('_',' '),offices:[item]});}
 return slots;
}
function date(value:string|null):string{if(!value)return 'Não informado';const d=new Date(value.length===10?value+'T12:00:00-04:00':value);return Number.isNaN(d.getTime())?'Data não reconhecida':new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Cuiaba'}).format(d);}
function situation(slot:OfficeSlot,asOf:string):string{
 const o=slot.offices[0];if(!o)return 'Sem ocupante informado';if(slot.offices.length>1)return 'Conferir registros';
 const explicit:Record<string,string>={VACANT:'Vago',PENDING_APPOINTMENT:'Nomeação pendente',ENDED:'Encerrado',ACTIVE:'Em exercício'};
 if(o.status)return explicit[o.status]||'Situação a conferir';
 const ref=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Cuiaba',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(asOf));
 if(o.endDate&&/^\d{4}-\d{2}-\d{2}$/.test(o.endDate)&&o.endDate<ref)return 'Encerrado';
 if(o.startDate&&/^\d{4}-\d{2}-\d{2}$/.test(o.startDate)&&o.startDate>ref)return 'Exercício previsto';
 return 'Em exercício'; // Canonical v1 reader resolves current functions; not an authorization check.
}
const short=(s:string,max=136)=>s.length>max?s.slice(0,max-1).trimEnd()+'…':s;
const permissionLabel=(p:Permission)=>p.label==='presentation material exception'?'Analisar exceção de material':p.label;
function officeCard(slot:OfficeSlot,index:number,asOf:string):string{
 const state=situation(slot,asOf),o=slot.offices[0],multiple=slot.offices.length>1,all=slot.offices.flatMap(v=>v.permissions),enabled=all.filter(p=>p.status==='CONDITIONAL').length,disabled=all.length-enabled;
 const permissionSummary=!o?'Permissões não informadas':multiple?'Permissões separadas por registro':enabled+' '+(enabled===1?'permissão configurada':'permissões configuradas')+' no Portal';
 const facts=o&&!multiple?detailFacts([['Gestão',o.boardId||'Não informada'],['Início',date(o.startDate)],['Término previsto documentado',date(o.endDate)]]):'';
 const description=!o?'Nenhum ocupante foi informado pelo Core nesta consulta.':multiple?'Mais de um registro foi retornado para este cargo. Consulte os detalhes antes de interpretar sua situação.':o.duties.verified?short(o.duties.summary):'Atribuições específicas aguardam vinculação do ato institucional.';
 return `<article class="geapa-record geapa-board-card" data-board-office="${index}" aria-labelledby="board-office-${index}"><header class="geapa-record-head"><h3 id="board-office-${index}">${esc(slot.label)}</h3>${badge(state,state!=='Em exercício')}</header><p class="geapa-board-person">${esc(slot.offices.map(v=>v.name||'Nome não informado').join(' · ')||'Ocupante não informado')}</p>${facts}<p class="geapa-board-duty">${esc(description)}</p><p class="geapa-board-source">${esc(o&&!multiple?o.duties.source||'Referência não informada':'Sem referência documental suficiente nesta consulta.')}</p><footer class="geapa-record-foot"><div><span>${esc(permissionSummary)}</span>${disabled&&!multiple?`<small>${disabled} ${disabled===1?'item não habilitado':'itens não habilitados'}</small>`:''}</div><button class="secondary-button" type="button" data-board-detail="${index}" aria-haspopup="dialog" aria-label="Ver permissões e detalhes: ${esc(slot.label)}">Ver permissões</button></footer></article>`;
}
export function renderBoardCompetencies(data:BoardCompetencies,tab:'offices'|'history'='offices'):string{
 const slots=boardSlots(data);
 const tabs=`<nav aria-label="Diretoria e competências"><button type="button" data-board-tab="offices" aria-current="${tab==='offices'?'page':'false'}">Cargos e Competências</button> <button type="button" data-board-tab="history" aria-current="${tab==='history'?'page':'false'}">Histórico de Diretorias</button></nav>`;
 if(tab==='history')return header('Diretoria e competências','Gestões, composição e documentação institucional.','<button type="button" data-board-refresh>Atualizar consulta</button>')+tabs+boardHistoryCards(data.history);
 return tabs+header('Diretoria e competências','Quem compõe a gestão e quais acessos estão configurados no Portal.','<button type="button" data-board-refresh>Atualizar consulta</button>')+`<p class="geapa-board-notice">${esc(data.notice)}</p><p class="geapa-results">Consulta atualizada em ${esc(new Date(data.asOf).toLocaleString('pt-BR',{timeZone:'America/Cuiaba'}))}</p><div class="geapa-record-grid geapa-board-grid">${slots.slice(0,7).map((slot,i)=>officeCard(slot,i,data.asOf)).join('')}</div>`+(slots.length>7?`<h3 class="geapa-board-extra">Outros cargos informados pelo Core</h3><div class="geapa-record-grid geapa-board-grid">${slots.slice(7).map((slot,i)=>officeCard(slot,i+7,data.asOf)).join('')}</div>`:'');
}
function permissionGroups(items:Permission[]):string{
 const groups=new Map<string,Permission[]>();for(const p of items){const group=p.module||'Outras permissões informadas';groups.set(group,[...(groups.get(group)||[]),p]);}
 if(!items.length)return '<p>Nenhuma permissão operacional foi informada para este registro.</p>';
 return [...groups].map(([group,permissions])=>`<section class="geapa-board-permission-group"><h4>${esc(group)}</h4><ul>${permissions.map(p=>`<li><div class="geapa-board-permission-head"><strong>${esc(permissionLabel(p))}</strong>${badge(p.status==='CONDITIONAL'?'Habilitada sob condições':'Não habilitada',p.status!=='CONDITIONAL')}</div><p class="geapa-board-permission-action">${esc(p.action)}</p><p>${esc(p.reason)}</p>${p.limits.cycleIds.length?`<p>Ciclos: ${p.limits.cycleIds.map(esc).join(', ')}</p>`:''}${p.limits.nominalResources||p.limits.nominalPersons?'<p>Escopo nominal de pessoas e/ou recursos.</p>':''}${p.limits.policyValidUntil?`<p>Validade da autorização: ${esc(date(p.limits.policyValidUntil))}.</p>`:''}</li>`).join('')}</ul></section>`).join('');
}
export function renderBoardOfficeDetail(data:BoardCompetencies,index:number):string{
 const slot=boardSlots(data)[index];if(!slot)return '';
 return `<section class="modal-panel geapa-board-panel" role="dialog" aria-modal="true" aria-labelledby="board-dialog-title"><header class="modal-topbar"><div><p class="geapa-eyebrow">Diretoria e competências</p><h2 id="board-dialog-title">${esc(slot.label)}</h2></div><button type="button" data-admin-modal-close aria-label="Fechar detalhes do cargo">×</button></header>${slot.offices.length>1?'<p role="status" class="geapa-board-notice">Há mais de um registro para este cargo. Todos estão preservados abaixo; a interface não escolhe um ocupante por conta própria.</p>':''}${!slot.offices.length?detailSection('Situação do cargo','<p>Sem ocupante informado pelo Core nesta consulta. Essa ausência, por si só, não comprova vacância formal ou nomeação pendente.</p>'):slot.offices.map(o=>`<section class="geapa-board-occupant"><p class="geapa-board-person">${esc(o.name||'Nome não informado')}</p>${detailFacts([['Cargo',slot.key==='DIRETOR_FINANCEIRO'?'Diretor Financeiro':slot.label],['Gestão',o.boardId||'Não informada'],['Início',date(o.startDate)],['Término previsto documentado',date(o.endDate)]])}${o.tenure?tenureSegments(o.tenure):''}${detailSection('Atribuições institucionais',`<p>${esc(o.duties.summary)}</p><p class="geapa-board-source">${esc(o.duties.source)}</p>`)}${detailSection('Permissões técnicas do Portal',permissionGroups(o.permissions))}${detailSection('Observações documentais',`${o.duties.verified?'<p>A síntese acima possui referência documental vinculada pelo Core.</p>':'<p>Documento específico pendente de vinculação. Não é possível deduzir atribuições institucionais apenas pelas permissões técnicas.</p>'}${slot.key==='DIRETOR_FINANCEIRO'&&o.roleKey==='TESOUREIRO'?'<p>Diretoria Financeira é o rótulo de exibição. O registro canônico permanece TESOUREIRO, sem renomeação institucional.</p>':''}<p>Vínculo, função vigente, recurso, estado e precondições são revalidados em cada operação.</p>`)}</section>`).join('')}</section>`;
}
type PortalWindow=Window&{PortalGeapaApi?:{apiGet:(route:string,params:Record<string,never>)=>Promise<{ok:boolean;data:BoardCompetencies;message?:string}>};PortalGeapaNavigation?:{getRotaAtual:()=>string}};
let selectedTab:'offices'|'history'='offices';
let generation=0,timer:ReturnType<typeof setTimeout>|undefined,current:BoardCompetencies|undefined,dialog:HTMLElement|undefined;
function closeDialog(){if(dialog)closeDetailDialog(dialog,true);dialog=undefined;}
function clear(){current=undefined;closeDialog();clearTimeout(timer);}
function expired(el:HTMLElement){clear();el.innerHTML=header('Diretoria e competências','Atualize para revalidar os vínculos e as permissões.','<button type="button" data-board-refresh>Atualizar consulta</button>');}
function showDetails(index:number){const el=document.getElementById('placeholder-content');if(!current||!el)return;if(current.validUntil<=Date.now()){expired(el);return;}const html=renderBoardOfficeDetail(current,index);if(!html)return;closeDialog();const modal=document.createElement('div');modal.className='modal-backdrop geapa-board-modal';modal.hidden=true;modal.innerHTML=html;document.body.append(modal);dialog=modal;openDetailDialog(modal,()=>{modal.remove();if(dialog===modal)dialog=undefined;});}
async function load(){const w=window as PortalWindow,el=document.getElementById('placeholder-content');if(!el||w.PortalGeapaNavigation?.getRotaAtual()!=='diretoria-competencias')return;const epoch=++generation;clear();el.classList.add('geapa-admin');el.textContent='Consultando a Diretoria e suas autorizações…';
 try{const r=await w.PortalGeapaApi?.apiGet('/admin/diretoria-competencias',{});if(epoch!==generation||!el.isConnected)return;if(!r?.ok)throw Error(r?.message||'Não foi possível consultar a Diretoria.');if(r.data.schemaVersion!=='board-competencies-v1'||r.data.validUntil<=Date.now())throw Error('A autorização da consulta expirou. Atualize para consultar novamente.');current=r.data;el.innerHTML=renderBoardCompetencies(r.data,selectedTab);timer=setTimeout(()=>{if(epoch===generation)expired(el);},r.data.validUntil-Date.now());}
 catch(e){if(epoch===generation){clear();el.replaceChildren();const p=document.createElement('p');p.setAttribute('role','alert');p.textContent=e instanceof Error?e.message:'Consulta indisponível.';const b=document.createElement('button');b.type='button';b.dataset.boardRefresh='';b.textContent='Atualizar consulta';el.append(p,b);}}
}
if(typeof document!=='undefined'){
 document.addEventListener('portal:navigationchange',e=>{generation++;clear();if((e as CustomEvent).detail?.rota?.id==='diretoria-competencias')void load();});
 document.addEventListener('click',e=>{if(!(e.target instanceof Element)||e.defaultPrevented||e.button!==0||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;const tab=e.target.closest<HTMLElement>('[data-board-tab]');if(tab&&current){selectedTab=tab.dataset.boardTab==='history'?'history':'offices';const el=document.getElementById('placeholder-content');if(el){if(current.validUntil<=Date.now()){expired(el);return;}el.innerHTML=renderBoardCompetencies(current,selectedTab);el.querySelector<HTMLElement>('[data-board-tab="'+selectedTab+'"]')?.focus();}return;}const hb=e.target.closest<HTMLElement>('[data-board-history-detail]'),hc=e.target.closest<HTMLElement>('[data-board-history-card]');if(hc&&current&&(hb||!e.target.closest('button,a,input,select,summary'))){if(current.validUntil<=Date.now())return;const b=current.history?.records.find(b=>b.id===hc.dataset.boardHistoryCard);if(b){closeDialog();const m=document.createElement('div');m.className='modal-backdrop';m.hidden=true;m.innerHTML=boardHistoryDetail(b);document.body.append(m);dialog=m;openDetailDialog(m,()=>{m.remove();if(dialog===m)dialog=undefined;});}return;}if(e.target.closest('[data-board-refresh]')){void load();return;}const button=e.target.closest<HTMLElement>('[data-board-detail]'),card=e.target.closest<HTMLElement>('[data-board-office]');if(!card?.closest('#placeholder-content')||(!button&&(e.target.closest('button,a,input,select,summary')||window.getSelection()?.toString())))return;const value=button?.dataset.boardDetail??card.dataset.boardOffice;if(value!==undefined&&/^\d+$/.test(value)){if(!button)card.querySelector<HTMLElement>('[data-board-detail]')?.focus();showDetails(Number(value));}});
 document.addEventListener('portal:act-session-cleared',()=>{generation++;clear();if((window as PortalWindow).PortalGeapaNavigation?.getRotaAtual()==='diretoria-competencias')document.getElementById('placeholder-content')?.replaceChildren();});
}
