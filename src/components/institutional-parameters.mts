import {esc,header,badge,detailFacts,detailSection} from './design-system.mjs';
export type Parameter={id:string;title:string;description:string;module:string;type:string;documentaryValue:string;value:boolean|null;revision:number;mode:'DIRECT'|'AWARENESS'|'APPROVAL'|null;limits:string;consumer:string;actions:Record<string,boolean>;history:{at:number;action:string;reason:string;actorPersonId:string;revisionAfter:number;operationId:string}[];proposals?:Proposal[];competentRoles?:string[];updatedAt:number|null};
type Proposal={id:string;revision:number;state:string;value:boolean;reason:string;proposerPersonId:string;expiresAt:number;actions:string[]};
const values=(v:boolean|null)=>v===null?'Não integrado':v?'SIM':'NAO';
const mode=(v:Parameter['mode'])=>v==='DIRECT'?'Alteração direta':v==='AWARENESS'?'Ciência de outro responsável':v==='APPROVAL'?'Aprovação por outro responsável':'Competência pendente';
const actionLabel:Record<string,string>={PROPOSE:'Propor alteração',ACKNOWLEDGE:'Registrar ciência',APPROVE:'Aprovar proposta',REJECT:'Rejeitar proposta',ACTIVATE:'Ativar proposta'};
export function parameterCards(items:{parameter:Parameter;status:string}[],query='',kind='',filters:{type?:string;status?:string;competence?:string}={}):string{
 const rows=items.map((r,i)=>({...r,index:i})).filter(r=>(!filters.type||r.parameter.type===filters.type)&&(!filters.status||r.status===filters.status)&&(!filters.competence||r.parameter.competentRoles?.includes(filters.competence)));
 const select=(name:string,label:string,values:[string,string][],selected='')=>'<label>'+label+'<select name="'+name+'"><option value="">Todos</option>'+values.map(([v,l])=>'<option value="'+esc(v)+'" '+(selected===v?'selected':'')+'>'+esc(l)+'</option>').join('')+'</select></label>';

 return header('Parâmetros operacionais','Configurações administrativas. Exigências normativas permanecem nos instrumentos de origem.','<button type="button" data-institutional-refresh>Atualizar</button><button type="button" data-institutional-recover>Consultar último envio</button>')+
 '<p class="geapa-board-notice">A consulta não concede edição. Ciência registra conhecimento e não substitui uma aprovação institucional. Segurança e autenticação não são editáveis nesta página.</p>'+
 `<form data-institutional-search class="institutional-search"><label>Buscar<input name="query" type="search" maxlength="80" value="${esc(query)}"></label><label>Módulo<select name="kind"><option value="">Todos</option><option ${kind==='Atividades'?'selected':''}>Atividades</option></select></label>${select('parameterType','Tipo',[['BOOLEAN','SIM / NAO'],['INTEGER','Número inteiro']],filters.type)}${select('parameterStatus','Situação',[['INTEGRATED','Integrado'],['NOT_INTEGRATED','Não integrado']],filters.status)}${select('parameterCompetence','Competência',[...new Set(items.flatMap(r=>r.parameter.competentRoles||[]))].map(r=>[r,r==='PRESIDENTE'?'Presidência':r==='DIRETOR_ADMINISTRATIVO'?'Administração':r] as [string,string]),filters.competence)}<button type="submit">Buscar</button></form><p role="status">${rows.length} configurações na consulta</p><div class="geapa-record-grid">`+
 rows.map(({parameter:p,status,index:i})=>`<article class="geapa-record" data-institutional-card="${i}"><header class="geapa-record-head"><h3>${esc(p.title)}</h3>${badge(status==='INTEGRATED'?'Integrado':'Edição indisponível',status!=='INTEGRATED')}</header><p class="geapa-eyebrow">${esc(p.id)}</p><p>${esc(p.description)}</p>${detailFacts([['Valor efetivo',values(p.value)],['Módulo',p.module],['Controle',mode(p.mode)],['Competência',(p.competentRoles||[]).map(r=>r==='PRESIDENTE'?'Presidência':r==='DIRETOR_ADMINISTRATIVO'?'Administração':r).join(' · ')||'Aguardando definição']])}<footer class="geapa-record-foot"><span>${p.revision?'Revisão '+p.revision:'Aguardando integração'}</span><button type="button" data-institutional-detail="${i}" aria-haspopup="dialog">Ver detalhes</button></footer></article>`).join('')+'</div>';
}
export function parameterDetail(p:Parameter):string{
 return detailSection('Configuração operacional',detailFacts([['Valor documental',p.documentaryValue],['Valor efetivo',values(p.value)],['Tipo',p.type],['Controle de alteração',mode(p.mode)],['Revisão',String(p.revision)],['Limites',p.limits],['Consumidor',p.consumer]]))+
 (p.actions.PROPOSE?'<button type="button" data-parameter-action="PROPOSE">Propor alteração</button>':'<p role="note">🔒 Edição indisponível neste escopo. Consulte <a href="#/admin/perfis-permissoes">Perfis e permissões</a>.</p>')+
 (p.proposals?.length?detailSection('Propostas recentes',p.proposals.map(q=>`<article><h3>${esc(q.state)} · ${values(q.value)}</h3><p>${esc(q.reason)}</p><p>Responsável: ${esc(q.proposerPersonId)} · revisão ${q.revision}</p>${q.actions.map(action=>`<button type="button" data-parameter-action="${action}" data-parameter-proposal="${esc(q.id)}">${esc(actionLabel[action])}</button>`).join('')}</article>`).join('')):'')+
 detailSection('Histórico',p.history.length?p.history.map(h=>`<p>${esc(new Date(h.at).toLocaleString('pt-BR'))} · ${esc(h.action)} · ${esc(h.actorPersonId)} · revisão ${h.revisionAfter}</p><p>${esc(h.reason)}</p><small>Recibo ${esc(h.operationId)}</small>`).join(''):'<p>Nenhuma alteração registrada neste parâmetro.</p>');
}
export function parameterForm(p:Parameter,action:string,proposalId=''):string{
 const proposal=p.proposals?.find(q=>q.id===proposalId);
 return `<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="parameter-title"><header class="modal-topbar"><h2 id="parameter-title">${esc(actionLabel[action])}: ${esc(p.title)}</h2><button type="button" data-admin-modal-close aria-label="Fechar">×</button></header><p>Valor atual: ${values(p.value)} · revisão ${p.revision}</p><p>${esc(mode(p.mode))}. A mudança afeta somente o destaque visual, sem remover atividades.</p><form data-parameter-form data-action="${esc(action)}" data-proposal="${esc(proposalId)}" data-proposal-revision="${proposal?.revision||0}"><label>Valor proposto<select name="value" ${action!=='PROPOSE'?'disabled':''}><option value="true" ${(proposal?.value??!p.value)?'selected':''}>SIM</option><option value="false" ${(proposal?.value??!p.value)?'':'selected'}>NAO</option></select></label><label>Justificativa<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label><div data-institutional-edit-feedback role="status" aria-live="polite"></div><button type="submit">Revisar operação</button></form></section>`;
}
export function parameterEvidenceDetail(v:any):string{
 return detailSection('Valor normativo e integração',detailFacts([['Valor documental',v.documentedValue||'Não informado'],['Valor efetivo',v.effectiveValue??'Não comprovado nesta consulta'],['Unidade',v.unit],['Dispositivo',v.basis||'Sem fundamento explícito'],['Revisão canônica',String(v.effectiveRevision??'Não identificada')],['Integração',v.integration],['Consumidores',(v.consumers||[]).join(' · ')]]))+
 '<p>Alterações normativas exigem deliberação, comprovação de vigência, avaliação de impacto e ativação separada. Nenhum editor livre está habilitado.</p>'+(v.conflicts||[]).map((s:string)=>`<p role="note">${esc(s)}</p>`).join('')+'<p>Histórico de alterações efetivas não consolidado nesta consulta; a proveniência documental permanece disponível.</p>';
}
