import {esc,header,badge,fact,card,openDetailDialog,closeDetailDialog} from './design-system.mjs';
type Row=Record<string,any>;
type Host=Window&{PortalGeapaApi:{apiGet:(r:string,p?:Row)=>Promise<Row>;apiPost:(r:string,p?:Row)=>Promise<Row>};PortalGeapaNavigation?:{getRotaAtual:()=>string};PortalRH?:{cycleId:string;sections:(active:string)=>string;selectCycle:(id:string)=>void}};
const tabs=[['overview','Visão geral'],['members','Membros'],['justifications','Justificativas'],['actions','Providências'],['history','Histórico']];
let cycleId='',section='overview',generation=0,data:Row|undefined,caseData:Row|undefined,detailGeneration=0,activeDialog:HTMLElement|undefined;
let memberFilter='',cursor:Row|undefined,pageHistory:(Row|undefined)[]=[];
let caseCursor:Row|undefined,casePages:(Row|undefined)[]=[];
const actionLabels:Row={INFORMAL_WARNING:'Advertência informal',FORMAL_WARNING:'Advertência formal',COMMUNICATION:'Comunicação realizada',FOLLOW_UP:'Acompanhamento',MANIFESTATION:'Manifestação recebida',CLOSE:'Encerrar acompanhamento',DISMISS:'Efetivar desligamento homologado'};
const date=(v:string)=>v?new Date(v).toLocaleString('pt-BR',{timeZone:'America/Cuiaba'}):'Não informado';
function caseHistory(d:Row):string{return `<article class="geapa-record geapa-detail-section"><h3>${esc(d.personId)} · ${esc(d.cycleId)}</h3>${badge(({OPEN:'Em acompanhamento',CLOSED:'Encerrado',DISMISSED:'Desligamento homologado'} as Row)[d.state]||d.state)}${d.manifestationEndsAtExclusive?`<p>Prazo de manifestação até ${esc(date(new Date(Date.parse(d.manifestationEndsAtExclusive)-1).toISOString()))}.</p>`:''}${d.history.map((h:Row)=>`<section><h4>${esc(actionLabels[h.action]||h.action)}</h4><dl class="geapa-detail-facts">${fact('Ocorrência',h.occurrenceDate)+fact('Lançamento',date(h.recordedAt))+fact('Decisão',h.decisionRef)+fact('Documento',h.documentReference||'Não informado')}</dl><p>${esc(h.reason)}</p></section>`).join('')}</article>`;}
const host=()=>window as unknown as Host;
export function sections(active:string):string{return `<nav class="geapa-module-tabs" aria-label="Seções de Frequência e RH">${tabs.map(([id,label])=>`<button type="button" data-rh-section="${id}" aria-pressed="${id===active}"${id===active?' aria-current="page"':''}>${label}</button>`).join('')}</nav>`;}
const value=(v:unknown)=>v===null||v===undefined?'Não apurado':String(v);
export function defaultCycle(cycles:Row[],today=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Cuiaba',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())):string{const current=cycles.filter(c=>c.status==='OPEN'&&c.civilStart<=today&&today<=c.civilEnd);if(current.length===1)return current[0]!.id;const open=cycles.filter(c=>c.status==='OPEN');return open.length===1?open[0]!.id:'';}
const status=(s:string)=>({DEFINITIVE:'Definitiva',PROVISIONAL:'Provisória',INCOMPLETE:'Incompleta'}[s]||s);
function member(m:Row):string{return card({id:m.personId,title:m.label,titleAttribute:'data-rh-person',statusHtml:badge(status(m.integrity)),factsHtml:fact('Presenças',m.summary.totalPresencas)+fact('Faltas líquidas',value(m.summary.faltasLiquidas))+fact('Justificadas / abonadas',`${m.summary.totalJustificadas} / ${m.summary.totalAbonadas}`)+fact('Frequência',m.summary.percentualFrequencia===null?'Não apurada':m.summary.percentualFrequencia+'%')+m.periods.map((p:Row)=>fact('Limite de faltas',value(p.absenceLimit))+fact('Frequência mínima',p.minimumAttendanceBasisPoints===null?'Não estabelecida':p.minimumAttendanceBasisPoints/100+'%')+fact('Planejamento original',value(p.plannedActivities))).join(''),footerHtml:'<button type="button" data-rh-person="'+esc(m.personId)+'">Consultar frequência individual</button>'});}
function regularization(d:Row):string{const activities=d.activities||[],original=activities.filter((a:Row)=>a.status==='NOT_OCCURRED'&&!a.replacedById&&!a.replacementOfId),replacement=activities.filter((a:Row)=>a.status==='OCCURRED'&&!a.replacementOfId&&!a.replacedById),options=(rows:Row[])=>rows.map(a=>`<option value="${esc(a.id)}">${esc(a.civilDate)} · ${esc(a.title)}</option>`).join('');return `<section class="geapa-detail-section"><h2>Regularização de atividades</h2><p>Registre a atividade efetivamente realizada em Atividades, usando o modelo aprovado e os horários documentados. Depois reconheça sua ocorrência e confira a chamada real. O lançamento posterior preserva a data da ocorrência.</p><a href="#/admin/atividades">Abrir administração de atividades</a>${d.canReplace&&original.length&&replacement.length?`<form data-rh-replacement><h3>Vincular atividade substitutiva</h3><label>Atividade que não ocorreu<select name="original" required><option value="">Selecione</option>${options(original)}</select></label><label>Atividade realizada em seu lugar<select name="replacement" required><option value="">Selecione</option>${options(replacement)}</select></label><label>Fundamento documental<textarea name="reason" minlength="10" maxlength="2000" required></textarea></label><p>As duas atividades devem pertencer a este ciclo e ter ocorrência reconhecida na mesma data. O vínculo preserva o planejamento original e não cria registros de presença ou falta.</p><p data-rh-replacement-feedback role="status"></p><button type="submit">Registrar substituição</button></form>`:'<p>O vínculo de substituição fica disponível após o reconhecimento das duas ocorrências e a conferência da autorização administrativa.</p>'}${activities.filter((a:Row)=>a.replacementOfId).map((a:Row)=>`<p>${esc(a.title)} substitui ${esc(a.replacementOfId)} · ocorrência ${esc(a.civilDate)} · lançamento ${esc(date(a.recordedAt))}</p>`).join('')}</section>`;}
export function content(d:Row,selected:string):string{
 const members=d.members||[];
 if(selected==='members')return `<div class="geapa-record-grid">${members.map(member).join('')}</div>`;
 if(selected==='actions')return `<p>Atingir um limite sinaliza necessidade de análise. Qualquer sanção exige decisão competente e direito de manifestação.</p><p role="status">${esc(caseData?.notice||'')}</p><div class="geapa-record-grid">${members.map((m:Row)=>card({id:m.personId,title:m.label,titleAttribute:'data-rh-case',statusHtml:badge(m.periods.some((p:Row)=>p.atLimit)?'Limite atingido':'Acompanhamento'),factsHtml:fact('Faltas líquidas',value(m.summary.faltasLiquidas))+fact('Integridade',status(m.integrity))+m.periods.map((p:Row)=>p.discipline?fact('Sinalização informal',value(p.discipline.informalWarningAt)+' faltas')+fact('Sinalização formal',value(p.discipline.formalWarningAt)+' faltas')+fact('Manifestação',p.discipline.manifestationDays+' dias'):fact('Política de providências','Não reconhecida neste ciclo')).join(''),footerHtml:`<button type="button" data-rh-case="${esc(m.personId)}">Consultar providências</button>`})).join('')}</div>`;
 if(selected==='history')return `<p>Providências do ciclo selecionado. Na consulta individual, os eventos institucionais de vínculo aparecem em uma área separada.</p><p role="status">${esc(caseData?.notice||'')}</p>${caseData?.items?.map(caseHistory).join('')||'<p>Nenhuma providência disponível para esta consulta.</p>'}`;
 return `<section aria-label="Integridade da apuração">${badge(status(d.integrity))}<p>${esc(d.notice)}</p><dl class="geapa-detail-facts">${fact('Ciclo',d.cycle.label)+fact('Participantes nesta página',members.length)+fact('Chamadas pendentes de conferência',d.missingAttendanceActivityIds.length)}</dl></section><p>Consulte os limites e a frequência de cada pessoa em Membros. Justificativas pendentes podem alterar a apuração.</p>${regularization(d)}`;
}
function paint(){const el=document.getElementById('placeholder-content');if(!el||!data)return;el.classList.add('geapa-admin','geapa-rh');el.classList.remove('geapa-act-workspace');const pager=section==='history'?caseData?.pagination:data.pagination,previous=section==='history'?casePages.length:pageHistory.length;el.innerHTML=header('Frequência e RH','Apuração e acompanhamento administrativo por ciclo.')+`<label>Ciclo institucional<select data-rh-cycle>${data.cycles.map((c:Row)=>`<option value="${esc(c.id)}"${c.id===cycleId?' selected':''}>${esc(c.label)}</option>`).join('')}</select></label>`+sections(section)+`<form data-rh-filter class="geapa-search-row"><label>Filtrar por ID da pessoa<input type="search" name="personId" value="${esc(memberFilter)}" placeholder="Ex.: PES-000001" maxlength="48" pattern="[A-Za-z0-9_-]+"></label><div class="geapa-results"><button type="submit">Consultar</button><button type="button" data-rh-clear-filter>Todos os membros</button></div></form><p>Apuração das pessoas desta página, exclusivamente no ciclo selecionado.</p><section aria-live="polite">${content(data,section)}</section><nav class="geapa-module-tabs" aria-label="Páginas de membros"><button type="button" data-rh-prev${previous?'':' disabled'}>Página anterior</button><button type="button" data-rh-next${pager?.hasMore?'':' disabled'}>Próxima página</button></nav>`;}
async function load(){const token=++generation,el=document.getElementById('placeholder-content');if(!el)return;el.textContent='Carregando frequência do ciclo…';try{
 if(!cycleId){const r=await host().PortalGeapaApi.apiGet('/admin/ciclos-semestres',{});if(!r.ok)throw Error(r.message||'Consulta de ciclos indisponível.');const cycles=r.data.cycles||r.data.ciclos||[],preferred=defaultCycle(cycles);if(preferred)cycleId=preferred;else{if(token!==generation)return;el.innerHTML=header('Frequência e RH','Selecione um ciclo institucional.')+`<label>Ciclo institucional<select data-rh-cycle><option value="">Selecione</option>${cycles.map((c:Row)=>`<option value="${esc(c.id)}">${esc(c.label||c.cycleLabel||c.id)}</option>`).join('')}</select></label>`;return;}}
 const selected=cycleId,r=await host().PortalGeapaApi.apiGet('/admin/frequencia-rh',{cycleId:selected,...(memberFilter?{personId:memberFilter}:cursor?{cursor}:{})});if(token!==generation||selected!==cycleId)return;if(!r.ok)throw Error(r.message||'Não foi possível apurar a frequência.');if(r.data.cycle.id!==selected)throw Error('A resposta não corresponde ao ciclo selecionado.');data=r.data;paint();if(['actions','history'].includes(section))await loadCases(token,selected);
 }catch(e){if(token===generation)el.innerHTML=header('Frequência e RH','Consulta indisponível.')+`<p role="alert">${esc((e as Error).message)}</p><button type="button" data-rh-retry>Atualizar consulta</button>`;}}
async function loadCases(token=generation,selected=cycleId){try{const r=await host().PortalGeapaApi.apiGet('/admin/frequencia-rh/providencias',{cycleId:selected,...(memberFilter?{personId:memberFilter}:caseCursor?{cursor:caseCursor}:{})});if(token!==generation||selected!==cycleId)return;caseData=r.ok&&r.data.cycleId===selected?r.data:{notice:r.message||'Consulta de providências indisponível.'};paint();}catch{if(token===generation){caseData={notice:'Não foi possível consultar as providências. Atualize a consulta.'};paint();}}}
function selectCycle(id:string){if(host().PortalGeapaNavigation?.getRotaAtual()==='admin-frequencia-rh')document.getElementById('placeholder-content')?.replaceChildren();cycleId=id;cursor=undefined;pageHistory=[];caseCursor=undefined;casePages=[];memberFilter='';data=undefined;caseData=undefined;generation++;detailGeneration++;if(activeDialog)closeDetailDialog(activeDialog);if(host().PortalRH)host().PortalRH!.cycleId=id;}
async function openCase(personId:string){const token=++detailGeneration,selected=cycleId;try{const r=await host().PortalGeapaApi.apiGet('/admin/frequencia-rh/providencias',{cycleId:selected,personId});if(token!==detailGeneration||selected!==cycleId)return;if(!r.ok)throw Error(r.message||'Consulta de providências indisponível.');const d=r.data;if(d.cycleId!==selected)throw Error('Ciclo da resposta divergente.');const c=d.items[0],dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;activeDialog=dialog;
 dialog.innerHTML=`<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="rh-case-title"><header class="modal-topbar"><h2 id="rh-case-title">Providências de frequência</h2><button type="button" data-admin-modal-close>Fechar</button></header><p>${esc(data?.members.find((m:Row)=>m.personId===personId)?.label||personId)} · ${esc(selected)}</p><p>${esc(d.notice)}</p>${c?caseHistory(c):'<p>Nenhuma providência registrada neste ciclo.</p>'}${d.canRecord&&d.allowedActions?.length?`<form data-rh-case-form><h3>Registrar providência</h3><label>Vínculo<select name="linkId" required>${d.person.links.map((l:Row)=>`<option value="${esc(l.id)}"${c?.linkId===l.id?' selected':''}>${esc(l.type)} · ${esc(l.startDate)}</option>`).join('')}</select></label><label>Providência<select name="action" required>${(d.allowedActions||[]).map((a:string)=>`<option value="${esc(a)}">${esc(actionLabels[a])}</option>`).join('')}</select></label><label>Data de ocorrência ou efeito<input name="occurrenceDate" type="date" required></label><label>Fundamento e registro da análise<textarea name="reason" minlength="10" maxlength="2000" required></textarea></label><details data-rh-document><summary>Documento ou ata de apoio</summary><label>Referência do documento ou ata<input name="documentReference" maxlength="800"></label><p data-rh-document-note></p></details><label>Identificação da decisão<input name="decisionReference" maxlength="48" pattern="[A-Za-z0-9_-]+" required></label><label class="geapa-check-row"><input name="confirmed" type="checkbox" required>Confirmo que a providência e sua documentação correspondem à decisão competente.</label><p>A comunicação deve ter sido realizada pelo canal institucional. Este registro não envia mensagens.</p><p data-rh-feedback role="status"></p><button type="submit">Registrar providência</button></form>`:''}<details><summary>Histórico institucional permanente do vínculo</summary><p>Eventos independentes da apuração deste ciclo.</p>${d.institutionalHistory.map((e:Row)=>`<p>${esc(e.effect)} · ${esc(e.effectiveDate)} · ${esc(e.id)}</p>`).join('')||'<p>Nenhum evento disponível.</p>'}</details></section>`;
 document.body.append(dialog);if(dialog.querySelector('form'))dialog.setAttribute('data-geapa-protect-draft','');const syncDocument=()=>{const action=dialog.querySelector<HTMLSelectElement>('[name=action]')?.value,required=['FORMAL_WARNING','COMMUNICATION','DISMISS'].includes(action||''),details=dialog.querySelector<HTMLDetailsElement>('[data-rh-document]'),input=dialog.querySelector<HTMLInputElement>('[name=documentReference]'),note=dialog.querySelector('[data-rh-document-note]');if(input)input.required=required;if(details)details.open=required||!!input?.value;if(note)note.textContent=required?'Documento obrigatório para esta providência.':'Referência opcional para complementar o registro.';};dialog.querySelector('[name=action]')?.addEventListener('change',syncDocument);syncDocument();openDetailDialog(dialog,()=>{detailGeneration++;dialog.remove();if(activeDialog===dialog)activeDialog=undefined;});
 dialog.querySelector('form')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement,fd=new FormData(form),button=form.querySelector('button[type="submit"]') as HTMLButtonElement,feedback=form.querySelector('[data-rh-feedback]') as HTMLElement;if(dialog.getAttribute('aria-busy')==='true')return;dialog.setAttribute('aria-busy','true');button.disabled=true;feedback.textContent='Conferindo e registrando…';try{const result=await host().PortalGeapaApi.apiPost('/admin/frequencia-rh/providencia',{personId,cycleId:selected,personRevision:d.person.revision,caseRevision:c?.revision||0,...Object.fromEntries(['linkId','action','occurrenceDate','reason','documentReference','decisionReference'].map(k=>[k,String(fd.get(k)||'')])),confirmed:fd.get('confirmed')==='on'});if(token!==detailGeneration||selected!==cycleId)return;if(!result.ok)throw Error(result.message||'Registro não confirmado.');dialog.removeAttribute('data-geapa-dirty');feedback.textContent='Providência registrada. Atualize a consulta para conferir o histórico.';form.querySelectorAll('input,select,textarea').forEach(el=>(el as HTMLInputElement).disabled=true);data=undefined;caseData=undefined;void load();}catch(error){feedback.textContent=(error as Error).message;button.disabled=false;}finally{dialog.removeAttribute('aria-busy');}});
 }catch(error){if(token===detailGeneration){caseData={notice:(error as Error).message};paint();}}}
if(typeof window!=='undefined'){
 host().PortalRH={cycleId,sections,selectCycle};
 document.addEventListener('portal:navigationchange',()=>{if(host().PortalGeapaNavigation?.getRotaAtual()!=='admin-frequencia-rh')document.getElementById('placeholder-content')?.classList.remove('geapa-rh');generation++;detailGeneration++;if(activeDialog)closeDetailDialog(activeDialog);if(host().PortalGeapaNavigation?.getRotaAtual()==='admin-frequencia-rh')void load();});
 document.addEventListener('portal:act-session-cleared',()=>{selectCycle('');section='overview';});
 document.addEventListener('portal:justificativas-atualizadas',()=>{data=undefined;if(host().PortalGeapaNavigation?.getRotaAtual()==='admin-frequencia-rh')void load();});
 document.addEventListener('change',e=>{const t=e.target as HTMLSelectElement;if(t.matches('[data-rh-cycle]')){selectCycle(t.value);void load();}});
 document.addEventListener('submit',e=>{const form=e.target as HTMLFormElement;if(!form.matches('[data-rh-filter]'))return;e.preventDefault();memberFilter=String(new FormData(form).get('personId')||'').trim();cursor=undefined;pageHistory=[];caseCursor=undefined;casePages=[];caseData=undefined;void load();});
 document.addEventListener('submit',async e=>{const form=e.target as HTMLFormElement;if(!form.matches('[data-rh-replacement]'))return;e.preventDefault();const fd=new FormData(form),token=generation,selected=cycleId,original=data?.activities.find((a:Row)=>a.id===fd.get('original')),replacement=data?.activities.find((a:Row)=>a.id===fd.get('replacement')),feedback=form.querySelector('[data-rh-replacement-feedback]') as HTMLElement,button=form.querySelector('button[type="submit"]') as HTMLButtonElement;if(!original||!replacement)return;button.disabled=true;feedback.textContent='Conferindo substituição…';try{const r=await host().PortalGeapaApi.apiPost('/admin/atividades/substituicao',{payload:JSON.stringify({activityId:original.id,activityRevision:original.revision,replacementId:replacement.id,replacementRevision:replacement.revision,reason:String(fd.get('reason')||'')})});if(token!==generation||selected!==cycleId)return;if(!r.ok)throw Error(r.message||'Substituição não confirmada.');feedback.textContent='Substituição registrada. O planejamento e os fatos anteriores foram preservados.';form.querySelectorAll('input,select,textarea').forEach(el=>(el as HTMLInputElement).disabled=true);}catch(error){if(token===generation){feedback.textContent=(error as Error).message;button.disabled=false;}}});
 document.addEventListener('click',e=>{const t=e.target instanceof Element?e.target.closest<HTMLElement>('[data-rh-section],[data-rh-person],[data-rh-case],[data-rh-retry],[data-rh-next],[data-rh-prev],[data-rh-clear-filter]'):null;if(!t)return;
 if(t.hasAttribute('data-rh-next')&&section==='history'&&caseData?.pagination?.nextCursor){casePages.push(caseCursor);caseCursor=caseData.pagination.nextCursor;void loadCases();return;}if(t.hasAttribute('data-rh-next')&&data?.pagination?.nextCursor){pageHistory.push(cursor);cursor=data.pagination.nextCursor;void load();return;}
 if(t.hasAttribute('data-rh-prev')&&section==='history'&&casePages.length){caseCursor=casePages.pop();void loadCases();return;}if(t.hasAttribute('data-rh-prev')&&pageHistory.length){cursor=pageHistory.pop();void load();return;}
 if(t.hasAttribute('data-rh-clear-filter')){memberFilter='';cursor=undefined;pageHistory=[];caseCursor=undefined;casePages=[];void load();return;}
 if(t.dataset.rhCase){void openCase(t.dataset.rhCase);return;}
 if(t.hasAttribute('data-rh-retry')){void load();return;}
 if(t.dataset.rhSection){section=t.dataset.rhSection;if(section==='justifications'){host().PortalRH!.cycleId=cycleId;window.location.hash='/admin/justificativas';return;}if(host().PortalGeapaNavigation?.getRotaAtual()!=='admin-frequencia-rh'){window.location.hash='/admin/frequencia-rh';return;}paint();if(['actions','history'].includes(section))void loadCases();return;}
 const m=data?.members.find((v:Row)=>v.personId===t.dataset.rhPerson);if(!m)return;const dialog=document.createElement('div');dialog.className='modal-backdrop';dialog.hidden=true;activeDialog=dialog;dialog.innerHTML=`<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="rh-member-title"><header class="modal-topbar"><h2 id="rh-member-title">${esc(m.label)}</h2><button type="button" data-admin-modal-close>Fechar</button></header><p>${esc(data!.cycle.label)} · ${esc(status(m.integrity))}</p><dl class="geapa-detail-facts">${m.records.map((r:Row)=>fact(`${r.civilDate||'Data não comprovada'} · ${r.title}`,r.label)).join('')}</dl></section>`;document.body.append(dialog);openDetailDialog(dialog,()=>{dialog.remove();if(activeDialog===dialog)activeDialog=undefined;});
 });
}
