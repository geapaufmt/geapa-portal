import {filesDetail,mountFileDownloads,type DocumentFile} from './institutional-document-files.mjs';
import {esc,badge,detailFacts,detailSection,openDetailDialog,closeDetailDialog} from './design-system.mjs';
export type ProcedureContext={type:string;personId?:string;functionId?:string;boardId:string};
let pendingContext:ProcedureContext|undefined;
export function queueProcedureContext(value:ProcedureContext):void{pendingContext={...value};}
if(typeof document!=='undefined')document.addEventListener('portal:act-session-cleared',()=>{pendingContext=undefined;});
type Person={personId:string;name:string;eligible:boolean;links:{id:string;type:string}[];functions:{id:string;roleKey:string;boardId:string;group:string}[]};
type DocumentReference={recordId:string;revision:number;sha256:string};
type Procedure={exception?:{kind:string;articles:string[];individualGrounds:string};notice?:{availableAt:number;recipientPersonId:string;receivedAt:number|null;defenseUntil:number;access?:{at:number}|null;acknowledgment?:{at:number}|null;externalEvidence?:{recordedAt:number}|null};documents?:DocumentReference[];type:string;boardId:string;state:string;title:string;object:string;basis:string;reason:string;contentHash:string;contentVersion:number;proposer:string;createdAt:number;openedAt:number|null;deadline:number|null;closedAt:number|null;target:Record<string,string|number|boolean>;rule:string;electorate:{people:{personId:string;name:string;functions:{roleKey:string;linkId:string}[]}[]}|null;votes:{personId:string;choice:string;at:number;contentVersion:number;operationId:string}[];enactment:{state:string;blocks?:string[]};defense?:{statement:string;at:number}|null;consent?:{accepted:boolean;at:number}|null;clearance?:{pendingDuties:string}|null};
export type ProcedureRecord={attachments?:DocumentFile[];kind?:string;documentAvailable?:boolean;id:string;revision:number;title:string;procedure?:Procedure;actions?:string[]};
export type ProcedureCatalog={revision:number;records:ProcedureRecord[];boards:{id:string;name:string}[];procedureTypes?:{id:string;label:string;basis:string;rule:string;allowedDays?:number[]}[];procedurePeople?:Person[];procedureOptions?:{roles:{id:string;label:string}[];responsibleFunctions:{id:string;label:string;boardId:string;personId:string}[]}};
export function procedureContextAllowed(v:ProcedureCatalog,c:ProcedureContext):boolean{return !!v.procedureTypes?.some(t=>t.id===c.type)&&v.boards.some(b=>b.id===c.boardId)&&(!c.personId||!!v.procedurePeople?.some(p=>p.personId===c.personId&&(!c.functionId||p.functions.some(f=>f.id===c.functionId&&f.boardId===c.boardId))))&&(!c.functionId||!!c.personId);}
const stateLabels:Record<string,string>={AUTOMATIC_VALIDATION_PENDING:'Aguardando decisão definitiva e validação automática do Core',DRAFT:'Proposta em preparação',DEFENSE_PENDING:'Aguardando manifestação do interessado',CONSENT_PENDING:'Aguardando aceite',OPEN:'Em deliberação',APPROVED:'Aprovada',REJECTED:'Rejeitada',INSUFFICIENT_MANIFESTATIONS:'Manifestações insuficientes',SUSPENDED_COMPOSITION:'Suspensa: composição alterada',CANCELLED:'Cancelada',RECORDED:'Registrada',READY_FOR_ENACTMENT:'Pronta para conferência e efetivação',ENACTED:'Efetivada no cadastro canônico',NOT_ENACTED:'Não efetivada'};
const actionLabels:Record<string,string>={BP_ACCESS:'Registrar acesso ao conteúdo',BP_ACK:'Confirmar ciência, sem concordância',BP_NOTICE:'Registrar comunicação institucional',BP_ENACT:'Conferir e efetivar no cadastro',BP_OPEN:'Abrir deliberação',BP_VOTE:'Registrar voto',BP_CLOSE:'Concluir apuração',BP_CONSENT:'Responder à prorrogação',BP_DEFEND:'Registrar manifestação',BP_CLEARANCE:'Registrar quitação ou pendências',BP_CANCEL:'Cancelar procedimento'};
const blockLabels:Record<string,string>={DECISION_AFTER_FUNCTION_END:'O prazo da deliberação termina após a vigência atual. A votação e a função não serão prorrogadas automaticamente.',TARGET_FUNCTION_EXPIRED:'A função já terminou; o procedimento não pode reabrir o exercício.',M1_OCCUPATION_INVALID:'Os segmentos da ocupação apresentam uma inconsistência; nenhuma vigência foi alterada.',M1_GOVERNANCE_AMBIGUOUS:'Os semestres cadastrados não cobrem o período de forma única e contínua.',M1_GOVERNANCE_INTERVAL:'A associação dos semestres precisa ser conferida.',TERM_OUTSIDE_BOARD:'O período deve permanecer dentro do mandato da gestão.',EXTENSION_INVALID:'A nova data deve estender a ocupação vigente, sem reabrir um exercício encerrado.',CANONICAL_OCCUPATION_PROCEDURE_REQUIRED:'Use o procedimento de Diretoria para alterar a ocupação inteira.',COMPOSITION_CHANGED:'A composição ou revisão das funções mudou; a deliberação precisa ser conferida.',DEFENSE_PROCESS_BASIS_REQUIRED:'Falta fundamento válido para prosseguir sem manifestação do interessado.',NOTICE_EVIDENCE_UNVERIFIED:'A comunicação externa ainda não possui comprovação institucional validada.',ELECTRONIC_FORMALIZATION_REQUIRED:'Falta formalização institucional suficiente do procedimento eletrônico, que pode estar registrada em ata convencional.',MEETING_REQUIRED:'Este procedimento exige reunião específica; a votação assíncrona não a substitui.',M13_ACT_INVALID:'Base documental da efetivação ausente, vencida ou divergente.',TENURE_EVIDENCE_REQUIRED:'O histórico de períodos de exercício precisa de comprovação.',TENURE_LIMIT_EXCEEDED:'A duração proposta excede o limite de permanência aplicável.',FUNCTION_EXCLUSIVITY_CONFLICT:'Há outra função ou ocupante incompatível nesse intervalo.',REVISION_CONFLICT:'O cadastro mudou após a proposta; é necessária nova conferência documental.',PROCEDURE_NOT_APPROVED:'Procedimento ainda não aprovado ou registrado.',ELECTRONIC_PROCEDURE_NORMATIVE_ENABLEMENT_REQUIRED:'Falta fundamento institucional comprovado para a equivalência documental do rito eletrônico; não se exige automaticamente uma Norma Complementar.',ART33_SPECIFIC_EXCEPTION_REQUIRED:'É necessária exceção expressa e válida ao limite de permanência (art. 33, §5º).',COMMUNICATION_TO_EFFECTIVE_MEMBERS_REQUIRED:'A comunicação aos membros efetivos precisa ser comprovada.',CANONICAL_TENURE_REVALIDATION_REQUIRED:'Vigência e saldo de permanência precisam ser revalidados na efetivação.',CANONICAL_EFFECT_PREVIEW_REQUIRED:'A efetivação exige conferência atual das evidências, permissões, revisões e vigências.'};
const stamp=(n:number|null)=>n===null?'Não registrado':new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Cuiaba',dateStyle:'short',timeStyle:'short'}).format(new Date(n))+' (Cuiabá)';
const targetLabels:Record<string,string>={personId:'Pessoa',linkId:'Vínculo institucional',functionId:'Vigência da função',roleId:'Cargo canônico',roleName:'Denominação do cargo',purpose:'Finalidade',duties:'Atribuições',startDate:'Início',endDate:'Término proposto',advisoryAllowed:'Permite assessoria',responsibleFunctionId:'Diretor responsável',grounds:'Fundamentos e fatos',defenseDeadline:'Prazo de manifestação',reason:'Motivo'};
export function procedureRecoveryFeedback(message:string):string{
 return `<p>${esc(message)} Seu formulário permanece nesta aba. Consulte o resultado original antes de repetir.</p><button type="button" data-procedure-recover>Consultar resultado do envio</button>`;
}
export function procedureCards(v:ProcedureCatalog):string{
 const rows=v.records.filter(r=>r.kind==='BOARD_PROCEDURE'&&r.procedure);
 if(!rows.length&&!v.procedureTypes?.length)return '';
 return `<section data-board-procedures><h2>Procedimentos e deliberações eletrônicas</h2><p>Resultado e efetivação são etapas distintas. A aplicação depende da validação canônica e dos requisitos específicos do procedimento.</p>${v.procedureTypes?.length?'<button type="button" data-procedure-new>Novo procedimento</button>':''}<button type="button" data-procedure-recover class="secondary-button">Consultar último envio</button><div class="geapa-record-grid">${rows.map(r=>`<article class="geapa-record geapa-board-card geapa-board-history-card" data-procedure-card="${esc(r.id)}"><header class="geapa-record-head"><h3>${esc(r.title)}</h3>${badge(stateLabels[r.procedure!.state]||r.procedure!.state)}</header><p>${esc(r.procedure!.boardId)} · ${esc(stamp(r.procedure!.deadline))}</p><button type="button" data-procedure-detail="${esc(r.id)}" aria-haspopup="dialog">Consultar procedimento</button></article>`).join('')}</div><p role="status" data-procedure-result></p></section>`;
}
export function procedureDetail(r:ProcedureRecord,catalog?:ProcedureCatalog):string{
 const p=r.procedure;if(!p)return '';
 const names=new Map(p.electorate?.people.map(p=>[p.personId,p.name])||[]);
 return detailFacts([['Situação',stateLabels[p.state]||p.state],['Efetivação',stateLabels[p.enactment.state]||p.enactment.state],['Gestão',p.boardId],['Proponente',names.get(p.proposer)||p.proposer],['Abertura',stamp(p.openedAt)],['Prazo',stamp(p.deadline)],['Regra',p.rule==='UNANIMITY'?'Unanimidade de toda a composição':p.rule==='ABSOLUTE_MAJORITY'?'Maioria absoluta de toda a composição':p.rule],['Versão',String(p.contentVersion)]])+detailSection('Objeto e fundamento',`<p>${esc(p.object)}</p><p>${esc(p.basis)}</p><p>${esc(p.reason)}</p>`)+(p.exception?detailSection('Exceção individual',`<p>Arts. 33, §5º, e 47 do Regimento.</p><p>${esc(p.exception.individualGrounds)}</p>`):'')+detailSection('Operação proposta',detailFacts(Object.entries(p.target).map(([k,v])=>[targetLabels[k]||k,k==='defenseDeadline'?stamp(Number(v)):typeof v==='boolean'?(v?'Sim':'Não'):String(v)])))+detailSection('Manifestações nominais',p.electorate?.people.map(person=>{const v=p.votes.find(v=>v.personId===person.personId);return detailFacts([['Diretor',person.name],['Vínculos',person.functions.map(f=>f.linkId).join(', ')],['Manifestação',v?({YES:'Favorável',NO:'Contrário',ABSTAIN:'Abstenção'}[v.choice]||v.choice):'Sem manifestação'],['Data',v?stamp(v.at):'—']]);}).join('')||'<p>Composição ainda não fixada para votação.</p>')+(p.defense?detailSection('Manifestação do interessado',`<p style="white-space:pre-wrap">${esc(p.defense.statement)}</p>`):'')+(p.consent?detailSection('Aceite individual',`<p>${p.consent.accepted?'Aceitou':'Não aceitou'} · ${esc(stamp(p.consent.at))}</p>`):'')+(p.clearance?detailSection('Quitação e pendências',`<p>${esc(p.clearance.pendingDuties||'Sem pendências declaradas.')}</p><p>O registro não constitui veto ao desligamento voluntário.</p>`):'')+(p.notice?detailSection('Ciência e oportunidade de manifestação',detailFacts([['Disponibilização',stamp(p.notice.availableAt)],['Acesso autenticado',stamp(p.notice.access?.at??null)],['Ciência expressa',stamp(p.notice.acknowledgment?.at??null)],['Comunicação externa registrada',stamp(p.notice.externalEvidence?.recordedAt??null)],['Prazo de manifestação',stamp(p.notice.defenseUntil)]])+'<p>Acesso não é ciência; ciência não é concordância. Ausência de manifestação não constitui confissão, renúncia ou voto favorável.</p>'):'')+procedureDocumentsDetail(p.documents||[],catalog)+detailSection('Condições para efetivação',(p.enactment.blocks||[]).map(b=>`<p>${esc(blockLabels[b]||b)}</p>`).join('')||(p.enactment.state==='ENACTED'?'<p>Efeito confirmado no cadastro canônico; registro e recibo preservados.</p>':'<p>Não efetivada.</p>'))+(r.documentAvailable===true?'<button type="button" data-procedure-pdf>Baixar registro documental</button>':'')+`<div>${(r.actions||[]).map(a=>`<button type="button" data-procedure-action="${esc(a)}">${esc(actionLabels[a]||a)}</button>`).join('')}</div>`;
}

function documentChoices(v:ProcedureCatalog){return v.records.flatMap(r=>(r.attachments||[]).map(file=>({record:r,file,ref:{recordId:r.id,revision:r.revision,sha256:file.sha256}})));}
export function procedureDocumentReferences(v:ProcedureCatalog,indices:string[]):DocumentReference[]{
 const rows=documentChoices(v);if(indices.length>10||new Set(indices).size!==indices.length||indices.some(i=>!/^\d+$/.test(i)||!rows[Number(i)]))throw Error('Selecione até dez documentos disponíveis nesta consulta.');
 return indices.map(i=>({...rows[Number(i)]!.ref}));
}
export function procedureDocumentFields(v:ProcedureCatalog):string{
 const rows=documentChoices(v);return '<fieldset><legend>Documentos complementares</legend><p>Seleção opcional dos arquivos privados disponíveis nesta consulta. O Core revalida o acesso, a revisão e a integridade ao confirmar.</p>'+ (rows.length?rows.map((x,i)=>'<label><input type="checkbox" name="procedureDocument" value="'+i+'"> '+esc(x.record.title)+' · '+esc(x.file.name)+' · revisão '+x.record.revision+'</label>').join(''):'<p>Nenhum arquivo disponível neste recorte. Cadastre os documentos em Governança ou ajuste a consulta antes de abrir a proposta.</p>')+'</fieldset>';
}
function procedureDocumentsDetail(refs:DocumentReference[],v?:ProcedureCatalog):string{
 if(!refs.length)return detailSection('Documentos complementares','<p>Nenhum documento associado.</p>');
 return detailSection('Documentos complementares',refs.map((ref,i)=>{const record=v?.records.find(r=>r.id===ref.recordId&&r.revision===ref.revision),file=record?.attachments?.find(f=>f.sha256===ref.sha256);return '<div data-procedure-source="'+i+'">'+(file?'<p>'+esc(record!.title)+'</p>'+filesDetail([file]):'<p>Referência preservada: '+esc(ref.recordId)+' · revisão '+ref.revision+'. Arquivo fora desta consulta ou com versão posterior; consulte o registro de origem.</p>')+'</div>';}).join(''));
}

const field=(name:string,label:string,type='text')=>`<label>${esc(label)}<input name="${name}" type="${type}" required ${type==='text'?'maxlength="2000"':''}></label>`;
export function procedureFields(type:string,people:Person[],options:ProcedureCatalog['procedureOptions']={roles:[],responsibleFunctions:[]}):string{
 const person=`<label>Pessoa<select name="personId" required><option value="">Selecione</option>${people.map(p=>`<option value="${esc(p.personId)}">${esc(p.name)} · ${esc(p.personId)}</option>`).join('')}</select></label>`;
 const select=(name:string,label:string,rows:{id:string;label:string}[])=>'<label>'+esc(label)+'<select name="'+name+'" required><option value="">Selecione</option>'+rows.map(r=>'<option value="'+esc(r.id)+'">'+esc(r.label)+'</option>').join('')+'</select></label>';
 const fn='<label>Função atual<select name="functionId" required></select></label>',link='<label>Vínculo institucional<select name="linkId" required></select></label>';
 if(type==='TEMPORARY_OFFICE')return person+link+field('roleName','Denominação do cargo')+field('purpose','Finalidade')+field('duties','Atribuições')+field('startDate','Início','date')+field('endDate','Término','date')+'<label><input name="advisoryAllowed" type="checkbox"> Permite equipe de assessoria</label>';
 if(type==='DIRECTOR_APPOINTMENT')return person+link+select('roleId','Cargo não eletivo',options?.roles||[])+field('startDate','Início','date')+field('endDate','Término','date');
 if(type==='ADVISOR_APPOINTMENT')return person+link+select('responsibleFunctionId','Diretor responsável',options?.responsibleFunctions||[])+field('purpose','Finalidade')+field('duties','Atribuições')+field('startDate','Início','date')+field('endDate','Término','date');
 if(type==='EXTRAORDINARY_EXTENSION')return person+fn+field('endDate','Novo término proposto','date')+'<label>Fundamentação da exceção individual<textarea name="individualGrounds" required minlength="30" maxlength="4000"></textarea></label><p>Explicite a necessidade individual de exceção ao limite de permanência, com fundamento nos arts. 33, §5º, e 47. O texto integrará o conteúdo submetido ao aceite e à votação; não altera propostas já abertas.</p>';
 if(type==='DIRECTOR_DISMISSAL')return person+fn+field('grounds','Fundamentos e fatos')+field('defenseDeadline','Prazo de manifestação (Cuiabá)','datetime-local');
 return person+fn+field('endDate',type.includes('EXTENSION')?'Novo término proposto':'Data de encerramento','date')+(type==='ADVISOR_END'?'<label>Motivo não disciplinar<select name="reason"><option value="VOLUNTARY_REQUEST">Solicitação voluntária documentada</option><option value="ASSIGNMENT_COMPLETED">Atribuição concluída</option><option value="RESPONSIBILITY_ENDED">Responsabilidade encerrada</option></select></label>':'');
}
export function mountProcedures(el:HTMLElement,v:ProcedureCatalog,reload:()=>Promise<void>):()=>void{
 const area=document.createElement('div');area.innerHTML=procedureCards(v);if(!area.textContent)return ()=>{};el.append(area);
 let active=true,busy=false,dialog:HTMLElement|undefined,prepared:unknown,selected:ProcedureRecord|undefined;let disposeDownloads:Array<()=>void>=[];
 const close=()=>{disposeDownloads.splice(0).forEach(f=>f());const d=dialog;dialog=undefined;prepared=undefined;if(d){closeDetailDialog(d,true);d.remove();}};
 const open=(title:string,body:string,edit=false)=>{close();const d=document.createElement('div');d.className='modal-backdrop';d.hidden=true;d.dataset.institutionalDialog='';if(edit)d.setAttribute('data-geapa-protect-draft','');d.innerHTML=`<section class="modal-panel geapa-board-panel" role="dialog" aria-modal="true" aria-labelledby="procedure-dialog-title"><header class="modal-topbar"><h2 id="procedure-dialog-title">${esc(title)}</h2><button type="button" data-admin-modal-close aria-label="Fechar">×</button></header>${body}<div role="status" aria-live="polite" data-procedure-feedback></div></section>`;document.body.append(d);dialog=d;openDetailDialog(d,()=>{if(busy)return;disposeDownloads.splice(0).forEach(f=>f());d.remove();if(dialog===d)dialog=undefined;});document.dispatchEvent(new CustomEvent('portal:institutional-dialog-opened'));};
 const call=async(phase:string,payload:unknown)=>{if(busy||!active)return;busy=true;const d=dialog,feedback=d?.querySelector<HTMLElement>('[data-procedure-feedback]')||area.querySelector<HTMLElement>('[data-procedure-result]');const controls=[...(d?.querySelectorAll<HTMLInputElement>('input,textarea,select,button')||[])].map(e=>({e,disabled:e.disabled}));controls.forEach(x=>x.e.disabled=true);d?.setAttribute('aria-busy','true');
  try{const api=(window as unknown as {PortalGeapaApi:{apiPost:(route:string,q:{payload:string})=>Promise<{ok:boolean;message?:string;data:{state?:string;operationId?:string;request?:unknown;preview?:{value:string};contentBase64?:string;mime?:string;name?:string}}>}}).PortalGeapaApi;const r=await api.apiPost('/admin/gestao-institucional/governanca/editar',{payload:JSON.stringify({phase,payload})});if(!active)return;if(!r.ok)throw Error(r.message||'Não foi possível confirmar o procedimento.');if(phase==='document'){if(!r.data.contentBase64||r.data.mime!=='application/pdf')throw Error('Documento não confirmado.');const bytes=Uint8Array.from(atob(r.data.contentBase64),c=>c.charCodeAt(0)),url=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'})),a=document.createElement('a');a.href=url;a.download=r.data.name||'Procedimento.pdf';a.click();setTimeout(()=>URL.revokeObjectURL(url),30000);if(feedback)feedback.textContent='Documento conferido e disponibilizado.';}else if(phase==='preview'){prepared=r.data.request;if(feedback)feedback.innerHTML=`<p>${esc(r.data.preview?.value||'Confira a operação.')}</p><button type="button" data-procedure-confirm>Confirmar registro</button>`;}else if(r.data.state==='COMPLETED'){close();await reload();}else if(feedback)feedback.textContent='Resultado: '+(r.data.state||'desconhecido')+'. Consulte o último envio antes de repetir.';}
  catch(e){if(active&&feedback)feedback.innerHTML=procedureRecoveryFeedback(e instanceof Error?e.message:'Falha na operação.');prepared=undefined;}
  finally{busy=false;d?.removeAttribute('aria-busy');controls.forEach(x=>x.e.disabled=x.disabled);}
 };
 const fillPerson=()=>{const p=v.procedurePeople?.find(p=>p.personId===dialog?.querySelector<HTMLSelectElement>('[name="personId"]')?.value);for(const [name,options]of [['linkId',p?.links.map(l=>({id:l.id,label:l.type}))||[]],['functionId',p?.functions.map(f=>({id:f.id,label:f.roleKey}))||[]]] as const){const select=dialog?.querySelector<HTMLSelectElement>('[name="'+name+'"]');if(select)select.innerHTML='<option value="">Selecione</option>'+options.map(o=>`<option value="${esc(o.id)}">${esc(o.label)} · ${esc(o.id)}</option>`).join('');}};
 const click=(e:MouseEvent)=>{if(!active||busy||!(e.target instanceof Element))return;const t=e.target;if(t.closest('[data-procedure-pdf]')&&selected){void call('document',{id:selected.id,revision:selected.revision});return;}if(t.closest('[data-procedure-recover]')){void call('status',{});return;}if(t.closest('[data-procedure-confirm]')&&prepared){void call('execute',prepared);return;}
  if(t.closest('[data-procedure-new]')&&v.procedureTypes?.length){selected=undefined;open('Novo procedimento',`<form data-procedure-form><label>Tipo<select name="type" required>${v.procedureTypes.map(t=>`<option value="${esc(t.id)}">${esc(t.label)}</option>`).join('')}</select></label><label>Gestão<select name="boardId">${v.boards.map(b=>`<option value="${esc(b.id)}">${esc(b.name)}</option>`).join('')}</select></label>${field('title','Título')}${field('object','Objeto')}<label>Fundamento<textarea name="basis" required maxlength="1500"></textarea></label><label>Justificativa<textarea name="reason" required minlength="10" maxlength="1500"></textarea></label><label>Prazo de votação em dias<select name="days" required>${(v.procedureTypes[0]!.allowedDays||[7]).map(n=>`<option value="${n}">${n}</option>`).join('')}</select></label><div data-procedure-fields>${procedureFields(v.procedureTypes[0]!.id,v.procedurePeople||[],v.procedureOptions)}</div>${procedureDocumentFields(v)}<p>O Core confere o escopo, as regras e as vigências. Este registro não efetiva alterações de cargos.</p><button type="submit">Conferir proposta</button></form>`,true);return;}
  const card=t.closest<HTMLElement>('[data-procedure-card]');if(card&&(t.closest('button')||!t.closest('a,input,select'))){selected=v.records.find(r=>r.id===card.dataset.procedureCard);if(selected){open(selected.title,procedureDetail(selected,v));for(const [i,ref]of (selected.procedure?.documents||[]).entries()){const record=v.records.find(r=>r.id===ref.recordId&&r.revision===ref.revision),file=record?.attachments?.find(f=>f.sha256===ref.sha256),root=dialog?.querySelector<HTMLElement>('[data-procedure-source="'+i+'"]');if(record&&file&&root)disposeDownloads.push(mountFileDownloads(root,{...record,attachments:[file]},async(phase,payload)=>{const api=(window as unknown as {PortalGeapaApi:{apiPost:(route:string,q:{payload:string})=>Promise<{ok:boolean;message?:string;data:unknown}>}}).PortalGeapaApi;const r=await api.apiPost('/admin/gestao-institucional/governanca/editar',{payload:JSON.stringify({phase,payload})});if(!r.ok)throw Error(r.message||'Não foi possível conferir o arquivo.');return r.data;}));}}return;}
  const action=t.closest<HTMLElement>('[data-procedure-action]')?.dataset.procedureAction;if(action&&selected?.actions?.includes(action)){const p=selected.procedure!;open(actionLabels[action]||action,`<form data-procedure-action-form data-action="${esc(action)}">${action==='BP_NOTICE'?'<label>Recebimento comprovado (Cuiabá)<input type="datetime-local" name="receivedAt" required></label>'+procedureDocumentFields(v):action==='BP_ACK'?'<p>Confirmar ciência registra o recebimento desta versão. Não significa concordar com a proposta nem renunciar à manifestação.</p>':action==='BP_ACCESS'?'<p>Registra somente seu acesso autenticado ao conteúdo; não comprova ciência ou concordância.</p>':action==='BP_VOTE'?'<label>Manifestação<select name="choice"><option value="YES">Favorável</option><option value="NO">Contrário</option><option value="ABSTAIN">Abstenção</option></select></label>':action==='BP_CONSENT'?'<label>Resposta<select name="accepted"><option value="true">Aceito a prorrogação</option><option value="false">Não aceito</option></select></label>':action==='BP_DEFEND'?'<label>Manifestação<textarea name="statement" required maxlength="8000"></textarea></label>':action==='BP_CLEARANCE'?'<label>Pendências remanescentes<textarea name="pendingDuties" maxlength="4000"></textarea></label>':''}<p>Versão ${p.contentVersion} · ${esc(p.title)}</p><label>Motivo do registro<textarea name="reason" required minlength="10" maxlength="1500"></textarea></label><button type="submit">Conferir registro</button></form>`,true);}
 };
 const submit=(e:SubmitEvent)=>{if(!active||busy||!(e.target instanceof HTMLFormElement))return;const form=e.target;if(!form.matches('[data-procedure-form],[data-procedure-action-form]'))return;e.preventDefault();const f=new FormData(form),value=(k:string)=>String(f.get(k)||'').trim();
