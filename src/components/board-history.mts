import {esc,badge,detailFacts,detailSection} from './design-system.mjs';
export type HistoricalFunction={personId:string;name:string;functionId:string;linkId:string;roleId:string;roleName:string;roleKey:string;group:string;startDate:string;endDate:string|null;revision:number};
export type HistoricalBoard={id:string;name:string;startDate:string;endDate:string;revision:number;status:'PLANNED'|'ENDED'|'CURRENT';slogan:string|null;presidents:string[];directors:number;advisors:number;functions:HistoricalFunction[];terms:{associationId:string;id:string;name:string;startDate:string;endDate:string}[];documents:{kind:string;label:string;url:string;sha256:string}[];issues:string[]};
export type BoardHistory={schemaVersion:'board-history-v1';validUntil:number;records:HistoricalBoard[];notice:string};
const states={PLANNED:'Planejada',ENDED:'Encerrada',CURRENT:'Em exercício'};
const date=(s:string|null)=>s&&/^\d{4}-\d{2}-\d{2}$/.test(s)?s.split('-').reverse().join('/'):'Não documentado';
export function boardHistoryCards(data:BoardHistory|null|undefined):string{
 if(!data)return '<p role="status">O histórico ainda não está disponível nesta autorização. A consulta de cargos permanece preservada.</p>';
 return `<p class="geapa-board-notice">${esc(data.notice)}</p><div class="geapa-record-grid">${data.records.map(b=>`<article class="geapa-record geapa-board-card geapa-board-history-card" data-board-history-card="${esc(b.id)}"><header class="geapa-record-head"><h3>${esc(b.name)}</h3>${badge(states[b.status],b.status!=='CURRENT')}</header><p>${esc(date(b.startDate))} a ${esc(date(b.endDate))}</p>${b.slogan?`<p>${esc(b.slogan)}</p>`:''}<p>Presidência: ${esc(b.presidents.join('; ')||'Não documentada')}</p><p>${b.directors} diretores · ${b.advisors} assessores registrados na trajetória</p><button type="button" class="secondary-button" data-board-history-detail="${esc(b.id)}" aria-haspopup="dialog">Consultar gestão</button></article>`).join('')}</div>`;
}
export function boardHistoryDetail(b:HistoricalBoard):string{
 return `<section class="modal-panel geapa-board-panel" role="dialog" aria-modal="true" aria-labelledby="board-history-title"><header class="modal-topbar"><div><p class="geapa-eyebrow">Histórico de Diretorias</p><h2 id="board-history-title">${esc(b.name)}</h2></div><button type="button" data-admin-modal-close aria-label="Fechar">×</button></header>`+detailFacts([['Gestão',b.id],['Situação',states[b.status]],['Início',date(b.startDate)],['Término',date(b.endDate)],['Lema',b.slogan||'Não documentado']])+detailSection('Composição e trajetória',b.functions.map(f=>`<article class="geapa-record"><h3>${esc(f.name)}</h3>${detailFacts([['Cargo registrado',f.roleName],['Grupo',f.group],['Início',date(f.startDate)],['Término',date(f.endDate)],['Pessoa',f.personId],['Vínculo institucional',f.linkId]])}<details><summary>Referências do registro</summary><p>${esc(f.functionId)} · ${esc(f.roleId)} · revisão ${f.revision}</p></details></article>`).join('')||'<p>Composição histórica ainda não vinculada.</p>')+detailSection('Semestres internos da Diretoria',b.terms.map(t=>detailFacts([['Semestre',t.name],['Período',date(t.startDate)+' a '+date(t.endDate)]] )).join('')||'<p>Sem associação canônica disponível.</p>')+detailSection('Planos, metas e arquivos',b.documents.map(d=>/^https:\/\/drive\.google\.com\/file\/d\/[A-Za-z0-9_-]+\/view$/.test(d.url)?`<p><a href="${esc(d.url)}" target="_blank" rel="noopener noreferrer">${esc(d.label)}</a></p>`:'').join('')||'<p>Documentos ainda não vinculados com comprovação.</p>')+detailSection('Observações documentais',b.issues.map(s=>`<p>${esc(s)}</p>`).join('')||'<p>Sem pendência informada.</p>')+'</section>';
}
