import {esc,header,badge,detailSection} from './design-system.mjs';
import {personLabel} from './people-directory.mjs';
type Permission={label:string;module:string;action:string;status:string;reason:string;limits:{cycleIds:string[];policyValidUntil:string|null}};
type Profile={id:string;label:string;holder?:string;source:string;status:string;condition:string;permissions:Permission[]};
export type AccessCatalog={schemaVersion:'people-access-catalog-v1';validUntil:number;notice:string;relations:{id:string;label:string;condition:string}[];roles:{roleKey:string;name:string;startDate:string;endDate:string;duties:{summary:string;source:string}}[];profiles:Profile[];otherFunctions:{groups:string[];condition:string}};
export function profilePermissions(p:Profile):string{
 const groups=new Map<string,Permission[]>();for(const v of p.permissions)groups.set(v.module,[...(groups.get(v.module)||[]),v]);
 return `<h3>${esc(p.label)}</h3>${p.holder?`<p>${esc(p.holder)}</p>`:''}<p>${esc(p.condition)}</p><small>${esc(p.source)}</small>`+(!groups.size?'<p>Nenhuma permissão operacional é atribuída apenas por este rótulo.</p>':[...groups].map(([name,items])=>detailSection(name,items.map(v=>`<article class="geapa-record"><h4>${esc(v.label)}</h4><p>${esc(v.action)} · ${esc(v.status==='CONDITIONAL'?'Disponível sob condições':p.status==='CONDITIONAL_SELF_CATALOG'?'Sujeita à elegibilidade SELF':'Não habilitada')}</p><p>${esc(v.reason)}</p>${v.limits.cycleIds.length?`<p>Ciclos: ${v.limits.cycleIds.map(esc).join(', ')}</p>`:''}${v.limits.policyValidUntil?`<small>Validade da policy: ${esc(v.limits.policyValidUntil.slice(0,10))}</small>`:''}</article>`).join(''))).join(''));
}
export function renderAccessCatalog(v:AccessCatalog):string{
 return header('Perfis e permissões','Relações institucionais e acessos resolvidos pelo Core.','<button data-access-refresh>Atualizar</button>')+`<p class="geapa-board-notice">${esc(v.notice)}</p>`+detailSection('Relações institucionais','<div class="geapa-record-grid">'+v.relations.map(r=>`<article class="geapa-record"><h3>${esc(r.label)}</h3><p>${esc(r.condition)}</p></article>`).join('')+'</div>')+detailSection('Cargos e funções','<div class="geapa-record-grid">'+v.roles.map(r=>`<article class="geapa-record"><h3>${esc(personLabel(r.roleKey))}</h3><p>${esc(r.name)}</p><p>${esc(r.startDate)} — ${esc(r.endDate)}</p><p>${esc(r.duties.summary)}</p><small>${esc(r.duties.source)}</small></article>`).join('')+`</div><p>${v.otherFunctions.groups.map(esc).join(' · ')}: ${esc(v.otherFunctions.condition)}</p>`)+detailSection('Perfis e permissões',`<label>Selecionar perfil<select data-access-profile>${v.profiles.map((p,i)=>`<option value="${i}">${esc(p.label)}${p.holder?' — '+esc(p.holder):''}${p.status==='DOCUMENTARY_ONLY'?' (documental)':''}</option>`).join('')}</select></label><div data-access-details aria-live="polite">${v.profiles[0]?profilePermissions(v.profiles[0]):''}</div>`);
}
type Host=Window&{PortalGeapaApi?:{apiGet:(route:string,params:Record<string,string>)=>Promise<{ok:boolean;data:AccessCatalog;message?:string}>};PortalGeapaNavigation?:{getRotaAtual:()=>string}};
let generation=0,current:AccessCatalog|undefined,timer:ReturnType<typeof setTimeout>|undefined;
const active=()=>typeof window!=='undefined'&&(window as Host).PortalGeapaNavigation?.getRotaAtual()==='perfis-permissoes';
function clear(){generation++;current=undefined;clearTimeout(timer);}
async function load(){clear();const epoch=generation,el=document.getElementById('placeholder-content');if(!active()||!el)return;el.classList.add('geapa-admin');el.textContent='Consultando perfis e permissões…';try{const r=await (window as Host).PortalGeapaApi?.apiGet('/admin/diretoria-competencias',{view:'profiles'});if(epoch!==generation||!active())return;if(!r?.ok||r.data.schemaVersion!=='people-access-catalog-v1'||r.data.validUntil<=Date.now())throw Error(r?.message||'Consulta não autorizada ou expirada.');current=r.data;el.innerHTML=renderAccessCatalog(current);timer=setTimeout(()=>{clear();el.innerHTML='<p>Atualize para revalidar o acesso.</p><button data-access-refresh>Atualizar</button>';},current.validUntil-Date.now());}catch(e){if(epoch===generation){el.textContent=e instanceof Error?e.message:'Consulta indisponível.';}}}
if(typeof document!=='undefined'){
 document.addEventListener('portal:navigationchange',()=>{clear();if(active())void load();});
 document.addEventListener('portal:act-session-cleared',()=>{clear();if(active())document.getElementById('placeholder-content')?.replaceChildren();});
 document.addEventListener('click',e=>{if(active()&&e.target instanceof Element&&e.target.closest('[data-access-refresh]'))void load();});
 document.addEventListener('change',e=>{if(!active()||!(e.target instanceof HTMLSelectElement)||!e.target.matches('[data-access-profile]')||!current)return;if(current.validUntil<=Date.now()){void load();return;}const p=current.profiles[Number(e.target.value)],el=document.querySelector('[data-access-details]');if(p&&el)el.innerHTML=profilePermissions(p);});
}
