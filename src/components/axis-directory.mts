import {esc,header,badge,detailFacts,detailSection,openDetailDialog,closeDetailDialog,textMatches} from './design-system.mjs';
export type Axis={code:string;order:number;roman:string;name:string;shortName:string;formLabel:string;summary:string;active:boolean;documentedUpdatedAt:string;examples:string[];keywords:string[];disciplines:string[];guide:{scope:string;examples:string[];keywords:string[];disciplines:string[]};administrativeNotes?:string};
type Directory={schemaVersion:string;revision:number;contentHash:string;items:Axis[];validUntil?:number};
type Section={id:string;title:string;subtitle:string;text:string;order:number};
type Page={id:string;schemaVersion:string;published:boolean;sanitized:boolean;revision:number;sourceHash:string;title:string;subtitle:string;sections:Section[]};
const need=(v:unknown):void=>{if(!v)throw Error('Não foi possível validar a publicação dos eixos.');};
export function parsePublicAxes(value:{index:Page;pages:Page[]}):Directory{
 const {index,pages}=value;need(index?.id==='eixos-tematicos'&&index.sections?.length===8&&pages?.length===8&&/^[a-f0-9]{64}$/.test(index.sourceHash));
 for(const p of [index,...pages])need(p.schemaVersion==='geapa-public-v2.1'&&p.published===true&&p.sanitized===true&&p.sourceHash===index.sourceHash&&p.revision===index.revision&&p.revision>0);
 const items=index.sections.map((s,i)=>{const p=pages[i];need(p&&p.id===s.id&&s.order===i+1&&s.subtitle==='EIXO_0'+(i+1));const sections=new Map(p!.sections.map(x=>[x.id,x]));need(sections.size===9&&p!.sections.length===9);const text=(id:string)=>{const v=sections.get(id)?.text;need(typeof v==='string'&&v.length>0&&v.length<=8000);return v!;},list=(id:string)=>text(id).split('\n');const identity=list('identity');need(identity.length===6&&identity[0]===s.subtitle&&identity[4]==='Ativo');return {code:identity[0]!,order:s.order,roman:identity[1]!,name:p!.title,shortName:identity[2]!,formLabel:identity[3]!,summary:p!.subtitle,active:true,documentedUpdatedAt:identity[5]!,examples:list('examples'),keywords:list('keywords'),disciplines:list('disciplines'),guide:{scope:text('scope'),examples:list('guide-examples'),keywords:list('guide-keywords'),disciplines:list('guide-disciplines')}};});
 return {schemaVersion:'axis-directory-v1',revision:index.revision,contentHash:index.sourceHash,items};
}
export function filteredAxes(items:Axis[],query:string):Axis[]{return items.filter(x=>textMatches([x.code,x.roman,x.name,x.shortName,x.formLabel,x.summary,x.guide.scope,...x.keywords,...x.examples,...x.disciplines,...x.guide.keywords,...x.guide.examples,...x.guide.disciplines].join(' '),query)).sort((a,b)=>a.order-b.order);}
const list=(items:string[])=>'<ul>'+items.map(x=>'<li>'+esc(x)+'</li>').join('')+'</ul>';
export function renderAxisDetail(x:Axis,revision:number,admin=false):string{return '<section class="modal-panel geapa-axis-dialog" role="dialog" aria-modal="true" aria-labelledby="axis-title"><div class="modal-topbar"><h2 id="axis-title">'+esc(x.roman+' — '+x.name)+'</h2><button type="button" class="secondary-button" data-admin-modal-close>Fechar</button></div>'+detailFacts([['Código',x.code],['Nome curto',x.shortName],['Rótulo de formulário',x.formLabel],['Situação',x.active?'Ativo':'Inativo']])+detailSection('O que abrange','<p>'+esc(x.guide.scope)+'</p>')+detailSection('Exemplos de temas','<h4>No guia orientativo</h4>'+list(x.guide.examples)+'<details><summary>Exemplos da planilha oficial</summary>'+list(x.examples)+'</details>')+detailSection('Palavras-chave',list([...new Set([...x.keywords,...x.guide.keywords])]))+detailSection('Disciplinas relacionadas',list(x.guide.disciplines)+'<details><summary>Classificação da planilha</summary>'+list(x.disciplines)+'</details>')+detailSection('Informações complementares','<p>Conteúdo orientativo, sem valor normativo. Guia de Eixos Temáticos GEAPA (2025) e planilha EIXOS_TEMATICOS_OFICIAIS.</p><p>Referência original do guia: Regulamento Interno, art. 21, §1º. Esta transcrição não declara vigência normativa.</p>'+detailFacts([['Versão publicada',revision],['Atualização documentada da planilha',x.documentedUpdatedAt]])+(admin&&x.administrativeNotes?'<h4>Normalização administrativa</h4><p>'+esc(x.administrativeNotes)+'</p>':''))+'</section>';}
export function renderAxes(items:Axis[]):string{return '<div class="geapa-axis-grid">'+items.map(x=>'<article class="geapa-record-card geapa-axis-card" data-axis-card="'+esc(x.code)+'"><div class="geapa-axis-heading">'+badge(x.roman,true)+'<span>'+esc(x.code)+'</span></div><h2><button type="button" data-axis-detail="'+esc(x.code)+'">'+esc(x.name)+'</button></h2><p>'+esc(x.summary)+'</p><span class="geapa-axis-more">Consultar eixo <span aria-hidden="true">↗</span></span></article>').join('')+'</div>'+(items.length?'':'<p role="status">Nenhum eixo corresponde à busca.</p>');}
type Host=Window&{PortalGeapaNavigation?:{getRotaAtual:()=>string};PortalGeapaApi?:{apiGet:(path:string,params:object)=>Promise<{ok:boolean;data:Directory;message?:string}>}};
let generation=0,current:Directory|null=null,modal:HTMLElement|null=null,timer:ReturnType<typeof setTimeout>|undefined;
const route=()=> (window as Host).PortalGeapaNavigation?.getRotaAtual(),active=()=>['eixos-tematicos','admin-eixos-tematicos'].includes(route()||'');
function clear(){current=null;clearTimeout(timer);if(modal)closeDetailDialog(modal,true);modal=null;}
function show(code:string){if(!current)return;if(current.validUntil&&current.validUntil<=Date.now()){void load();return;}const item=current.items.find(x=>x.code===code);if(!item)return;if(modal)closeDetailDialog(modal,true);modal=document.createElement('div');modal.className='modal-backdrop';modal.hidden=true;modal.innerHTML=renderAxisDetail(item,current.revision,route()==='admin-eixos-tematicos');document.body.append(modal);const target=modal;openDetailDialog(target,()=>{target.remove();if(modal===target)modal=null;});}
async function load(){const el=document.getElementById('placeholder-content');if(!el||!active())return;const epoch=++generation,admin=route()==='admin-eixos-tematicos';clear();el.classList.add('geapa-admin');el.textContent='Consultando os eixos temáticos…';
 try{let data:Directory;if(admin){const r=await (window as Host).PortalGeapaApi?.apiGet('/admin/eixos-tematicos',{});if(!r?.ok)throw Error(r?.message||'Não foi possível autorizar a consulta.');data=r.data;need(data.validUntil&&data.validUntil>Date.now());}else{const url='/assets/act-command/axis-public.mjs';const service=await import(url);data=parsePublicAxes(await service.readPublicAxes());}if(epoch!==generation||!active())return;need(data.schemaVersion==='axis-directory-v1'&&data.items.length===8);current=data;el.innerHTML=header('Eixos temáticos','Conheça os oito eixos oficiais e os assuntos que abrangem.','','',admin?'Gestão do GEAPA':'Área Pública')+'<p class="geapa-axis-notice">Guia orientativo, sem valor normativo. A consulta não altera classificações ou regras das apresentações.</p><label class="geapa-axis-search"><span>Buscar eixos e assuntos</span><input type="search" data-axis-search placeholder="Nome, código, palavra-chave ou assunto"></label><p data-axis-count role="status">8 eixos · versão '+esc(data.revision)+'</p><div data-axis-results>'+renderAxes(data.items)+'</div>';if(data.validUntil)timer=setTimeout(()=>{if(epoch===generation){clear();el.innerHTML='<p>Atualize a consulta para revalidar seu acesso.</p><button type="button" data-axis-refresh>Atualizar</button>';}},data.validUntil-Date.now());}
 catch(e){if(epoch===generation){el.innerHTML='<p role="alert">'+esc(e instanceof Error?e.message:'Consulta indisponível.')+'</p><button type="button" data-axis-refresh>Tentar novamente</button>';}}
}
if(typeof document!=='undefined'){
 document.addEventListener('portal:navigationchange',()=>{generation++;clear();if(active())void load();});
 document.addEventListener('portal:act-session-cleared',()=>{if(route()==='admin-eixos-tematicos'){generation++;clear();document.getElementById('placeholder-content')?.replaceChildren();}});
 document.addEventListener('input',e=>{if(!(e.target instanceof HTMLInputElement)||!e.target.matches('[data-axis-search]')||!current)return;const items=filteredAxes(current.items,e.target.value),el=document.querySelector('[data-axis-results]'),count=document.querySelector('[data-axis-count]');if(el)el.innerHTML=renderAxes(items);if(count)count.textContent=items.length+' eixos encontrados';});
 document.addEventListener('click',e=>{if(!(e.target instanceof Element)||e.defaultPrevented||e.button!==0||e.ctrlKey||e.metaKey||e.altKey||e.shiftKey)return;if(e.target.closest('[data-axis-refresh]')){void load();return;}const button=e.target.closest<HTMLElement>('[data-axis-detail]'),card=e.target.closest<HTMLElement>('[data-axis-card]');if(!card||(!button&&(e.target.closest('a,button,input,select,summary')||window.getSelection()?.toString())))return;const code=button?.dataset.axisDetail??card.dataset.axisCard;if(code){card.querySelector<HTMLElement>('button')?.focus();show(code);}});
 if(active())void load();
}
