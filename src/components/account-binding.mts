import {esc} from './design-system.mjs';
type Answer={state?:string;canManage?:boolean;email?:string|null;operationId?:string;personId?:string;expiresAt?:number;receiptState?:string|null};
type Options={call:(phase:string,payload:Record<string,unknown>)=>Promise<Answer>;current:()=>boolean};
const messages:Record<string,string>={MEMBER_NOT_ELIGIBLE:'O cadastro não está em uma situação elegível para associação de conta.',M13_AUTHZ_DENIED:'Você não tem autorização específica para administrar as contas desta pessoa.',PILOT_RESOURCE_DENIED:'Esta pessoa não está no escopo habilitado para associação neste ambiente.',BINDING_ACCOUNT_NOT_FOUND:'Conta não encontrada. A pessoa precisa entrar primeiro com sua Conta Google no Portal.',BINDING_EMAIL_UNVERIFIED:'O e-mail dessa conta ainda não está verificado.',BINDING_GOOGLE_REQUIRED:'Use o e-mail de uma Conta Google vinculada ao Firebase Authentication.',BINDING_ACCOUNT_DISABLED:'A conta de acesso está desativada.',BINDING_ACCOUNT_CHANGED:'A conta mudou após a conferência. Faça uma nova verificação.',BINDING_CONFLICT:'Já existe uma associação conflitante. Nenhum vínculo será substituído.',BINDING_EVIDENCE_REQUIRED:'Confira o identificador e a referência da evidência. Nome ou e-mail, isoladamente, não comprovam identidade.',BINDING_VERIFICATION_EXPIRED:'A verificação expirou. Consulte o resultado antes de iniciar outra.',REVISION_CONFLICT:'O cadastro mudou. Consulte o resultado e atualize os dados antes de uma nova verificação.',ACCESS_REVOKED:'Você não tem autorização específica para administrar as contas desta pessoa.',PILOT_DISABLED:'A associação administrativa ainda não está habilitada neste ambiente.'};
export function mountAccountBinding(target:HTMLElement,personId:string,o:Options){
 let pending=false,proposal:Answer|null=null,operationId:string|null=null;
 const live=()=>o.current()&&target.isConnected;
 const error=(e:unknown)=>messages[(e as {code?:string})?.code||'']||'Não foi possível confirmar o resultado. Use Consultar resultado; não inicie outra associação.';
 function status(text:string){const el=target.querySelector('[role="status"]');if(el)el.textContent=text;}
 function shell(body:string){if(live())target.innerHTML='<h3>Contas de acesso</h3><p>O e-mail de login é independente do e-mail de contato institucional.</p><div role="status" aria-live="polite"></div>'+body;}
 async function run(fn:()=>Promise<void>){if(pending||!live())return;pending=true;target.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.disabled=true);try{await fn();}catch(e){if(live())status(error(e));}finally{pending=false;if(live())target.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.disabled=false);}}
 function form(){target.setAttribute('data-geapa-protect-draft','');shell('<form data-binding-form><label>E-mail da Conta Google<input name="email" type="email" maxlength="254" required autocomplete="off"></label><label>Identificador conferido<select name="kind"><option value="RGA">RGA</option><option value="CPF">CPF (somente números)</option></select></label><label>Valor do identificador<input name="value" maxlength="40" required autocomplete="off"></label><label>Referência da evidência conferida<input name="reference" maxlength="48" pattern="[A-Za-z0-9_-]+" required autocomplete="off"></label><label><input name="identityConfirmed" type="checkbox" required>Conferi o documento identificador e a titularidade desta Conta Google com a pessoa. Não usei apenas nome ou e-mail.</label><button type="submit">Verificar conta</button></form><div data-binding-proposal></div>');
  target.querySelector('form')!.addEventListener('submit',event=>{event.preventDefault();void run(async()=>{const f=event.currentTarget as HTMLFormElement,data=new FormData(f);proposal=await o.call('verify',{personId,email:String(data.get('email')).trim(),evidence:{kind:data.get('kind'),value:String(data.get('value')).trim(),reference:String(data.get('reference')).trim(),identityConfirmed:data.get('identityConfirmed')!==null}});if(!live())return;operationId=proposal.operationId!;f.reset();f.hidden=true;showProposal();});});
 }
 function recovery(){target.setAttribute('data-geapa-protect-draft','');const area=target.querySelector('[data-binding-proposal]')||target;area.innerHTML='<p>Consulte a operação existente antes de iniciar outra associação.</p><button type="button" data-binding-status>Consultar resultado</button>';target.querySelector('[data-binding-status]')!.addEventListener('click',()=>void run(async()=>{const r=await o.call('status',{personId});if(!live())return;showResult(r);}));}
 function showResult(r:Answer){
  if(r.state==='COMMIT_APPLIED'){target.removeAttribute('data-geapa-protect-draft');shell('<p>Conta associada com sucesso. O cadastro e o e-mail de contato foram preservados.</p>');return;}
  if(['UNVERIFIED','EXPIRED'].includes(r.state||'')){form();status(r.state==='EXPIRED'?'Verificação expirada. Faça uma nova conferência.':'Verifique a conta para continuar.');return;}
  if(r.state==='PENDING'){const area=target.querySelector('[data-binding-proposal]')||target;area.innerHTML='<p>Há uma operação admitida. A retomada usa o mesmo recibo, sem novo envio.</p><button type="button" data-binding-recover>Retomar operação</button>';target.querySelector('[data-binding-recover]')!.addEventListener('click',()=>void run(async()=>{const result=await o.call('recover',{personId});if(live())showResult(result);}));return;}
  status(r.receiptState==='FAILED'?'A associação não foi aplicada. O vínculo anterior foi preservado.':'Operação ainda não concluída. Consulte novamente usando a mesma operação.');
  if(['VERIFIED','NOT_ADMITTED'].includes(r.state||'')){const area=target.querySelector('[data-binding-proposal]')||target;area.insertAdjacentHTML('beforeend','<p>A operação ainda não foi admitida. Reabra a conferência para confirmar a mesma conta.</p><button type="button" data-binding-resume>Reabrir conferência</button>');target.querySelector('[data-binding-resume]')!.addEventListener('click',()=>void run(async()=>{proposal=await o.call('proposal',{personId});if(live()){operationId=proposal.operationId!;showProposal();}}));}
 }
 function showProposal(){target.setAttribute('data-geapa-protect-draft','');const area=target.querySelector('[data-binding-proposal]')||target;area.innerHTML='<p>Associar a pessoa '+esc(personId)+' à conta <strong>'+esc(proposal?.email||'')+'</strong> (Google, e-mail verificado).</p><label><input type="checkbox" data-binding-confirmed>Confirmo que esta é a conta da pessoa selecionada e autorizo a associação.</label><button type="button" data-binding-confirm>Confirmar associação</button><button type="button" data-binding-status>Consultar resultado</button>';
  target.querySelector('[data-binding-confirm]')!.addEventListener('click',()=>void run(async()=>{if(!(target.querySelector('[data-binding-confirmed]') as HTMLInputElement).checked){status('Confirme a conta antes de associar.');return;}try{const r=await o.call('confirm',{personId,operationId,confirmed:true});if(live())showResult(r);}catch(e){if(live()){recovery();status(error(e));}}}));
  target.querySelector('[data-binding-status]')!.addEventListener('click',()=>void run(async()=>{const r=await o.call('status',{personId});if(live())showResult(r);}));
 }
 shell('<p>Consultando associação autorizada…</p>');void run(async()=>{const r=await o.call('context',{personId});if(!live())return;if(!r.canManage){shell('<p>Consulta de contas exige autorização administrativa específica.</p>');return;}shell('<p>'+ (r.state!=='UNASSOCIATED'?(r.state==='REVOKED'?'Associação revogada; substituição não disponível':'Conta associada')+(r.email?': '+esc(r.email):'. E-mail indisponível.'):'Nenhuma conta associada.')+'</p>'+(r.state==='UNASSOCIATED'?'<button type="button" data-binding-open>Associar conta de acesso</button>':''));target.querySelector('[data-binding-open]')?.addEventListener('click',()=>void run(async()=>{const r=await o.call('pending',{personId});if(!live())return;if(r.operationId){operationId=r.operationId;shell('<div data-binding-proposal></div>');recovery();}else form();}));});
}
