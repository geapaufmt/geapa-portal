import {esc,detailFacts} from './design-system.mjs';
type Data=Record<string,unknown>;
type Send=(route:string,payload:Data)=>Promise<unknown>;
export interface Field {key:string;label:string;section:number;type:string;status:string;basis:string;value?:unknown;revision:string;effectiveFrom:number|null;origin:string;legacy?:boolean;documentedFrom?:string;documentedUntil?:string;min?:number;max?:number;choices?:string[];options?:{id:string;label:string;revision:number}[];rule?:{fixed?:unknown;allowed?:unknown[];min?:number;max?:number;basis?:string;editable?:boolean}|null}
interface Revision {id:string;revision:number;state:string;effectiveFrom:number;recordedAt:number;reason:string;normativeReference:string;definitionHash:string;parameters?:Data}
export interface ParametersData {cycle:{id:string;revision:number;label:string;status:string;civilStart:string;civilEnd:string};fields:Field[];parameters:Data;normativeReference:string;normativeStatus:string;current:Revision|null;pending:Revision|null;draft:Revision|null;rights:{canDraft:boolean;canApprove:boolean;canActivate:boolean;canRecognize:boolean};recognitions:{id:string;revision:number;documentaryEvidence:string;parameters:Data}[];history:Revision[];nextCursor:string|null}
const sections=['Identificação, vigência e governança','Frequência e participação','Calendário, reuniões e capacidade','Apresentações e modalidades','Temas, eixos e cotas','Prazos e janelas operacionais','Materiais, arquivos e divulgação','Histórico de configurações e revisões'];
const labels:Record<string,string>={DEFINED:'Definido',NOT_APPLICABLE:'Não aplicável',UNESTABLISHED:'Não estabelecido ou não comprovado',BOARD_INITIAL:'Diretoria',MEMBER_SELF_SCHEDULE:'Membros',INCIDENCE:'Incidência conforme norma aplicável',RECOGNIZED_PREAGENDA:'Pré-agenda histórica reconhecida',ORDINARY_INDIVIDUAL:'Ordinária individual',ORDINARY_SHARED:'Ordinária compartilhada',MEMBER_DYNAMIC:'Dinâmica de membro',DRAFT:'Rascunho',APPROVED:'Aprovada',HISTORICAL_RECOGNITION:'Reconhecimento documental',DOCUMENTARY_RECOGNITION:'Reconhecimento documental',CYCLE_CONFIGURATION:'Configuração do ciclo',LEGACY_CONFIGURATION:'Configuração anterior',OPEN:'Aberto',CLOSED:'Encerrado'};
const label=(s:string)=>labels[s]||s;
const local=(ms:number|null|undefined)=>Number.isFinite(ms)&&ms?new Date(ms!-4*3600000).toISOString().slice(0,16):'';
const date=(ms:number|null|undefined)=>local(ms).replace('T',' ')||'Não comprovada';
const object=(v:unknown):Data=>v&&typeof v==='object'&&!Array.isArray(v)?v as Data:{};
const selected=(v:unknown,x:unknown)=>v===x?' selected':'';
export function renderCycleCriteria(value:unknown):string {
 const d=object(value);if(!Array.isArray(d.fields)||!d.fields.length)return '';
 return `<section aria-label="Critérios do ciclo"><h3>Critérios do ciclo</h3><p>Revisão ${esc(d.configId)}. Estes critérios documentais orientam a decisão fundamentada.</p>${detailFacts(d.fields.map(v=>{const f=object(v);return [String(f.label),f.status==='DEFINED'?String(f.value):label(String(f.status||'UNESTABLISHED'))];}))}</section>`;
}
function selector(name:string,choices:{id:string;label:string}[],v:unknown,multiple=false):string {const values=Array.isArray(v)?v:[v];return `<select name="${esc(name)}" ${multiple?'multiple':''}><option value="">Selecione</option>${choices.map(c=>`<option value="${esc(c.id)}"${values.includes(c.id)?' selected':''}>${esc(c.label)}</option>`).join('')}</select>`;}
function control(f:Field):string {
 const name='value_'+f.key,v=f.value;
 if(f.type==='boolean')return selector(name,[{id:'true',label:'Sim'},{id:'false',label:'Não'}],v===undefined?'':String(v));
 if(f.type==='select'||f.type==='choices')return selector(name,(f.choices||[]).map(id=>({id,label:label(id)})),v,f.type==='choices');
 if(f.type==='policy'||f.type==='policies'){const values=f.type==='policy'?[object(v).id]:(Array.isArray(v)?v.map(x=>object(x).id):[]),choices=(f.options||[]).map(p=>({id:p.id,label:p.label+' · revisão '+p.revision}));for(const id of values)if(typeof id==='string'&&!choices.some(c=>c.id===id))choices.push({id,label:id+' · referência registrada, aprovação a revalidar'});return selector(name,choices,f.type==='policy'?values[0]:values,f.type==='policies');}
 if(f.type==='window'){const w=object(v);return `<div class="geapa-parameter-window"><label>Abertura<input type="datetime-local" name="${name}_opensAt" value="${local(w.opensAt as number)}"></label><label>Encerramento<input type="datetime-local" name="${name}_endsAtExclusive" value="${local(w.endsAtExclusive as number)}"></label></div>`;}
 if(f.type==='integer')return `<input name="${name}" type="number" step="1" min="${f.rule?.min??f.min??0}" max="${f.rule?.max??f.max??3660}" value="${esc(v??'')}">`;
 if(f.type==='time')return `<input name="${name}" type="time" value="${esc(v??'')}">`;
 if(f.type==='dates')return `<textarea name="${name}" rows="3" placeholder="Uma data por linha: AAAA-MM-DD">${esc(Array.isArray(v)?v.join('\n'):'')}</textarea>`;
 if(f.type==='checklist')return `<textarea name="${name}" rows="4" placeholder="Uma verificação por linha">${esc((object(v).items as {label:string}[]||[]).map(i=>i.label).join('\n'))}</textarea>`;
 return `<textarea name="${name}" rows="3" maxlength="2000">${esc(v??'')}</textarea>`;
}
function fieldHtml(f:Field,editable=false):string {
 const fixed=editable&&!!f.rule&&Object.hasOwn(f.rule,'fixed'),shown=fixed?{...f,value:f.rule!.fixed}:f;
 return `<article class="geapa-parameter" data-parameter="${esc(f.key)}"><h4>${esc(f.label)}</h4><label>Situação${selector('status_'+f.key,['DEFINED','NOT_APPLICABLE','UNESTABLISHED'].map(id=>({id,label:label(id)})),f.status)}</label><div data-parameter-value><label>${esc(f.label)}${control(shown)}</label></div>${fixed?'<p>Valor obrigatório pela norma para esta revisão. O fundamento e a confirmação continuam necessários.</p>':''}<label>Fundamento / documento<input name="basis_${esc(f.key)}" maxlength="2000" value="${esc(f.basis)}"></label><details><summary>Origem e vigência</summary>${detailFacts([['Origem',label(f.origin)],['Valor registrado',f.status==='DEFINED'?(typeof f.value==='object'?JSON.stringify(f.value):String(f.value)):label(f.status)],['Revisão',f.revision||'Sem revisão'],['Vigência da revisão',date(f.effectiveFrom)],['Fundamento normativo',f.rule?.basis||'Não estabelecido nesta consulta']])}<label>Início documentado<input type="date" name="from_${f.key}" value="${esc(f.documentedFrom||'')}"></label><label>Término documentado<input type="date" name="until_${f.key}" value="${esc(f.documentedUntil||'')}"></label></details>${f.legacy?'<p class="geapa-detail-note">Valor anterior registrado. A origem documental deve ser conferida antes de nova aprovação.</p>':''}</article>`;
}
export function collectParameters(form:HTMLFormElement,d:ParametersData):Data {
 const fd=new FormData(form),parameters:Data={...d.parameters,timezone:'America/Cuiaba'},items:Record<string,Data>={};
 for(const f of d.fields){const status=String(fd.get('status_'+f.key)||''),basis=String(fd.get('basis_'+f.key)||'').trim(),e:Data={status,basis};if(!['DEFINED','NOT_APPLICABLE','UNESTABLISHED'].includes(status))throw Error('Selecione a situação de '+f.label+'.');
  const from=String(fd.get('from_'+f.key)||''),until=String(fd.get('until_'+f.key)||'');if(from)e.documentedFrom=from;if(until)e.documentedUntil=until;
  if(status!=='UNESTABLISHED'&&!basis)throw Error('Informe o fundamento de '+f.label+'.');items[f.key]=e;delete parameters[f.key];if(status!=='DEFINED')continue;if(f.rule&&Object.hasOwn(f.rule,'fixed')){parameters[f.key]=f.rule.fixed;continue;}
  const name='value_'+f.key,s=String(fd.get(name)||'').trim();let value:unknown;
  if(f.type==='window'){const opens=String(fd.get(name+'_opensAt')||''),ends=String(fd.get(name+'_endsAtExclusive')||'');if(!opens||!ends)throw Error('Informe as duas datas de '+f.label+'.');const old=object(f.value);value={opensAt:opens===local(old.opensAt as number)?old.opensAt:Date.parse(opens+':00-04:00'),endsAtExclusive:ends===local(old.endsAtExclusive as number)?old.endsAtExclusive:Date.parse(ends+':00-04:00')};}
  else if(f.type==='choices'||f.type==='policies'){const list=fd.getAll(name).map(String).filter(Boolean);if(!list.length)throw Error('Selecione '+f.label+'.');value=f.type==='policies'?list.map(id=>({kind:'policy',id})):list;}
  else {if(!s)throw Error('Informe o valor de '+f.label+'.');if(f.type==='integer'){value=Number(s);if(!Number.isSafeInteger(value))throw Error('Informe um número inteiro em '+f.label+'.');}
   else if(f.type==='boolean')value=s==='true';else if(f.type==='policy')value={kind:'policy',id:s};else if(f.type==='dates')value=s.split(/\r?\n/).map(v=>v.trim()).filter(Boolean);
   else if(f.type==='checklist'){const old=object(f.value).items as {key:string;label:string}[]||[];value={approved:true,items:s.split(/\r?\n/).map(v=>v.trim()).filter(Boolean).map((text,i)=>({key:old.find(v=>v.label===text)?.key||'check_'+(i+1),label:text}))};}
   else value=s;
  }parameters[f.key]=value;
 }
 parameters.parameterEvidence={schemaVersion:'cycle-parameters-v1',items};return parameters;
}
function historyHtml(d:ParametersData):string{return `<section><h3>${sections[7]}</h3><p>Revisões anteriores são preservadas. A data de reconhecimento é distinta da vigência documental.</p>${d.history.map(r=>`<article class="geapa-parameter-history"><h4>${esc(label(r.state))} · ${esc(r.id)}</h4>${detailFacts([['Vigência',date(r.effectiveFrom)],['Registro',date(r.recordedAt)],['Fundamento',r.reason],['Norma',r.normativeReference||'Não informada']])}<details><summary>Consultar valores desta revisão</summary>${detailFacts(d.fields.map(f=>{const p=r.parameters||{},ev=object(object(p.parameterEvidence).items),item=object(ev[f.key]),status=String(item.status||(Object.hasOwn(p,f.key)?'DEFINED':'UNESTABLISHED')),v=p[f.key];return [f.label,status==='DEFINED'?(typeof v==='object'?JSON.stringify(v):typeof v==='boolean'?(v?'Sim':'Não'):String(v)):label(status)];}))}</details></article>`).join('')||'<p>Nenhuma revisão registrada.</p>'}${d.nextCursor?'<button type="button" data-parameter-history>Próximas revisões</button>':''}</section>`;}
export function mountCycleParameters(container:HTMLElement,d:ParametersData,send:Send,reload:(cursor?:string)=>Promise<void>,frequencyHtml=''):void {
 const c=d.cycle;
 container.innerHTML=`<p>Parâmetros de <strong>${esc(c.label)}</strong>. Horários de Cuiabá.</p><p>Em exibição: ${d.draft?'rascunho':d.pending?'revisão aprovada aguardando ativação':d.current?'configuração ativa':'configuração ainda não registrada'}.</p><p>Uma informação não comprovada mantém sua incerteza; não vale como zero, autorização ou regra de outro ciclo.</p><form data-cycle-parameters-form class="readonly-form"><fieldset>${sections.slice(0,7).map((title,i)=>`<details class="geapa-parameter-section" ${i===0?'open':''}><summary>${i+1}. ${title}</summary>${i===0?detailFacts([['Ciclo',c.label],['Período',c.civilStart+' a '+c.civilEnd],['Estado',label(c.status)],['Revisão',c.revision],['Norma aplicável',d.normativeReference||'Ainda não comprovada'],['Configuração ativa',d.current?.id||'Não ativada']]):''}${i===1?frequencyHtml+'<p>O planejamento original e as políticas de justificativa conservam seus registros canônicos. Atributos de uma atividade permanecem no modelo e na própria atividade.</p>':''}${i===3?'<p>Dinâmica de membro é uma modalidade de apresentação. Dinâmica da Diretoria é um modelo de atividade independente.</p>':''}${d.fields.filter(f=>f.section===i+1).map(f=>fieldHtml(f,d.rights.canDraft)).join('')}${i===4?`<button type="button" data-cycle-parameter-specialized="themes" data-cycle-id="${esc(c.id)}">Definir eixos e procedimento de análise</button><button type="button" data-cycle-parameter-specialized="quotas" data-cycle-id="${esc(c.id)}">Consultar vagas por eixo</button>`:''}${i===6?`<button type="button" data-cycle-parameter-specialized="publication" data-cycle-id="${esc(c.id)}">Definir conferência e divulgação</button><button type="button" data-cycle-parameter-specialized="materials" data-cycle-id="${esc(c.id)}">Definir itens, prazo operacional e data-limite de materiais</button>`:''}</details>`).join('')}<label>Vigência da revisão<input type="datetime-local" name="effectiveFrom" required value="${local(d.draft?.effectiveFrom||Date.now()+300000)}"></label><label>Motivo<textarea name="reason" required maxlength="2000"></textarea></label>${d.normativeStatus!=='APPROVED'?'<p>É possível preparar o rascunho. A aprovação exige referência normativa comprovada no Core.</p>':''}${d.rights.canDraft?'<button type="submit">Salvar rascunho dos parâmetros</button>':''}</fieldset><p data-feedback role="status" tabindex="-1"></p></form><div data-parameter-decisions></div>${historyHtml(d)}`;
 const form=container.querySelector<HTMLFormElement>('[data-cycle-parameters-form]')!;
 function state(){for(const f of d.fields){const row=form.querySelector<HTMLElement>(`[data-parameter="${f.key}"]`)!,status=(form.elements.namedItem('status_'+f.key) as HTMLSelectElement).value;const value=row.querySelector<HTMLElement>('[data-parameter-value]')!;value.hidden=status!=='DEFINED';for(const input of value.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>('input,select,textarea')){const fixed=!!f.rule&&Object.hasOwn(f.rule,'fixed');input.disabled=!d.rights.canDraft||status!=='DEFINED'||fixed;input.required=status==='DEFINED'&&!fixed;}const basis=form.elements.namedItem('basis_'+f.key) as HTMLInputElement;basis.required=status!=='UNESTABLISHED';}}
 if(!d.rights.canDraft)for(const input of form.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>('input,select,textarea'))input.disabled=true;form.addEventListener('change',state);state();
 const base={cycleId:c.id,cycleRevision:c.revision};
 bind(form,send,()=>({action:'DRAFT',...base,parameters:collectParameters(form,d),effectiveFrom:Date.parse(String(new FormData(form).get('effectiveFrom'))+':00-04:00'),reason:String(new FormData(form).get('reason'))}),()=>reload());
 const decisions=container.querySelector<HTMLElement>('[data-parameter-decisions]')!;
 let dirty=false;form.addEventListener('input',()=>{dirty=true;for(const button of decisions.querySelectorAll<HTMLButtonElement>('button'))button.disabled=true;form.querySelector<HTMLElement>('[data-feedback]')!.textContent='Salve o rascunho e confira a nova revisão antes de aprovar.';});
 function action(title:string,body:string,payload:(fd:FormData)=>Data,reason=true){const f=document.createElement('form');f.className='readonly-form';f.innerHTML=`<h3>${title}</h3><p>${body}</p>${reason?'<label>Fundamento da decisão<textarea name="reason" required maxlength="2000"></textarea></label>':''}<label><input type="checkbox" name="confirm" required>Conferi os valores, a origem e os efeitos desta decisão.</label><button type="submit">${title}</button><p data-feedback role="status" tabindex="-1"></p>`;decisions.append(f);bind(f,send,()=>payload(new FormData(f)),()=>reload());}
 if(d.rights.canApprove&&d.draft)action('Aprovar revisão em rascunho','O Core revalida a norma, a revisão apresentada e as restrições do ciclo.',fd=>({action:'APPROVE',...base,draftId:d.draft!.id,definitionHash:d.draft!.definitionHash,reason:String(fd.get('reason'))}));
 if(d.pending){const p=document.createElement('p');p.textContent='Revisão aprovada aguardando ativação: '+date(d.pending.effectiveFrom)+'.';decisions.append(p);}
 if(d.rights.canActivate&&d.pending)action('Ativar revisão aprovada','A ativação revalida vigência e preservação de direitos constituídos.',()=>({action:'ACTIVATE',...base,configId:d.pending!.id,configRevision:d.pending!.revision}),false);
 if(d.rights.canRecognize)for(const r of d.recognitions)action('Reconhecer parâmetros históricos',esc(r.documentaryEvidence)+'<details open><summary>Valores documentados a reconhecer</summary>'+detailFacts(d.fields.map(f=>{const e=object(object(object(r.parameters).parameterEvidence).items)[f.key],proof=object(e),v=r.parameters[f.key];return [f.label,(proof.status==='DEFINED'?(typeof v==='object'?JSON.stringify(v):typeof v==='boolean'?(v?'Sim':'Não'):String(v)):label(String(proof.status||'UNESTABLISHED')))+' · '+String(proof.basis||'Sem comprovação')];}))+'</details>',fd=>({action:'RECOGNIZE',...base,recognitionId:r.id,reason:String(fd.get('reason'))}));
 container.querySelector('[data-parameter-history]')?.addEventListener('click',()=>{if(dirty){form.querySelector<HTMLElement>('[data-feedback]')!.textContent='Salve o rascunho antes de mudar a página do histórico.';return;}void reload(d.nextCursor!);});
}
function bind(form:HTMLFormElement,send:Send,payload:()=>Data,done:()=>Promise<void>):void {
 let busy=false,confirmed=false;form.addEventListener('submit',async e=>{e.preventDefault();if(busy||confirmed||!form.reportValidity())return;const feedback=form.querySelector<HTMLElement>('[data-feedback]')!;busy=true;form.setAttribute('aria-busy','true');const modal=form.closest('.modal-backdrop');modal?.setAttribute('aria-busy','true');const buttons=form.querySelectorAll<HTMLButtonElement>('button');buttons.forEach(b=>b.disabled=true);
  try{const body=payload();feedback.textContent='Conferindo e registrando…';await send('/admin/ciclos-semestres/parametros/salvar',body);confirmed=true;modal?.removeAttribute('data-geapa-dirty');await done();}
  catch(e){feedback.textContent=confirmed?'Registro confirmado; atualize a consulta para vê-lo. Não reenvie.':e instanceof Error?e.message:'Não foi possível confirmar. Preserve o envio para recuperação.';feedback.focus();}
  finally{busy=false;form.removeAttribute('aria-busy');modal?.removeAttribute('aria-busy');buttons.forEach(b=>b.disabled=confirmed);}
 });
}
